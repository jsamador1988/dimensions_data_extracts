config {
  type: "assertion",
  schema: "rd_mart",
  name: "pub2__assert_disc6_surico4_sums",
  tags: ["diag", "pub2"],
  description: "Assert Surico-4 buckets sum to total at country×quarter×disc6 for publications."
}

SELECT
  country_code,
  quarter,
  disc6_code,
  total_eng,
  (owned_eng + funded_private_owned_eng + private_private_eng + unclassified_eng) AS sum_split
FROM ${ref("rd_mart", "pub2_country_quarter_disc6_surico4")}
WHERE ABS(total_eng - (owned_eng + funded_private_owned_eng + private_private_eng + unclassified_eng)) > 1e-6
