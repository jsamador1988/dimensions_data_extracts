config {
  type: "assertion",
  tags: ["diag"],
  description: "Assert inventor weights sum to 1 within each family (for families with observed inventor countries)."
}

SELECT
  family_id,
  SUM(w_inv) AS sum_w_inv
FROM ${ref("patent_family_inventor_weights")}
GROUP BY family_id
HAVING ABS(SUM(w_inv) - 1.0) > 1e-6
