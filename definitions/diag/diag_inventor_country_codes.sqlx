config {
  type: "table",
  schema: "rd_mart",
  tags: ["diag"],
  description: "Top inventor address country codes in Dimensions patents not in the target country list."
}

WITH inv_raw AS (
  SELECT
    inv.address.country AS country_code,
    COUNT(*) AS n
  FROM `dimensions-ai.data_analytics.patents` p
  CROSS JOIN UNNEST(p.inventors) AS inv
  WHERE inv.address.country IS NOT NULL
  GROUP BY 1
),
target AS (
  SELECT country_code FROM `dimensionsdataextracts.rd_ref.country_list`
)
SELECT
  r.country_code,
  r.n
FROM inv_raw r
LEFT JOIN target t
  ON t.country_code = r.country_code
WHERE t.country_code IS NULL
ORDER BY r.n DESC
LIMIT 200
