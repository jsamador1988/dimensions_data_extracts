config {
  type: "table",
  schema: "rd_mart",
  name: "panel_country_quarter_wide",
  tags: ["mart"],
  description: "Final balanced country×quarter panel (OECD+EU) combining publications (exhaustive Surico-4 decompositions across all series) and patents (pat2 Surico-4 decompositions + direct/tier2 grant linkage + grant totals).",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"],
    requirePartitionFilter: true
  }
}

WITH grid AS (
  SELECT country_code, quarter
  FROM ${ref("rd_stage", "analysis_country_quarter_grid")}
),

pub AS (
  SELECT *
  FROM ${ref("rd_mart", "pub_country_quarter_wide_surico4")}
  WHERE quarter >= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_start}'), QUARTER)
    AND quarter <= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_end}'), QUARTER)
),

pat AS (
  SELECT *
  FROM ${ref("rd_mart", "pat2__pat_country_quarter_wide")}
  WHERE quarter >= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_start}'), QUARTER)
    AND quarter <= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_end}'), QUARTER)
)

SELECT
  g.country_code,
  g.quarter,

  -- Build identifier (timestamp of table build)
  FORMAT_TIMESTAMP('panel_surico4_%Y%m%dT%H%M%SZ', CURRENT_TIMESTAMP()) AS build_id,

  -- Publications (tail-censored after last pub quarter)
  pub.* EXCEPT(country_code, quarter),

  -- Patents + grants
  pat.* EXCEPT(country_code, quarter)

FROM grid g
LEFT JOIN pub
  ON pub.country_code = g.country_code AND pub.quarter = g.quarter
LEFT JOIN pat
  ON pat.country_code = g.country_code AND pat.quarter = g.quarter
