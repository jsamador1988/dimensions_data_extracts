config {
  type: "table",
  name: "panel_country_quarter_wide",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Combined publication + patent country×quarter wide panel.",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH pub AS (
  -- Drop pub-side __build_id to avoid duplicate column name in the final SELECT
  SELECT
    * EXCEPT(__build_id)
  FROM ${ref("rd_mart", "pub_country_quarter_wide")}
),

pat AS (
  SELECT
    *
  FROM ${ref("rd_mart", "pat_country_quarter_wide")}
)

SELECT
  'panel_country_quarter_wide_v6_drop_pub_buildid' AS __build_id,

  -- USING() already yields one country_code and one quarter column
  country_code,
  quarter,

  pub.* EXCEPT(country_code, quarter),
  pat.* EXCEPT(country_code, quarter)

FROM pub
FULL OUTER JOIN pat
USING (country_code, quarter)
