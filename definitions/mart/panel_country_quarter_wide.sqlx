config {
  type: "table",
  name: "panel_country_quarter_wide",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Combined publication + patent country×quarter wide panel.",

  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH pub AS (
  SELECT
    * EXCEPT(country_code, quarter, __build_id)
  FROM ${ref("rd_mart", "pub_country_quarter_wide")}
),

pat AS (
  SELECT
    * EXCEPT(country_code, quarter)
  FROM ${ref("rd_mart", "pat_country_quarter_wide")}
)

SELECT
  'panel_country_quarter_wide_v2' AS __build_id,

  COALESCE(p.country_code, t.country_code) AS country_code,
  COALESCE(p.quarter, t.quarter) AS quarter,

  p.*,
  t.*
FROM ${ref("rd_mart", "pub_country_quarter_wide")} p
FULL OUTER JOIN ${ref("rd_mart", "pat_country_quarter_wide")} t
USING (country_code, quarter)
