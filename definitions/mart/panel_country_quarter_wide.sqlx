config {
  type: "table",
  name: "panel_country_quarter_wide",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Combined publication + patent country×quarter wide panel.",

  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH pub AS (
  SELECT *
  FROM ${ref({schema: "rd_mart", name: "pub_country_quarter_wide"})}
),

pat AS (
  SELECT *
  FROM ${ref({schema: "rd_mart", name: "pat_country_quarter_wide"})}
)

SELECT
  -- USING() already returns a single country_code + quarter column
  country_code,
  quarter,

  pub.* EXCEPT(country_code, quarter),
  pat.* EXCEPT(country_code, quarter)

FROM pub
FULL OUTER JOIN pat
USING (country_code, quarter)
