config {
  type: "table",
  name: "panel_country_quarter_wide",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Combined publication + patent country×quarter wide panel.",

  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH pub AS (
  SELECT
    * EXCEPT(__build_id)
  FROM ${ref("rd_mart", "pub_country_quarter_wide")}
),

pat AS (
  SELECT
    *
  FROM ${ref("rd_mart", "pat_country_quarter_wide")}
)

SELECT
  'panel_country_quarter_wide_v4' AS __build_id,

  COALESCE(pub.country_code, pat.country_code) AS country_code,
  COALESCE(pub.quarter, pat.quarter) AS quarter,

  pub.* EXCEPT(country_code, quarter),
  pat.* EXCEPT(country_code, quarter)
FROM pub
FULL OUTER JOIN pat
USING (country_code, quarter)
