config {
  type: "table",
  schema: "rd_mart",
  name: "panel_country_quarter_wide",
  tags: ["rd_mart"],
  description: "Balanced OECD quarterly panel (1970Q1–2026Q1). Option B: set all publication series to NULL after last observed pub quarter (prevents artificial zeros in tail). Patents unchanged from v13 Surico-consistent definitions.",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"],
    requirePartitionFilter: true
  }
}

-- ============================================================
-- OPTION B (v14): Tail-censor publications as NULL (not zero)
--   - Keep balanced panel grid intact
--   - For quarters after last observed pub_total_ctq>0 anywhere:
--       set ALL pub_* series to NULL
--   - Clamp tiny negative pub_unknown_produced_ctq to 0 and
--     offset private by same epsilon to preserve identities.
--   - Patents unchanged (use only columns that exist in v13).
-- ============================================================

WITH
base AS (
  SELECT *
  FROM `dimensionsdataextracts.rd_snap.panel_country_quarter_wide_v13_phase6_no_placeholders`
),
pub_last AS (
  SELECT MAX(quarter) AS last_pub_quarter
  FROM base
  WHERE pub_total_ctq > 0
)

SELECT
  b.* REPLACE (

    -- >>> Set your v14 build id here (single place)
    'panel_country_quarter_wide_v14' AS __build_id,

    -- =========================
    -- PUBLICATIONS: Option B tail handling
    -- =========================
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_total_ctq ELSE NULL END AS pub_total_ctq,

    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_total_ctq ELSE NULL END AS pub_total_recomputed_ctq,

    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_public_produced_ctq ELSE NULL END AS pub_public_produced_ctq,

    -- Clamp tiny negative unknown to 0, and shift epsilon into private so:
    -- pub_total = pub_public + pub_private + pub_unknown holds exactly.
    CASE
      WHEN b.quarter <= pl.last_pub_quarter
      THEN (b.pub_private_produced_ctq + (b.pub_unknown_produced_ctq - GREATEST(0.0, b.pub_unknown_produced_ctq)))
      ELSE NULL
    END AS pub_private_produced_ctq,

    CASE
      WHEN b.quarter <= pl.last_pub_quarter
      THEN GREATEST(0.0, b.pub_unknown_produced_ctq)
      ELSE NULL
    END AS pub_unknown_produced_ctq,

    -- Re-derive diagnostics so they remain internally consistent under Option B
    CASE
      WHEN b.quarter <= pl.last_pub_quarter
      THEN (
        b.pub_public_produced_ctq
        + (b.pub_private_produced_ctq + (b.pub_unknown_produced_ctq - GREATEST(0.0, b.pub_unknown_produced_ctq)))
      )
      ELSE NULL
    END AS pub_total_classified_ctq,

    CASE
      WHEN b.quarter <= pl.last_pub_quarter
      THEN (
        b.pub_total_ctq
        - (
          b.pub_public_produced_ctq
          + (b.pub_private_produced_ctq + (b.pub_unknown_produced_ctq - GREATEST(0.0, b.pub_unknown_produced_ctq)))
        )
      )
      ELSE NULL
    END AS pub_total_unclassified_ctq,

    CASE
      WHEN b.quarter <= pl.last_pub_quarter
      THEN SAFE_DIVIDE(
        (
          b.pub_total_ctq
          - (
            b.pub_public_produced_ctq
            + (b.pub_private_produced_ctq + (b.pub_unknown_produced_ctq - GREATEST(0.0, b.pub_unknown_produced_ctq)))
          )
        ),
        b.pub_total_ctq
      )
      ELSE NULL
    END AS pub_unclassified_share_ctq,

    -- Quality series: NULL in tail
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_top5_ctq ELSE NULL END AS pub_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_break_ctq ELSE NULL END AS pub_break_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_break_eligible_weight_ctq ELSE NULL END AS pub_break_eligible_weight_ctq,

    -- =========================
    -- DISCIPLINES (DISC1..DISC6) + top5: NULL in tail
    -- =========================
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC1_ctq ELSE NULL END AS pub_disc_DISC1_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC1_top5_ctq ELSE NULL END AS pub_disc_DISC1_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC2_ctq ELSE NULL END AS pub_disc_DISC2_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC2_top5_ctq ELSE NULL END AS pub_disc_DISC2_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC3_ctq ELSE NULL END AS pub_disc_DISC3_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC3_top5_ctq ELSE NULL END AS pub_disc_DISC3_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC4_ctq ELSE NULL END AS pub_disc_DISC4_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC4_top5_ctq ELSE NULL END AS pub_disc_DISC4_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC5_ctq ELSE NULL END AS pub_disc_DISC5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC5_top5_ctq ELSE NULL END AS pub_disc_DISC5_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC6_ctq ELSE NULL END AS pub_disc_DISC6_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_disc_DISC6_top5_ctq ELSE NULL END AS pub_disc_DISC6_top5_ctq,

    -- =========================
    -- FIELDS (Field22) + top5: NULL in tail
    -- =========================
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_AGRI_ctq ELSE NULL END AS pub_field_AGRI_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_AGRI_top5_ctq ELSE NULL END AS pub_field_AGRI_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_BIO_ctq ELSE NULL END AS pub_field_BIO_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_BIO_top5_ctq ELSE NULL END AS pub_field_BIO_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_BIOMED_ctq ELSE NULL END AS pub_field_BIOMED_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_BIOMED_top5_ctq ELSE NULL END AS pub_field_BIOMED_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_BUILT_ctq ELSE NULL END AS pub_field_BUILT_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_BUILT_top5_ctq ELSE NULL END AS pub_field_BUILT_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_CHEM_ctq ELSE NULL END AS pub_field_CHEM_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_CHEM_top5_ctq ELSE NULL END AS pub_field_CHEM_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_COMMERCE_ctq ELSE NULL END AS pub_field_COMMERCE_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_COMMERCE_top5_ctq ELSE NULL END AS pub_field_COMMERCE_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_CREATIVE_ctq ELSE NULL END AS pub_field_CREATIVE_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_CREATIVE_top5_ctq ELSE NULL END AS pub_field_CREATIVE_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_EARTH_ctq ELSE NULL END AS pub_field_EARTH_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_EARTH_top5_ctq ELSE NULL END AS pub_field_EARTH_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_ECON_ctq ELSE NULL END AS pub_field_ECON_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_ECON_top5_ctq ELSE NULL END AS pub_field_ECON_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_EDUC_ctq ELSE NULL END AS pub_field_EDUC_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_EDUC_top5_ctq ELSE NULL END AS pub_field_EDUC_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_ENG_ctq ELSE NULL END AS pub_field_ENG_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_ENG_top5_ctq ELSE NULL END AS pub_field_ENG_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_ENV_ctq ELSE NULL END AS pub_field_ENV_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_ENV_top5_ctq ELSE NULL END AS pub_field_ENV_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_HEALTH_ctq ELSE NULL END AS pub_field_HEALTH_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_HEALTH_top5_ctq ELSE NULL END AS pub_field_HEALTH_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_HISTORY_ctq ELSE NULL END AS pub_field_HISTORY_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_HISTORY_top5_ctq ELSE NULL END AS pub_field_HISTORY_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_HUMAN_ctq ELSE NULL END AS pub_field_HUMAN_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_HUMAN_top5_ctq ELSE NULL END AS pub_field_HUMAN_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_INFOCOMP_ctq ELSE NULL END AS pub_field_INFOCOMP_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_INFOCOMP_top5_ctq ELSE NULL END AS pub_field_INFOCOMP_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_LANG_ctq ELSE NULL END AS pub_field_LANG_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_LANG_top5_ctq ELSE NULL END AS pub_field_LANG_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_LAW_ctq ELSE NULL END AS pub_field_LAW_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_LAW_top5_ctq ELSE NULL END AS pub_field_LAW_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_MATH_ctq ELSE NULL END AS pub_field_MATH_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_MATH_top5_ctq ELSE NULL END AS pub_field_MATH_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_PHIL_ctq ELSE NULL END AS pub_field_PHIL_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_PHIL_top5_ctq ELSE NULL END AS pub_field_PHIL_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_PHYSICAL_ctq ELSE NULL END AS pub_field_PHYSICAL_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_PHYSICAL_top5_ctq ELSE NULL END AS pub_field_PHYSICAL_top5_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_PSYCH_ctq ELSE NULL END AS pub_field_PSYCH_ctq,
    CASE WHEN b.quarter <= pl.last_pub_quarter THEN b.pub_field_PSYCH_top5_ctq ELSE NULL END AS pub_field_PSYCH_top5_ctq

  )
FROM base b
CROSS JOIN pub_last pl
