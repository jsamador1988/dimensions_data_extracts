config {
  type: "table",
  schema: "rd_mart",
  name: "panel_country_quarter_wide",
  tags: ["mart"],
  description: "Balanced country×quarter panel combining patent and publication innovation decompositions (requested series 1a–1f and 2a–2f).",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH country_dim AS (
  -- Self-contained ISO2 -> name mapping for the analysis universe (so we don't depend on an external country-name table).
  SELECT * FROM UNNEST([
    STRUCT('US' AS country_code, 'United States' AS country_name),
    STRUCT('CA' AS country_code, 'Canada' AS country_name),
    STRUCT('AU' AS country_code, 'Australia' AS country_name),
    STRUCT('CH' AS country_code, 'Switzerland' AS country_name),
    STRUCT('GB' AS country_code, 'United Kingdom' AS country_name),

    STRUCT('AT' AS country_code, 'Austria' AS country_name),
    STRUCT('BE' AS country_code, 'Belgium' AS country_name),
    STRUCT('CZ' AS country_code, 'Czechia' AS country_name),
    STRUCT('DK' AS country_code, 'Denmark' AS country_name),
    STRUCT('EE' AS country_code, 'Estonia' AS country_name),
    STRUCT('FI' AS country_code, 'Finland' AS country_name),
    STRUCT('FR' AS country_code, 'France' AS country_name),
    STRUCT('DE' AS country_code, 'Germany' AS country_name),
    STRUCT('GR' AS country_code, 'Greece' AS country_name),
    STRUCT('HU' AS country_code, 'Hungary' AS country_name),
    STRUCT('IE' AS country_code, 'Ireland' AS country_name),
    STRUCT('IT' AS country_code, 'Italy' AS country_name),
    STRUCT('LV' AS country_code, 'Latvia' AS country_name),
    STRUCT('LT' AS country_code, 'Lithuania' AS country_name),
    STRUCT('LU' AS country_code, 'Luxembourg' AS country_name),
    STRUCT('NL' AS country_code, 'Netherlands' AS country_name),
    STRUCT('PL' AS country_code, 'Poland' AS country_name),
    STRUCT('PT' AS country_code, 'Portugal' AS country_name),
    STRUCT('SK' AS country_code, 'Slovakia' AS country_name),
    STRUCT('SI' AS country_code, 'Slovenia' AS country_name),
    STRUCT('ES' AS country_code, 'Spain' AS country_name),
    STRUCT('SE' AS country_code, 'Sweden' AS country_name)
  ])
),

grid AS (
  SELECT
    g.country_code,
    COALESCE(d.country_name, g.country_code) AS country_name,
    g.quarter
  FROM ${ref("rd_stage", "analysis_country_quarter_grid")} g
  LEFT JOIN country_dim d
    USING (country_code)
),

pat AS (
  SELECT * FROM ${ref("rd_int", "pat_country_quarter_measures")}
),

pub AS (
  SELECT * FROM ${ref("rd_int", "pub_country_quarter_measures")}
)

SELECT
  grid.country_code,
  grid.country_name,
  grid.quarter,

  -- Patents (1a–1f)
  COALESCE(pat.pat_total_ctq, 0.0) AS pat_total_ctq,
  COALESCE(pat.pat_gov_owned_ctq, 0.0) AS pat_gov_owned_ctq,
  COALESCE(pat.pat_private_total_ctq, 0.0) AS pat_private_total_ctq,
  COALESCE(pat.pat_govfund_direct_ctq, 0.0) AS pat_govfund_direct_ctq,
  COALESCE(pat.pat_govfund_rid_ctq, 0.0) AS pat_govfund_rid_ctq,
  COALESCE(pat.pat_govfund_inst_ctq, 0.0) AS pat_govfund_inst_ctq,
  COALESCE(pat.pat_private_with_cites_ctq, 0.0) AS pat_private_with_cites_ctq,
  COALESCE(pat.pat_private_cite_gov_raw_ctq, 0.0) AS pat_private_cite_gov_raw_ctq,
  COALESCE(pat.pat_private_cite_gov_norm_ctq, 0.0) AS pat_private_cite_gov_norm_ctq,

  -- Publications (2a–2f)
  COALESCE(pub.pub_total_ctq, 0.0) AS pub_total_ctq,
  COALESCE(pub.pub_gov_owned_ctq, 0.0) AS pub_gov_owned_ctq,
  COALESCE(pub.pub_private_total_ctq, 0.0) AS pub_private_total_ctq,
  COALESCE(pub.pub_govfund_direct_ctq, 0.0) AS pub_govfund_direct_ctq,
  COALESCE(pub.pub_govfund_rid_ctq, 0.0) AS pub_govfund_rid_ctq,
  COALESCE(pub.pub_govfund_inst_ctq, 0.0) AS pub_govfund_inst_ctq,
  COALESCE(pub.pub_private_with_cites_ctq, 0.0) AS pub_private_with_cites_ctq,
  COALESCE(pub.pub_private_cite_gov_raw_ctq, 0.0) AS pub_private_cite_gov_raw_ctq,
  COALESCE(pub.pub_private_cite_gov_norm_ctq, 0.0) AS pub_private_cite_gov_norm_ctq

FROM grid
LEFT JOIN pat
  ON pat.country_code = grid.country_code AND pat.quarter = grid.quarter
LEFT JOIN pub
  ON pub.country_code = grid.country_code AND pub.quarter = grid.quarter
