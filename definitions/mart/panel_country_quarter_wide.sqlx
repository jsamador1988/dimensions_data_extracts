config {
  type: "table",
  name: "panel_country_quarter_wide",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Combined publication + patent country×quarter wide panel.",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH pub AS (
  -- pub_country_quarter_wide DOES have __build_id; drop it to avoid duplicates in the final panel.
  SELECT
    * EXCEPT(__build_id)
  FROM ${ref("rd_mart", "pub_country_quarter_wide")}
),

pat AS (
  -- pat_country_quarter_wide does NOT have __build_id (in your current pipeline), so do not EXCEPT it.
  SELECT
    *
  FROM ${ref("rd_mart", "pat_country_quarter_wide")}
)

SELECT
  'panel_country_quarter_wide_v7_fix_buildid' AS __build_id,

  country_code,
  quarter,

  pub.* EXCEPT(country_code, quarter),
  pat.* EXCEPT(country_code, quarter)

FROM pub
FULL OUTER JOIN pat
USING (country_code, quarter)
