config {
  type: "table",
  schema: "rd_mart",
  tags: ["mart"],
  bigquery: { partitionBy: "quarter", clusterBy: ["country_code"] },
  description: "Final country-quarter panel: patents + publications (wide) merged on (country_code, quarter)."
}

WITH keys AS (
  SELECT country_code, quarter FROM ${ref("pat_country_quarter_wide")}
  UNION DISTINCT
  SELECT country_code, quarter FROM ${ref("pub_country_quarter_wide")}
),

pat AS (
  SELECT * FROM ${ref("pat_country_quarter_wide")}
),

pub AS (
  SELECT * FROM ${ref("pub_country_quarter_wide")}
)

SELECT
  k.country_code,
  k.quarter,

  -- patents
  pat.* EXCEPT(country_code, quarter),

  -- publications
  pub.* EXCEPT(country_code, quarter)

FROM keys k
LEFT JOIN pat USING (country_code, quarter)
LEFT JOIN pub USING (country_code, quarter)
