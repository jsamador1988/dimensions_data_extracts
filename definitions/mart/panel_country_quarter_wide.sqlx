config {
  type: "table",
  schema: "rd_mart",
  name: "panel_country_quarter_wide",
  tags: ["mart"],
  description: "Balanced country x quarter panel combining patent and publication innovation decompositions: domestic totals, ownership, funding proxies, citation-based measures, university decomposition, science linkage, 6-way ownership x funding decompositions, 8-way citation-based decomposition, quality-filtered variants, inventor-weighted secondary variants, and diagnostic columns.",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

WITH country_dim AS (
  SELECT
    country_code,
    country_name
  FROM ${ref("rd_ref", "analysis_country_map")}
),

grid AS (
  SELECT
    g.country_code,
    COALESCE(d.country_name, g.country_code) AS country_name,
    g.quarter
  FROM ${ref("rd_stage", "analysis_country_quarter_grid")} g
  LEFT JOIN country_dim d
    USING (country_code)
),

pat AS (
  SELECT * FROM ${ref("rd_int", "pat_country_quarter_measures")}
),

pub AS (
  SELECT * FROM ${ref("rd_int", "pub_country_quarter_measures")}
),

pub_qual AS (
  SELECT * FROM ${ref("rd_int", "pub_country_quarter_quality_measures")}
),

pub_6w AS (
  SELECT * FROM ${ref("rd_int", "pub_6way_decomp_ctq")}
),

pub_6wq AS (
  SELECT * FROM ${ref("rd_int", "pub_6way_decomp_quality_ctq")}
),

pat_8wc AS (
  SELECT * FROM ${ref("rd_int", "pat_8way_cite_decomp_ctq")}
),

pat_6w AS (
  SELECT * FROM ${ref("rd_int", "pat_6way_fund_decomp_ctq")}
),

pat_inv_diag AS (
  SELECT * FROM ${ref("rd_int", "pat_inventor_coverage_diag")}
)

SELECT
  grid.country_code,
  grid.country_name,
  grid.quarter,

  -- -----------------------------
  -- Patents
  -- -----------------------------
  COALESCE(pat.pat_total_ctq, 0.0) AS pat_total_ctq,
  COALESCE(pat.pat_gov_owned_ctq, 0.0) AS pat_gov_owned_ctq,
  COALESCE(pat.pat_private_total_ctq, 0.0) AS pat_private_total_ctq,

  -- Overlapping government funding proxies (subset of private-only patents)
  COALESCE(pat.pat_govfund_direct_ctq, 0.0) AS pat_govfund_direct_ctq,
  COALESCE(pat.pat_govfund_rid_ctq, 0.0) AS pat_govfund_rid_ctq,
  COALESCE(pat.pat_govfund_inst_ctq, 0.0) AS pat_govfund_inst_ctq,

  -- Mutually-exclusive government funding tiers (subset of private-only patents)
  COALESCE(pat.pat_govfund_direct_excl_ctq, 0.0) AS pat_govfund_direct_excl_ctq,
  COALESCE(pat.pat_govfund_rid_only_excl_ctq, 0.0) AS pat_govfund_rid_only_excl_ctq,
  COALESCE(pat.pat_govfund_inst_only_excl_ctq, 0.0) AS pat_govfund_inst_only_excl_ctq,
  COALESCE(pat.pat_govfund_any_excl_ctq, 0.0) AS pat_govfund_any_excl_ctq,

  -- Non-government domestic-funder analogs (subset of private-only patents)
  COALESCE(pat.pat_privfund_direct_ctq, 0.0) AS pat_privfund_direct_ctq,
  COALESCE(pat.pat_privfund_rid_ctq, 0.0) AS pat_privfund_rid_ctq,
  COALESCE(pat.pat_privfund_inst_ctq, 0.0) AS pat_privfund_inst_ctq,

  -- Private patents citing government-produced research
  COALESCE(pat.pat_private_with_cites_ctq, 0.0) AS pat_private_with_cites_ctq,
  COALESCE(pat.pat_private_cite_gov_raw_ctq, 0.0) AS pat_private_cite_gov_raw_ctq,
  COALESCE(pat.pat_private_cite_gov_norm_ctq, 0.0) AS pat_private_cite_gov_norm_ctq,

  -- NTIS external linkage (Korea only)
  COALESCE(pat.pat_govfund_ntis_ctq, 0.0) AS pat_govfund_ntis_ctq,

  -- Basic research by org category (patents)
  COALESCE(pat.pat_total_basic_ctq, 0.0) AS pat_total_basic_ctq,
  COALESCE(pat.pat_gov_owned_basic_ctq, 0.0) AS pat_gov_owned_basic_ctq,
  COALESCE(pat.pat_private_basic_ctq, 0.0) AS pat_private_basic_ctq,
  COALESCE(pat.pat_govfund_basic_ctq, 0.0) AS pat_govfund_basic_ctq,

  -- University decomposition (patents)
  COALESCE(pat.pat_uni_total_ctq, 0.0) AS pat_uni_total_ctq,
  COALESCE(pat.pat_uni_basic_ctq, 0.0) AS pat_uni_basic_ctq,
  COALESCE(pat.pat_uni_govfund_ctq, 0.0) AS pat_uni_govfund_ctq,
  COALESCE(pat.pat_uni_basic_govfund_ctq, 0.0) AS pat_uni_basic_govfund_ctq,

  -- Science linkage (patents)
  COALESCE(pat.pat_citepub_ctq, 0.0) AS pat_citepub_ctq,
  COALESCE(pat.pat_citepub_basic_ctq, 0.0) AS pat_citepub_basic_ctq,
  COALESCE(pat.pat_citepub_govfund_ctq, 0.0) AS pat_citepub_govfund_ctq,
  COALESCE(pat.pat_citepub_govfund_basic_ctq, 0.0) AS pat_citepub_govfund_basic_ctq,
  COALESCE(pat.pat_citepub_uni_ctq, 0.0) AS pat_citepub_uni_ctq,

  -- Cross-combinations (patents)
  COALESCE(pat.pat_uni_citepub_ctq, 0.0) AS pat_uni_citepub_ctq,
  COALESCE(pat.pat_uni_citepub_basic_ctq, 0.0) AS pat_uni_citepub_basic_ctq,
  COALESCE(pat.pat_uni_citepub_govfund_basic_ctq, 0.0) AS pat_uni_citepub_govfund_basic_ctq,
  COALESCE(pat.pat_govfund_citepub_ctq, 0.0) AS pat_govfund_citepub_ctq,

  -- Private->university citation spillover
  COALESCE(pat.pat_private_cite_uni_raw_ctq, 0.0) AS pat_private_cite_uni_raw_ctq,
  COALESCE(pat.pat_private_cite_uni_norm_ctq, 0.0) AS pat_private_cite_uni_norm_ctq,

  -- Inventor-weighted secondary variants (patents)
  COALESCE(pat.pat_total_inv_ctq, 0.0) AS pat_total_inv_ctq,
  COALESCE(pat.pat_gov_owned_inv_ctq, 0.0) AS pat_gov_owned_inv_ctq,
  COALESCE(pat.pat_private_total_inv_ctq, 0.0) AS pat_private_total_inv_ctq,
  COALESCE(pat.pat_uni_total_inv_ctq, 0.0) AS pat_uni_total_inv_ctq,
  COALESCE(pat.pat_total_basic_inv_ctq, 0.0) AS pat_total_basic_inv_ctq,

  -- Inventor coverage diagnostic
  COALESCE(pat_inv_diag.pat_no_inventor_ctq, 0) AS pat_no_inventor_ctq,
  COALESCE(pat_inv_diag.pct_no_inventor, 0.0) AS pat_pct_no_inventor,

  -- Patent 6-way ownership x funding decomposition (binary)
  COALESCE(pat_6w.pat_6w_gov_owned_ctq, 0.0) AS pat_6w_gov_owned_ctq,
  COALESCE(pat_6w.pat_6w_uni_govfund_ctq, 0.0) AS pat_6w_uni_govfund_ctq,
  COALESCE(pat_6w.pat_6w_uni_no_govfund_ctq, 0.0) AS pat_6w_uni_no_govfund_ctq,
  COALESCE(pat_6w.pat_6w_private_govfund_ctq, 0.0) AS pat_6w_private_govfund_ctq,
  COALESCE(pat_6w.pat_6w_private_no_govfund_ctq, 0.0) AS pat_6w_private_no_govfund_ctq,
  COALESCE(pat_6w.pat_6w_unclassified_ctq, 0.0) AS pat_6w_unclassified_ctq,

  -- Patent 6-way (inventor-weighted)
  COALESCE(pat_6w.pat_6w_gov_owned_inv_ctq, 0.0) AS pat_6w_gov_owned_inv_ctq,
  COALESCE(pat_6w.pat_6w_uni_govfund_inv_ctq, 0.0) AS pat_6w_uni_govfund_inv_ctq,
  COALESCE(pat_6w.pat_6w_uni_no_govfund_inv_ctq, 0.0) AS pat_6w_uni_no_govfund_inv_ctq,
  COALESCE(pat_6w.pat_6w_private_govfund_inv_ctq, 0.0) AS pat_6w_private_govfund_inv_ctq,
  COALESCE(pat_6w.pat_6w_private_no_govfund_inv_ctq, 0.0) AS pat_6w_private_no_govfund_inv_ctq,
  COALESCE(pat_6w.pat_6w_unclassified_inv_ctq, 0.0) AS pat_6w_unclassified_inv_ctq,

  -- Patent 8-way citation-based decomposition (binary, all cited pubs)
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_basic_ctq, 0.0) AS pat_8wc_gov_cite_gov_basic_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_nonbasic_ctq, 0.0) AS pat_8wc_gov_cite_gov_nonbasic_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_nongov_ctq, 0.0) AS pat_8wc_gov_cite_nongov_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_no_cite_ctq, 0.0) AS pat_8wc_gov_no_cite_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_basic_ctq, 0.0) AS pat_8wc_priv_cite_gov_basic_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_nonbasic_ctq, 0.0) AS pat_8wc_priv_cite_gov_nonbasic_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_nongov_ctq, 0.0) AS pat_8wc_priv_cite_nongov_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_no_cite_ctq, 0.0) AS pat_8wc_priv_no_cite_ctq,

  -- Patent 8-way (inventor-weighted, all cited pubs)
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_basic_inv_ctq, 0.0) AS pat_8wc_gov_cite_gov_basic_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_nonbasic_inv_ctq, 0.0) AS pat_8wc_gov_cite_gov_nonbasic_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_nongov_inv_ctq, 0.0) AS pat_8wc_gov_cite_nongov_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_no_cite_inv_ctq, 0.0) AS pat_8wc_gov_no_cite_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_basic_inv_ctq, 0.0) AS pat_8wc_priv_cite_gov_basic_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_nonbasic_inv_ctq, 0.0) AS pat_8wc_priv_cite_gov_nonbasic_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_nongov_inv_ctq, 0.0) AS pat_8wc_priv_cite_nongov_inv_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_no_cite_inv_ctq, 0.0) AS pat_8wc_priv_no_cite_inv_ctq,

  -- Patent 8-way (binary, top5j cited pubs)
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_basic_top5j_ctq, 0.0) AS pat_8wc_gov_cite_gov_basic_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_nonbasic_top5j_ctq, 0.0) AS pat_8wc_gov_cite_gov_nonbasic_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_nongov_top5j_ctq, 0.0) AS pat_8wc_gov_cite_nongov_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_no_cite_top5j_ctq, 0.0) AS pat_8wc_gov_no_cite_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_basic_top5j_ctq, 0.0) AS pat_8wc_priv_cite_gov_basic_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_nonbasic_top5j_ctq, 0.0) AS pat_8wc_priv_cite_gov_nonbasic_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_nongov_top5j_ctq, 0.0) AS pat_8wc_priv_cite_nongov_top5j_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_no_cite_top5j_ctq, 0.0) AS pat_8wc_priv_no_cite_top5j_ctq,

  -- Patent 8-way (binary, top01 cited pubs)
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_basic_top01_ctq, 0.0) AS pat_8wc_gov_cite_gov_basic_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_gov_nonbasic_top01_ctq, 0.0) AS pat_8wc_gov_cite_gov_nonbasic_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_cite_nongov_top01_ctq, 0.0) AS pat_8wc_gov_cite_nongov_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_gov_no_cite_top01_ctq, 0.0) AS pat_8wc_gov_no_cite_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_basic_top01_ctq, 0.0) AS pat_8wc_priv_cite_gov_basic_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_gov_nonbasic_top01_ctq, 0.0) AS pat_8wc_priv_cite_gov_nonbasic_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_cite_nongov_top01_ctq, 0.0) AS pat_8wc_priv_cite_nongov_top01_ctq,
  COALESCE(pat_8wc.pat_8wc_priv_no_cite_top01_ctq, 0.0) AS pat_8wc_priv_no_cite_top01_ctq,

  -- -----------------------------
  -- Publications
  -- -----------------------------
  COALESCE(pub.pub_total_ctq, 0.0) AS pub_total_ctq,
  COALESCE(pub.pub_gov_owned_ctq, 0.0) AS pub_gov_owned_ctq,
  COALESCE(pub.pub_private_total_ctq, 0.0) AS pub_private_total_ctq,

  -- Overlapping government funding proxies (subset of private-only publications)
  COALESCE(pub.pub_govfund_direct_ctq, 0.0) AS pub_govfund_direct_ctq,
  COALESCE(pub.pub_govfund_rid_ctq, 0.0) AS pub_govfund_rid_ctq,
  COALESCE(pub.pub_govfund_inst_ctq, 0.0) AS pub_govfund_inst_ctq,

  -- Mutually-exclusive government funding tiers (subset of private-only publications)
  COALESCE(pub.pub_govfund_direct_excl_ctq, 0.0) AS pub_govfund_direct_excl_ctq,
  COALESCE(pub.pub_govfund_rid_only_excl_ctq, 0.0) AS pub_govfund_rid_only_excl_ctq,
  COALESCE(pub.pub_govfund_inst_only_excl_ctq, 0.0) AS pub_govfund_inst_only_excl_ctq,
  COALESCE(pub.pub_govfund_any_excl_ctq, 0.0) AS pub_govfund_any_excl_ctq,

  -- Non-government domestic-funder analogs (subset of private-only publications)
  COALESCE(pub.pub_privfund_direct_ctq, 0.0) AS pub_privfund_direct_ctq,
  COALESCE(pub.pub_privfund_rid_ctq, 0.0) AS pub_privfund_rid_ctq,
  COALESCE(pub.pub_privfund_inst_ctq, 0.0) AS pub_privfund_inst_ctq,

  -- Private publications citing government-produced research
  COALESCE(pub.pub_private_with_cites_ctq, 0.0) AS pub_private_with_cites_ctq,
  COALESCE(pub.pub_private_cite_gov_raw_ctq, 0.0) AS pub_private_cite_gov_raw_ctq,
  COALESCE(pub.pub_private_cite_gov_norm_ctq, 0.0) AS pub_private_cite_gov_norm_ctq,

  -- External national source linkage (non-zero for NO, JP, NL only)
  COALESCE(pub.pub_govfund_external_ctq, 0.0) AS pub_govfund_external_ctq,
  COALESCE(pub.pub_gov_owned_external_ctq, 0.0) AS pub_gov_owned_external_ctq,

  -- Basic research by org category (publications)
  COALESCE(pub.pub_total_basic_ctq, 0.0) AS pub_total_basic_ctq,
  COALESCE(pub.pub_gov_owned_basic_ctq, 0.0) AS pub_gov_owned_basic_ctq,
  COALESCE(pub.pub_private_basic_ctq, 0.0) AS pub_private_basic_ctq,
  COALESCE(pub.pub_govfund_basic_ctq, 0.0) AS pub_govfund_basic_ctq,

  -- International collaboration (publications)
  COALESCE(pub.pub_intl_collab_ctq, 0.0) AS pub_intl_collab_ctq,

  -- University decomposition (publications)
  COALESCE(pub.pub_uni_total_ctq, 0.0) AS pub_uni_total_ctq,
  COALESCE(pub.pub_uni_basic_ctq, 0.0) AS pub_uni_basic_ctq,
  COALESCE(pub.pub_uni_govfund_ctq, 0.0) AS pub_uni_govfund_ctq,
  COALESCE(pub.pub_uni_basic_govfund_ctq, 0.0) AS pub_uni_basic_govfund_ctq,

  -- -----------------------------
  -- Quality-filtered publications (top 5% journals + top 0.1% breakthrough)
  -- -----------------------------
  COALESCE(pub_qual.pub_total_top5j_ctq, 0.0) AS pub_total_top5j_ctq,
  COALESCE(pub_qual.pub_gov_owned_top5j_ctq, 0.0) AS pub_gov_owned_top5j_ctq,
  COALESCE(pub_qual.pub_private_total_top5j_ctq, 0.0) AS pub_private_total_top5j_ctq,
  COALESCE(pub_qual.pub_uni_total_top5j_ctq, 0.0) AS pub_uni_total_top5j_ctq,
  COALESCE(pub_qual.pub_uni_basic_top5j_ctq, 0.0) AS pub_uni_basic_top5j_ctq,
  COALESCE(pub_qual.pub_govfund_any_excl_top5j_ctq, 0.0) AS pub_govfund_any_excl_top5j_ctq,
  COALESCE(pub_qual.pub_uni_govfund_top5j_ctq, 0.0) AS pub_uni_govfund_top5j_ctq,

  COALESCE(pub_qual.pub_total_top01_ctq, 0.0) AS pub_total_top01_ctq,
  COALESCE(pub_qual.pub_gov_owned_top01_ctq, 0.0) AS pub_gov_owned_top01_ctq,
  COALESCE(pub_qual.pub_private_total_top01_ctq, 0.0) AS pub_private_total_top01_ctq,
  COALESCE(pub_qual.pub_uni_total_top01_ctq, 0.0) AS pub_uni_total_top01_ctq,
  COALESCE(pub_qual.pub_uni_basic_top01_ctq, 0.0) AS pub_uni_basic_top01_ctq,
  COALESCE(pub_qual.pub_govfund_any_excl_top01_ctq, 0.0) AS pub_govfund_any_excl_top01_ctq,
  COALESCE(pub_qual.pub_uni_govfund_top01_ctq, 0.0) AS pub_uni_govfund_top01_ctq,

  -- -----------------------------
  -- Publication 6-way decomposition
  -- -----------------------------
  COALESCE(pub_6w.pub_6w_gov_owned_ctq, 0.0) AS pub_6w_gov_owned_ctq,
  COALESCE(pub_6w.pub_6w_uni_govfund_ctq, 0.0) AS pub_6w_uni_govfund_ctq,
  COALESCE(pub_6w.pub_6w_uni_no_govfund_ctq, 0.0) AS pub_6w_uni_no_govfund_ctq,
  COALESCE(pub_6w.pub_6w_private_govfund_ctq, 0.0) AS pub_6w_private_govfund_ctq,
  COALESCE(pub_6w.pub_6w_private_no_govfund_ctq, 0.0) AS pub_6w_private_no_govfund_ctq,
  COALESCE(pub_6w.pub_6w_unclassified_ctq, 0.0) AS pub_6w_unclassified_ctq,

  -- Publication 6-way (basic research subset)
  COALESCE(pub_6w.pub_6w_gov_owned_basic_ctq, 0.0) AS pub_6w_gov_owned_basic_ctq,
  COALESCE(pub_6w.pub_6w_uni_govfund_basic_ctq, 0.0) AS pub_6w_uni_govfund_basic_ctq,
  COALESCE(pub_6w.pub_6w_uni_no_govfund_basic_ctq, 0.0) AS pub_6w_uni_no_govfund_basic_ctq,
  COALESCE(pub_6w.pub_6w_private_govfund_basic_ctq, 0.0) AS pub_6w_private_govfund_basic_ctq,
  COALESCE(pub_6w.pub_6w_private_no_govfund_basic_ctq, 0.0) AS pub_6w_private_no_govfund_basic_ctq,
  COALESCE(pub_6w.pub_6w_unclassified_basic_ctq, 0.0) AS pub_6w_unclassified_basic_ctq,

  -- Publication 6-way quality: top 5% journal
  COALESCE(pub_6wq.pub_6wq_gov_owned_top5j_ctq, 0.0) AS pub_6wq_gov_owned_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_uni_govfund_top5j_ctq, 0.0) AS pub_6wq_uni_govfund_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_uni_no_govfund_top5j_ctq, 0.0) AS pub_6wq_uni_no_govfund_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_private_govfund_top5j_ctq, 0.0) AS pub_6wq_private_govfund_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_private_no_govfund_top5j_ctq, 0.0) AS pub_6wq_private_no_govfund_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_unclassified_top5j_ctq, 0.0) AS pub_6wq_unclassified_top5j_ctq,

  -- Publication 6-way quality: top 0.1% breakthrough
  COALESCE(pub_6wq.pub_6wq_gov_owned_top01_ctq, 0.0) AS pub_6wq_gov_owned_top01_ctq,
  COALESCE(pub_6wq.pub_6wq_uni_govfund_top01_ctq, 0.0) AS pub_6wq_uni_govfund_top01_ctq,
  COALESCE(pub_6wq.pub_6wq_uni_no_govfund_top01_ctq, 0.0) AS pub_6wq_uni_no_govfund_top01_ctq,
  COALESCE(pub_6wq.pub_6wq_private_govfund_top01_ctq, 0.0) AS pub_6wq_private_govfund_top01_ctq,
  COALESCE(pub_6wq.pub_6wq_private_no_govfund_top01_ctq, 0.0) AS pub_6wq_private_no_govfund_top01_ctq,
  COALESCE(pub_6wq.pub_6wq_unclassified_top01_ctq, 0.0) AS pub_6wq_unclassified_top01_ctq,

  -- Self-contained quality totals (match the 6-way quality buckets exactly)
  COALESCE(pub_6wq.pub_6wq_total_top5j_ctq, 0.0) AS pub_6wq_total_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_total_top01_ctq, 0.0) AS pub_6wq_total_top01_ctq,
  COALESCE(pub_6wq.pub_6wq_total_basic_top5j_ctq, 0.0) AS pub_6wq_total_basic_top5j_ctq,
  COALESCE(pub_6wq.pub_6wq_total_basic_top01_ctq, 0.0) AS pub_6wq_total_basic_top01_ctq

FROM grid
LEFT JOIN pat
  ON pat.country_code = grid.country_code AND pat.quarter = grid.quarter
LEFT JOIN pub
  ON pub.country_code = grid.country_code AND pub.quarter = grid.quarter
LEFT JOIN pub_qual
  ON pub_qual.country_code = grid.country_code AND pub_qual.quarter = grid.quarter
LEFT JOIN pub_6w
  ON pub_6w.country_code = grid.country_code AND pub_6w.quarter = grid.quarter
LEFT JOIN pub_6wq
  ON pub_6wq.country_code = grid.country_code AND pub_6wq.quarter = grid.quarter
LEFT JOIN pat_8wc
  ON pat_8wc.country_code = grid.country_code AND pat_8wc.quarter = grid.quarter
LEFT JOIN pat_6w
  ON pat_6w.country_code = grid.country_code AND pat_6w.quarter = grid.quarter
LEFT JOIN pat_inv_diag
  ON pat_inv_diag.country_code = grid.country_code AND pat_inv_diag.quarter = grid.quarter
