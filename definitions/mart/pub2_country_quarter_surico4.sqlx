config {
  type: "table",
  name: "pub2_country_quarter_surico4",
  schema: "rd_mart",
  tags: ["mart", "phase4", "pub2"],
  description: "Country×quarter publications: totals + Surico-4 split using Option-2 ownership and gov_funded_flag."
}

WITH agg AS (
  SELECT
    country_code,
    quarter,

    SUM(w_aff) AS total_eng,

    -- Surico: public-public (owned by government)
    SUM(w_public_prod) AS owned_eng,

    -- funded (gov) regardless of ownership, useful diagnostic
    SUM(IF(gov_funded_flag, w_aff, 0)) AS funded_any_eng,

    -- public-private: gov funded but privately owned
    SUM(IF(gov_funded_flag, w_private_prod, 0)) AS funded_private_owned_eng,

    -- private-private: privately owned and not gov funded
    SUM(IF(NOT gov_funded_flag, w_private_prod, 0)) AS private_private_eng,

    -- should be near zero
    SUM(w_unclassified) AS unclassified_eng
  FROM ${ref("pub2_country_flags")}
  GROUP BY country_code, quarter
)

SELECT
  g.country_code,
  g.quarter,
  COALESCE(a.total_eng, 0) AS total_eng,
  COALESCE(a.owned_eng, 0) AS owned_eng,
  COALESCE(a.funded_any_eng, 0) AS funded_any_eng,
  COALESCE(a.funded_private_owned_eng, 0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0) AS unclassified_eng
FROM ${ref("quarter_grid")} g
LEFT JOIN agg a
  ON a.country_code = g.country_code
 AND a.quarter = g.quarter
ORDER BY country_code, quarter
