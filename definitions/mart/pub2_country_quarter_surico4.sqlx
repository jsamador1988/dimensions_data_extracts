config {
  type: "table",
  name: "pub2_country_quarter_surico4",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter publication totals decomposed into Surico4 (Option-2 single-bucket assignment at paper×country×quarter). Outputs: total_eng, owned_eng (public_public), funded_private_owned_eng (public_private), private_private_eng, unclassified_eng."
}

WITH gq AS (
  SELECT country_code, quarter
  FROM ${ref("quarter_grid")}
),

base AS (
  SELECT
    country_code,
    quarter,

    CAST(w_aff AS FLOAT64) AS w_total,
    CAST(w_public_prod AS FLOAT64) AS w_owned,

    IF(gov_funded_flag = 1, CAST(w_private_prod AS FLOAT64), 0.0) AS w_funded_private_owned,
    IF(gov_funded_flag = 0, CAST(w_private_prod AS FLOAT64), 0.0) AS w_private_private,

    GREATEST(
      0.0,
      CAST(w_aff AS FLOAT64) - CAST(w_public_prod AS FLOAT64) - CAST(w_private_prod AS FLOAT64)
    ) AS w_unclassified,

    IF(gov_funded_flag = 1, CAST(w_aff AS FLOAT64), 0.0) AS w_funded_any

  FROM ${ref("rd_int", "pub2_country_flags")}
  WHERE country_code IS NOT NULL
    AND quarter IS NOT NULL
),

agg AS (
  SELECT
    country_code,
    quarter,
    SUM(w_total) AS total_eng,
    SUM(w_owned) AS owned_eng,
    SUM(w_funded_private_owned) AS funded_private_owned_eng,
    SUM(w_private_private) AS private_private_eng,
    SUM(w_unclassified) AS unclassified_eng,
    SUM(w_funded_any) AS funded_any_eng
  FROM base
  GROUP BY country_code, quarter
)

SELECT
  gq.country_code,
  gq.quarter,
  COALESCE(a.total_eng, 0.0) AS total_eng,
  COALESCE(a.owned_eng, 0.0) AS owned_eng,
  COALESCE(a.funded_private_owned_eng, 0.0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0.0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0.0) AS unclassified_eng,
  COALESCE(a.funded_any_eng, 0.0) AS funded_any_eng
FROM gq
LEFT JOIN agg a
  ON a.country_code = gq.country_code
 AND a.quarter = gq.quarter
ORDER BY country_code, quarter
