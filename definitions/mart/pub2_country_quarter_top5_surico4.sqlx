config {
  type: "table",
  name: "pub2_country_quarter_top5_surico4",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter top5 output (top-5% journals) decomposed into Surico4: owned, funded_any, funded_private_owned, private_private."
}

WITH gq AS (
  SELECT country_code, quarter
  FROM ${ref("quarter_grid")}
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,

    (cf.w_aff * tf.w_field * tf.is_top5) AS w_top5,

    (cf.w_public_prod * tf.w_field * tf.is_top5) AS w_top5_owned,

    (CASE WHEN cf.gov_funded_flag = 1 THEN (cf.w_aff * tf.w_field * tf.is_top5) ELSE 0.0 END) AS w_top5_funded_any,

    (CASE WHEN cf.gov_funded_flag = 1 THEN (cf.w_private_prod * tf.w_field * tf.is_top5) ELSE 0.0 END) AS w_top5_funded_private_owned,

    (CASE WHEN cf.gov_funded_flag = 0 THEN (cf.w_private_prod * tf.w_field * tf.is_top5) ELSE 0.0 END) AS w_top5_private_private,

    (cf.w_unclassified * tf.w_field * tf.is_top5) AS w_top5_unclassified
  FROM ${ref("pub2_country_flags")} cf
  JOIN ${ref("rd_stage", "pub_top5_pub_field")} tf
    ON tf.pub_id = cf.pub_id
   AND tf.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    SUM(w_top5) AS top5_total_eng,
    SUM(w_top5_owned) AS top5_owned_eng,
    SUM(w_top5_funded_any) AS top5_funded_any_eng,
    SUM(w_top5_funded_private_owned) AS top5_funded_private_owned_eng,
    SUM(w_top5_private_private) AS top5_private_private_eng,
    SUM(w_top5_unclassified) AS top5_unclassified_eng
  FROM base
  GROUP BY country_code, quarter
)

SELECT
  gq.country_code,
  gq.quarter,
  COALESCE(a.top5_total_eng, 0) AS top5_total_eng,
  COALESCE(a.top5_owned_eng, 0) AS top5_owned_eng,
  COALESCE(a.top5_funded_any_eng, 0) AS top5_funded_any_eng,
  COALESCE(a.top5_funded_private_owned_eng, 0) AS top5_funded_private_owned_eng,
  COALESCE(a.top5_private_private_eng, 0) AS top5_private_private_eng,
  COALESCE(a.top5_unclassified_eng, 0) AS top5_unclassified_eng
FROM gq
LEFT JOIN agg a
  ON a.country_code = gq.country_code
 AND a.quarter = gq.quarter
ORDER BY country_code, quarter