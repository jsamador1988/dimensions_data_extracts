config {
  type: "table",
  name: "pub2_country_quarter_top5_surico4",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter top-5% journal publication mass (FoR field-weighted) decomposed into Surico4. Uses rd_stage.pub_top5_pub_field."
}

WITH gq AS (
  SELECT country_code, quarter
  FROM ${ref("quarter_grid")}
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,

    (CAST(cf.w_aff AS FLOAT64) * tf.w_field * CAST(tf.is_top5 AS FLOAT64)) AS w_total,
    (CAST(cf.w_public_prod AS FLOAT64) * tf.w_field * CAST(tf.is_top5 AS FLOAT64)) AS w_owned,

    IF(cf.gov_funded_flag = 1, CAST(cf.w_private_prod AS FLOAT64) * tf.w_field * CAST(tf.is_top5 AS FLOAT64), 0.0) AS w_funded_private_owned,
    IF(cf.gov_funded_flag = 0, CAST(cf.w_private_prod AS FLOAT64) * tf.w_field * CAST(tf.is_top5 AS FLOAT64), 0.0) AS w_private_private,

    (GREATEST(0.0, CAST(cf.w_aff AS FLOAT64) - CAST(cf.w_public_prod AS FLOAT64) - CAST(cf.w_private_prod AS FLOAT64))
      * tf.w_field * CAST(tf.is_top5 AS FLOAT64)) AS w_unclassified

  FROM ${ref("rd_int", "pub2_country_flags")} cf
  JOIN ${ref("rd_stage", "pub_top5_pub_field")} tf
    ON tf.pub_id = cf.pub_id
   AND tf.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    SUM(w_total) AS total_eng,
    SUM(w_owned) AS owned_eng,
    SUM(w_funded_private_owned) AS funded_private_owned_eng,
    SUM(w_private_private) AS private_private_eng,
    SUM(w_unclassified) AS unclassified_eng
  FROM base
  GROUP BY country_code, quarter
)

SELECT
  gq.country_code,
  gq.quarter,
  COALESCE(a.total_eng, 0.0) AS total_eng,
  COALESCE(a.owned_eng, 0.0) AS owned_eng,
  COALESCE(a.funded_private_owned_eng, 0.0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0.0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0.0) AS unclassified_eng
FROM gq
LEFT JOIN agg a
  ON a.country_code = gq.country_code
 AND a.quarter = gq.quarter
ORDER BY country_code, quarter
