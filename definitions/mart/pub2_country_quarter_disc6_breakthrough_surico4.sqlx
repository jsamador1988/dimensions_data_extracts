config {
  type: "table",
  schema: "rd_mart",
  name: "pub2_country_quarter_disc6_breakthrough_surico4",
  tags: ["mart", "pub2"],
  description: "Country×quarter×disc6 BREAKTHROUGH (field-weighted) publication fractional counts split into Surico-4 buckets. Built by mapping field22→disc6 and summing field22-level breakthrough Surico-4 series."
}

WITH field22 AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_field22_breakthrough_surico4")}
),
map AS (
  SELECT DISTINCT
    field22_code,
    disc6_code,
    disc6_name
  FROM ${ref("rd_stage", "pub_fields_distinct")}
)

SELECT
  f.country_code,
  f.quarter,
  COALESCE(m.disc6_code, "DISCUNK") AS disc6_code,
  COALESCE(m.disc6_name, "Unknown") AS disc6_name,
  SUM(f.total_eng) AS total_eng,
  SUM(f.owned_eng) AS owned_eng,
  SUM(f.funded_private_owned_eng) AS funded_private_owned_eng,
  SUM(f.private_private_eng) AS private_private_eng,
  SUM(f.unclassified_eng) AS unclassified_eng
FROM field22 f
LEFT JOIN map m
  USING (field22_code)
GROUP BY country_code, quarter, disc6_code, disc6_name
