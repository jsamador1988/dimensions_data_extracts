  IF(r.quarter <= lpq.last_pub_quarter, r.pub_field_PSYCH_break_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_field_PSYCH_break_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_field_PSYCH_break_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_field_PSYCH_break_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_field_PSYCH_break_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_field_PSYCH_break_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_field_PSYCH_break_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_field_PSYCH_break_unclassified_ctq
FROM pub_raw r
CROSS JOIN last_pub_qtr lpq
