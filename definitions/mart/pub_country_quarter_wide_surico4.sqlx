    SUM(IF(field22_code = 'LAW', funded_private_owned_eng, 0.0)) AS pub_field_LAW_top5_public_private_ctq,
    SUM(IF(field22_code = 'LAW', private_private_eng, 0.0)) AS pub_field_LAW_top5_private_private_ctq,
    SUM(IF(field22_code = 'LAW', unclassified_eng, 0.0)) AS pub_field_LAW_top5_unclassified_ctq,
