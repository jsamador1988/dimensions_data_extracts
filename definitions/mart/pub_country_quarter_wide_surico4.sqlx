  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_top5_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_top5_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_top5_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_top5_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_top5_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_top5_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_top5_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_top5_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_top5_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_top5_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_break_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_break_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_break_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_break_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_break_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_break_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_break_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_break_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_break_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_break_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC2_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC2_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC2_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC2_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC2_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC2_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC2_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC2_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC2_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC2_unclassified_ctq,
