config {
  type: "table",
  schema: "rd_mart",
  name: "pub_country_quarter_wide_surico4",
  tags: ["mart", "pub2"],
  description: "Balanced publication country×quarter panel with Surico-4 decomposition applied exhaustively to totals, top5, breakthroughs, and all field22/disc6 series. Publication series are tail-censored (NULL) after the last quarter with any observed publications in the analysis universe.",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"],
    requirePartitionFilter: true
  }
}

pre_operations {
  DROP TABLE IF EXISTS ${self()}
}

WITH grid AS (
  SELECT country_code, quarter
  FROM ${ref("rd_stage", "analysis_country_quarter_grid")}
),

-- ------------------------------------------------------------
-- Overall publications (all pubs; includes pubs without FoR)
-- ------------------------------------------------------------
pub_total AS (
  SELECT
    country_code,
    quarter,
    total_eng AS pub_total_ctq,
    owned_eng AS pub_public_public_ctq,
    funded_private_owned_eng AS pub_public_private_ctq,
    private_private_eng AS pub_private_private_ctq,
    unclassified_eng AS pub_unclassified_ctq
  FROM ${ref("rd_mart", "pub2_country_quarter_surico4")}
),

-- ------------------------------------------------------------
-- Field-level publications (classified only; FoR-based)
-- ------------------------------------------------------------
field_long AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_field22_surico4")}
),

field_wide AS (
  SELECT
    country_code,
    quarter,
    SUM(IF(field22_code = 'AGRI', total_eng, 0.0)) AS pub_field_AGRI_ctq,
    SUM(IF(field22_code = 'AGRI', owned_eng, 0.0)) AS pub_field_AGRI_public_public_ctq,
    SUM(IF(field22_code = 'AGRI', funded_private_owned_eng, 0.0)) AS pub_field_AGRI_public_private_ctq,
    SUM(IF(field22_code = 'AGRI', private_private_eng, 0.0)) AS pub_field_AGRI_private_private_ctq,
    SUM(IF(field22_code = 'AGRI', unclassified_eng, 0.0)) AS pub_field_AGRI_unclassified_ctq,
    SUM(IF(field22_code = 'BIO', total_eng, 0.0)) AS pub_field_BIO_ctq,
    SUM(IF(field22_code = 'BIO', owned_eng, 0.0)) AS pub_field_BIO_public_public_ctq,
    SUM(IF(field22_code = 'BIO', funded_private_owned_eng, 0.0)) AS pub_field_BIO_public_private_ctq,
    SUM(IF(field22_code = 'BIO', private_private_eng, 0.0)) AS pub_field_BIO_private_private_ctq,
    SUM(IF(field22_code = 'BIO', unclassified_eng, 0.0)) AS pub_field_BIO_unclassified_ctq,
    SUM(IF(field22_code = 'BIOMED', total_eng, 0.0)) AS pub_field_BIOMED_ctq,
    SUM(IF(field22_code = 'BIOMED', owned_eng, 0.0)) AS pub_field_BIOMED_public_public_ctq,
    SUM(IF(field22_code = 'BIOMED', funded_private_owned_eng, 0.0)) AS pub_field_BIOMED_public_private_ctq,
    SUM(IF(field22_code = 'BIOMED', private_private_eng, 0.0)) AS pub_field_BIOMED_private_private_ctq,
    SUM(IF(field22_code = 'BIOMED', unclassified_eng, 0.0)) AS pub_field_BIOMED_unclassified_ctq,
    SUM(IF(field22_code = 'BUILT', total_eng, 0.0)) AS pub_field_BUILT_ctq,
    SUM(IF(field22_code = 'BUILT', owned_eng, 0.0)) AS pub_field_BUILT_public_public_ctq,
    SUM(IF(field22_code = 'BUILT', funded_private_owned_eng, 0.0)) AS pub_field_BUILT_public_private_ctq,
    SUM(IF(field22_code = 'BUILT', private_private_eng, 0.0)) AS pub_field_BUILT_private_private_ctq,
    SUM(IF(field22_code = 'BUILT', unclassified_eng, 0.0)) AS pub_field_BUILT_unclassified_ctq,
    SUM(IF(field22_code = 'CHEM', total_eng, 0.0)) AS pub_field_CHEM_ctq,
    SUM(IF(field22_code = 'CHEM', owned_eng, 0.0)) AS pub_field_CHEM_public_public_ctq,
    SUM(IF(field22_code = 'CHEM', funded_private_owned_eng, 0.0)) AS pub_field_CHEM_public_private_ctq,
    SUM(IF(field22_code = 'CHEM', private_private_eng, 0.0)) AS pub_field_CHEM_private_private_ctq,
    SUM(IF(field22_code = 'CHEM', unclassified_eng, 0.0)) AS pub_field_CHEM_unclassified_ctq,
    SUM(IF(field22_code = 'COMMERCE', total_eng, 0.0)) AS pub_field_COMMERCE_ctq,
    SUM(IF(field22_code = 'COMMERCE', owned_eng, 0.0)) AS pub_field_COMMERCE_public_public_ctq,
    SUM(IF(field22_code = 'COMMERCE', funded_private_owned_eng, 0.0)) AS pub_field_COMMERCE_public_private_ctq,
    SUM(IF(field22_code = 'COMMERCE', private_private_eng, 0.0)) AS pub_field_COMMERCE_private_private_ctq,
    SUM(IF(field22_code = 'COMMERCE', unclassified_eng, 0.0)) AS pub_field_COMMERCE_unclassified_ctq,
    SUM(IF(field22_code = 'CREATIVE', total_eng, 0.0)) AS pub_field_CREATIVE_ctq,
    SUM(IF(field22_code = 'CREATIVE', owned_eng, 0.0)) AS pub_field_CREATIVE_public_public_ctq,
    SUM(IF(field22_code = 'CREATIVE', funded_private_owned_eng, 0.0)) AS pub_field_CREATIVE_public_private_ctq,
    SUM(IF(field22_code = 'CREATIVE', private_private_eng, 0.0)) AS pub_field_CREATIVE_private_private_ctq,
    SUM(IF(field22_code = 'CREATIVE', unclassified_eng, 0.0)) AS pub_field_CREATIVE_unclassified_ctq,
    SUM(IF(field22_code = 'EARTH', total_eng, 0.0)) AS pub_field_EARTH_ctq,
    SUM(IF(field22_code = 'EARTH', owned_eng, 0.0)) AS pub_field_EARTH_public_public_ctq,
    SUM(IF(field22_code = 'EARTH', funded_private_owned_eng, 0.0)) AS pub_field_EARTH_public_private_ctq,
    SUM(IF(field22_code = 'EARTH', private_private_eng, 0.0)) AS pub_field_EARTH_private_private_ctq,
    SUM(IF(field22_code = 'EARTH', unclassified_eng, 0.0)) AS pub_field_EARTH_unclassified_ctq,
    SUM(IF(field22_code = 'ECON', total_eng, 0.0)) AS pub_field_ECON_ctq,
    SUM(IF(field22_code = 'ECON', owned_eng, 0.0)) AS pub_field_ECON_public_public_ctq,
    SUM(IF(field22_code = 'ECON', funded_private_owned_eng, 0.0)) AS pub_field_ECON_public_private_ctq,
    SUM(IF(field22_code = 'ECON', private_private_eng, 0.0)) AS pub_field_ECON_private_private_ctq,
    SUM(IF(field22_code = 'ECON', unclassified_eng, 0.0)) AS pub_field_ECON_unclassified_ctq,
    SUM(IF(field22_code = 'EDUC', total_eng, 0.0)) AS pub_field_EDUC_ctq,
    SUM(IF(field22_code = 'EDUC', owned_eng, 0.0)) AS pub_field_EDUC_public_public_ctq,
    SUM(IF(field22_code = 'EDUC', funded_private_owned_eng, 0.0)) AS pub_field_EDUC_public_private_ctq,
    SUM(IF(field22_code = 'EDUC', private_private_eng, 0.0)) AS pub_field_EDUC_private_private_ctq,
    SUM(IF(field22_code = 'EDUC', unclassified_eng, 0.0)) AS pub_field_EDUC_unclassified_ctq,
    SUM(IF(field22_code = 'ENG', total_eng, 0.0)) AS pub_field_ENG_ctq,
    SUM(IF(field22_code = 'ENG', owned_eng, 0.0)) AS pub_field_ENG_public_public_ctq,
    SUM(IF(field22_code = 'ENG', funded_private_owned_eng, 0.0)) AS pub_field_ENG_public_private_ctq,
    SUM(IF(field22_code = 'ENG', private_private_eng, 0.0)) AS pub_field_ENG_private_private_ctq,
    SUM(IF(field22_code = 'ENG', unclassified_eng, 0.0)) AS pub_field_ENG_unclassified_ctq,
    SUM(IF(field22_code = 'ENV', total_eng, 0.0)) AS pub_field_ENV_ctq,
    SUM(IF(field22_code = 'ENV', owned_eng, 0.0)) AS pub_field_ENV_public_public_ctq,
    SUM(IF(field22_code = 'ENV', funded_private_owned_eng, 0.0)) AS pub_field_ENV_public_private_ctq,
    SUM(IF(field22_code = 'ENV', private_private_eng, 0.0)) AS pub_field_ENV_private_private_ctq,
    SUM(IF(field22_code = 'ENV', unclassified_eng, 0.0)) AS pub_field_ENV_unclassified_ctq,
    SUM(IF(field22_code = 'HEALTH', total_eng, 0.0)) AS pub_field_HEALTH_ctq,
    SUM(IF(field22_code = 'HEALTH', owned_eng, 0.0)) AS pub_field_HEALTH_public_public_ctq,
    SUM(IF(field22_code = 'HEALTH', funded_private_owned_eng, 0.0)) AS pub_field_HEALTH_public_private_ctq,
    SUM(IF(field22_code = 'HEALTH', private_private_eng, 0.0)) AS pub_field_HEALTH_private_private_ctq,
    SUM(IF(field22_code = 'HEALTH', unclassified_eng, 0.0)) AS pub_field_HEALTH_unclassified_ctq,
    SUM(IF(field22_code = 'HISTORY', total_eng, 0.0)) AS pub_field_HISTORY_ctq,
    SUM(IF(field22_code = 'HISTORY', owned_eng, 0.0)) AS pub_field_HISTORY_public_public_ctq,
    SUM(IF(field22_code = 'HISTORY', funded_private_owned_eng, 0.0)) AS pub_field_HISTORY_public_private_ctq,
    SUM(IF(field22_code = 'HISTORY', private_private_eng, 0.0)) AS pub_field_HISTORY_private_private_ctq,
    SUM(IF(field22_code = 'HISTORY', unclassified_eng, 0.0)) AS pub_field_HISTORY_unclassified_ctq,
    SUM(IF(field22_code = 'HUMAN', total_eng, 0.0)) AS pub_field_HUMAN_ctq,
    SUM(IF(field22_code = 'HUMAN', owned_eng, 0.0)) AS pub_field_HUMAN_public_public_ctq,
    SUM(IF(field22_code = 'HUMAN', funded_private_owned_eng, 0.0)) AS pub_field_HUMAN_public_private_ctq,
    SUM(IF(field22_code = 'HUMAN', private_private_eng, 0.0)) AS pub_field_HUMAN_private_private_ctq,
    SUM(IF(field22_code = 'HUMAN', unclassified_eng, 0.0)) AS pub_field_HUMAN_unclassified_ctq,
    SUM(IF(field22_code = 'INFOCOMP', total_eng, 0.0)) AS pub_field_INFOCOMP_ctq,
    SUM(IF(field22_code = 'INFOCOMP', owned_eng, 0.0)) AS pub_field_INFOCOMP_public_public_ctq,
    SUM(IF(field22_code = 'INFOCOMP', funded_private_owned_eng, 0.0)) AS pub_field_INFOCOMP_public_private_ctq,
    SUM(IF(field22_code = 'INFOCOMP', private_private_eng, 0.0)) AS pub_field_INFOCOMP_private_private_ctq,
    SUM(IF(field22_code = 'INFOCOMP', unclassified_eng, 0.0)) AS pub_field_INFOCOMP_unclassified_ctq,
    SUM(IF(field22_code = 'LANG', total_eng, 0.0)) AS pub_field_LANG_ctq,
    SUM(IF(field22_code = 'LANG', owned_eng, 0.0)) AS pub_field_LANG_public_public_ctq,
    SUM(IF(field22_code = 'LANG', funded_private_owned_eng, 0.0)) AS pub_field_LANG_public_private_ctq,
    SUM(IF(field22_code = 'LANG', private_private_eng, 0.0)) AS pub_field_LANG_private_private_ctq,
    SUM(IF(field22_code = 'LANG', unclassified_eng, 0.0)) AS pub_field_LANG_unclassified_ctq,
    SUM(IF(field22_code = 'LAW', total_eng, 0.0)) AS pub_field_LAW_ctq,
    SUM(IF(field22_code = 'LAW', owned_eng, 0.0)) AS pub_field_LAW_public_public_ctq,
    SUM(IF(field22_code = 'LAW', funded_private_owned_eng, 0.0)) AS pub_field_LAW_public_private_ctq,
    SUM(IF(field22_code = 'LAW', private_private_eng, 0.0)) AS pub_field_LAW_private_private_ctq,
    SUM(IF(field22_code = 'LAW', unclassified_eng, 0.0)) AS pub_field_LAW_unclassified_ctq,
    SUM(IF(field22_code = 'MATH', total_eng, 0.0)) AS pub_field_MATH_ctq,
    SUM(IF(field22_code = 'MATH', owned_eng, 0.0)) AS pub_field_MATH_public_public_ctq,
    SUM(IF(field22_code = 'MATH', funded_private_owned_eng, 0.0)) AS pub_field_MATH_public_private_ctq,
    SUM(IF(field22_code = 'MATH', private_private_eng, 0.0)) AS pub_field_MATH_private_private_ctq,
    SUM(IF(field22_code = 'MATH', unclassified_eng, 0.0)) AS pub_field_MATH_unclassified_ctq,
    SUM(IF(field22_code = 'PHIL', total_eng, 0.0)) AS pub_field_PHIL_ctq,
    SUM(IF(field22_code = 'PHIL', owned_eng, 0.0)) AS pub_field_PHIL_public_public_ctq,
    SUM(IF(field22_code = 'PHIL', funded_private_owned_eng, 0.0)) AS pub_field_PHIL_public_private_ctq,
    SUM(IF(field22_code = 'PHIL', private_private_eng, 0.0)) AS pub_field_PHIL_private_private_ctq,
    SUM(IF(field22_code = 'PHIL', unclassified_eng, 0.0)) AS pub_field_PHIL_unclassified_ctq,
    SUM(IF(field22_code = 'PHYSICAL', total_eng, 0.0)) AS pub_field_PHYSICAL_ctq,
    SUM(IF(field22_code = 'PHYSICAL', owned_eng, 0.0)) AS pub_field_PHYSICAL_public_public_ctq,
    SUM(IF(field22_code = 'PHYSICAL', funded_private_owned_eng, 0.0)) AS pub_field_PHYSICAL_public_private_ctq,
    SUM(IF(field22_code = 'PHYSICAL', private_private_eng, 0.0)) AS pub_field_PHYSICAL_private_private_ctq,
    SUM(IF(field22_code = 'PHYSICAL', unclassified_eng, 0.0)) AS pub_field_PHYSICAL_unclassified_ctq,
    SUM(IF(field22_code = 'PSYCH', total_eng, 0.0)) AS pub_field_PSYCH_ctq,
    SUM(IF(field22_code = 'PSYCH', owned_eng, 0.0)) AS pub_field_PSYCH_public_public_ctq,
    SUM(IF(field22_code = 'PSYCH', funded_private_owned_eng, 0.0)) AS pub_field_PSYCH_public_private_ctq,
    SUM(IF(field22_code = 'PSYCH', private_private_eng, 0.0)) AS pub_field_PSYCH_private_private_ctq,
    SUM(IF(field22_code = 'PSYCH', unclassified_eng, 0.0)) AS pub_field_PSYCH_unclassified_ctq
  FROM field_long
  GROUP BY country_code, quarter
),

field_classified AS (
  SELECT
    country_code,
    quarter,
    SUM(total_eng) AS pub_total_classified_ctq,
    SUM(owned_eng) AS pub_total_classified_public_public_ctq,
    SUM(funded_private_owned_eng) AS pub_total_classified_public_private_ctq,
    SUM(private_private_eng) AS pub_total_classified_private_private_ctq,
    SUM(unclassified_eng) AS pub_total_classified_unclassified_ctq
  FROM field_long
  GROUP BY country_code, quarter
),

field_unclassified AS (
  SELECT
    g.country_code,
    g.quarter,

    (pt.pub_total_ctq - fc.pub_total_classified_ctq) AS pub_total_unclassified_ctq,
    (pt.pub_public_public_ctq - fc.pub_total_classified_public_public_ctq) AS pub_total_unclassified_public_public_ctq,
    (pt.pub_public_private_ctq - fc.pub_total_classified_public_private_ctq) AS pub_total_unclassified_public_private_ctq,
    (pt.pub_private_private_ctq - fc.pub_total_classified_private_private_ctq) AS pub_total_unclassified_private_private_ctq,
    (pt.pub_unclassified_ctq - fc.pub_total_classified_unclassified_ctq) AS pub_total_unclassified_unclassified_ctq

  FROM grid g
  LEFT JOIN pub_total pt
    ON pt.country_code = g.country_code AND pt.quarter = g.quarter
  LEFT JOIN field_classified fc
    ON fc.country_code = g.country_code AND fc.quarter = g.quarter
),

-- ------------------------------------------------------------
-- Top5 publications (FoR-based)
-- ------------------------------------------------------------
top5_overall AS (
  SELECT
    country_code,
    quarter,
    total_eng AS pub_top5_ctq,
    owned_eng AS pub_top5_public_public_ctq,
    funded_private_owned_eng AS pub_top5_public_private_ctq,
    private_private_eng AS pub_top5_private_private_ctq,
    unclassified_eng AS pub_top5_unclassified_ctq
  FROM ${ref("rd_mart", "pub2_country_quarter_top5_surico4")}
),

field_top5_long AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_field22_top5_surico4")}
),

field_top5_wide AS (
  SELECT
    country_code,
    quarter,
    SUM(IF(field22_code = 'AGRI', total_eng, 0.0)) AS pub_field_AGRI_top5_ctq,
    SUM(IF(field22_code = 'AGRI', owned_eng, 0.0)) AS pub_field_AGRI_top5_public_public_ctq,
    SUM(IF(field22_code = 'AGRI', funded_private_owned_eng, 0.0)) AS pub_field_AGRI_top5_public_private_ctq,
    SUM(IF(field22_code = 'AGRI', private_private_eng, 0.0)) AS pub_field_AGRI_top5_private_private_ctq,
    SUM(IF(field22_code = 'AGRI', unclassified_eng, 0.0)) AS pub_field_AGRI_top5_unclassified_ctq,
    SUM(IF(field22_code = 'BIO', total_eng, 0.0)) AS pub_field_BIO_top5_ctq,
    SUM(IF(field22_code = 'BIO', owned_eng, 0.0)) AS pub_field_BIO_top5_public_public_ctq,
    SUM(IF(field22_code = 'BIO', funded_private_owned_eng, 0.0)) AS pub_field_BIO_top5_public_private_ctq,
    SUM(IF(field22_code = 'BIO', private_private_eng, 0.0)) AS pub_field_BIO_top5_private_private_ctq,
    SUM(IF(field22_code = 'BIO', unclassified_eng, 0.0)) AS pub_field_BIO_top5_unclassified_ctq,
    SUM(IF(field22_code = 'BIOMED', total_eng, 0.0)) AS pub_field_BIOMED_top5_ctq,
    SUM(IF(field22_code = 'BIOMED', owned_eng, 0.0)) AS pub_field_BIOMED_top5_public_public_ctq,
    SUM(IF(field22_code = 'BIOMED', funded_private_owned_eng, 0.0)) AS pub_field_BIOMED_top5_public_private_ctq,
    SUM(IF(field22_code = 'BIOMED', private_private_eng, 0.0)) AS pub_field_BIOMED_top5_private_private_ctq,
    SUM(IF(field22_code = 'BIOMED', unclassified_eng, 0.0)) AS pub_field_BIOMED_top5_unclassified_ctq,
    SUM(IF(field22_code = 'BUILT', total_eng, 0.0)) AS pub_field_BUILT_top5_ctq,
    SUM(IF(field22_code = 'BUILT', owned_eng, 0.0)) AS pub_field_BUILT_top5_public_public_ctq,
    SUM(IF(field22_code = 'BUILT', funded_private_owned_eng, 0.0)) AS pub_field_BUILT_top5_public_private_ctq,
    SUM(IF(field22_code = 'BUILT', private_private_eng, 0.0)) AS pub_field_BUILT_top5_private_private_ctq,
    SUM(IF(field22_code = 'BUILT', unclassified_eng, 0.0)) AS pub_field_BUILT_top5_unclassified_ctq,
    SUM(IF(field22_code = 'CHEM', total_eng, 0.0)) AS pub_field_CHEM_top5_ctq,
    SUM(IF(field22_code = 'CHEM', owned_eng, 0.0)) AS pub_field_CHEM_top5_public_public_ctq,
    SUM(IF(field22_code = 'CHEM', funded_private_owned_eng, 0.0)) AS pub_field_CHEM_top5_public_private_ctq,
    SUM(IF(field22_code = 'CHEM', private_private_eng, 0.0)) AS pub_field_CHEM_top5_private_private_ctq,
    SUM(IF(field22_code = 'CHEM', unclassified_eng, 0.0)) AS pub_field_CHEM_top5_unclassified_ctq,
    SUM(IF(field22_code = 'COMMERCE', total_eng, 0.0)) AS pub_field_COMMERCE_top5_ctq,
    SUM(IF(field22_code = 'COMMERCE', owned_eng, 0.0)) AS pub_field_COMMERCE_top5_public_public_ctq,
    SUM(IF(field22_code = 'COMMERCE', funded_private_owned_eng, 0.0)) AS pub_field_COMMERCE_top5_public_private_ctq,
    SUM(IF(field22_code = 'COMMERCE', private_private_eng, 0.0)) AS pub_field_COMMERCE_top5_private_private_ctq,
    SUM(IF(field22_code = 'COMMERCE', unclassified_eng, 0.0)) AS pub_field_COMMERCE_top5_unclassified_ctq,
    SUM(IF(field22_code = 'CREATIVE', total_eng, 0.0)) AS pub_field_CREATIVE_top5_ctq,
    SUM(IF(field22_code = 'CREATIVE', owned_eng, 0.0)) AS pub_field_CREATIVE_top5_public_public_ctq,
    SUM(IF(field22_code = 'CREATIVE', funded_private_owned_eng, 0.0)) AS pub_field_CREATIVE_top5_public_private_ctq,
    SUM(IF(field22_code = 'CREATIVE', private_private_eng, 0.0)) AS pub_field_CREATIVE_top5_private_private_ctq,
    SUM(IF(field22_code = 'CREATIVE', unclassified_eng, 0.0)) AS pub_field_CREATIVE_top5_unclassified_ctq,
    SUM(IF(field22_code = 'EARTH', total_eng, 0.0)) AS pub_field_EARTH_top5_ctq,
    SUM(IF(field22_code = 'EARTH', owned_eng, 0.0)) AS pub_field_EARTH_top5_public_public_ctq,
    SUM(IF(field22_code = 'EARTH', funded_private_owned_eng, 0.0)) AS pub_field_EARTH_top5_public_private_ctq,
    SUM(IF(field22_code = 'EARTH', private_private_eng, 0.0)) AS pub_field_EARTH_top5_private_private_ctq,
    SUM(IF(field22_code = 'EARTH', unclassified_eng, 0.0)) AS pub_field_EARTH_top5_unclassified_ctq,
    SUM(IF(field22_code = 'ECON', total_eng, 0.0)) AS pub_field_ECON_top5_ctq,
    SUM(IF(field22_code = 'ECON', owned_eng, 0.0)) AS pub_field_ECON_top5_public_public_ctq,
    SUM(IF(field22_code = 'ECON', funded_private_owned_eng, 0.0)) AS pub_field_ECON_top5_public_private_ctq,
    SUM(IF(field22_code = 'ECON', private_private_eng, 0.0)) AS pub_field_ECON_top5_private_private_ctq,
    SUM(IF(field22_code = 'ECON', unclassified_eng, 0.0)) AS pub_field_ECON_top5_unclassified_ctq,
    SUM(IF(field22_code = 'EDUC', total_eng, 0.0)) AS pub_field_EDUC_top5_ctq,
    SUM(IF(field22_code = 'EDUC', owned_eng, 0.0)) AS pub_field_EDUC_top5_public_public_ctq,
    SUM(IF(field22_code = 'EDUC', funded_private_owned_eng, 0.0)) AS pub_field_EDUC_top5_public_private_ctq,
    SUM(IF(field22_code = 'EDUC', private_private_eng, 0.0)) AS pub_field_EDUC_top5_private_private_ctq,
    SUM(IF(field22_code = 'EDUC', unclassified_eng, 0.0)) AS pub_field_EDUC_top5_unclassified_ctq,
    SUM(IF(field22_code = 'ENG', total_eng, 0.0)) AS pub_field_ENG_top5_ctq,
    SUM(IF(field22_code = 'ENG', owned_eng, 0.0)) AS pub_field_ENG_top5_public_public_ctq,
    SUM(IF(field22_code = 'ENG', funded_private_owned_eng, 0.0)) AS pub_field_ENG_top5_public_private_ctq,
    SUM(IF(field22_code = 'ENG', private_private_eng, 0.0)) AS pub_field_ENG_top5_private_private_ctq,
    SUM(IF(field22_code = 'ENG', unclassified_eng, 0.0)) AS pub_field_ENG_top5_unclassified_ctq,
    SUM(IF(field22_code = 'ENV', total_eng, 0.0)) AS pub_field_ENV_top5_ctq,
    SUM(IF(field22_code = 'ENV', owned_eng, 0.0)) AS pub_field_ENV_top5_public_public_ctq,
