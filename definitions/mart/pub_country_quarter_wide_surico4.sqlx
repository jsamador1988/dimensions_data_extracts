    SUM(IF(field22_code = 'MATH', private_private_eng, 0.0)) AS pub_field_MATH_break_private_private_ctq,
    SUM(IF(field22_code = 'MATH', unclassified_eng, 0.0)) AS pub_field_MATH_break_unclassified_ctq,
    SUM(IF(field22_code = 'PHIL', total_eng, 0.0)) AS pub_field_PHIL_break_ctq,
    SUM(IF(field22_code = 'PHIL', owned_eng, 0.0)) AS pub_field_PHIL_break_public_public_ctq,
    SUM(IF(field22_code = 'PHIL', funded_private_owned_eng, 0.0)) AS pub_field_PHIL_break_public_private_ctq,
    SUM(IF(field22_code = 'PHIL', private_private_eng, 0.0)) AS pub_field_PHIL_break_private_private_ctq,
    SUM(IF(field22_code = 'PHIL', unclassified_eng, 0.0)) AS pub_field_PHIL_break_unclassified_ctq,
    SUM(IF(field22_code = 'PHYSICAL', total_eng, 0.0)) AS pub_field_PHYSICAL_break_ctq,
    SUM(IF(field22_code = 'PHYSICAL', owned_eng, 0.0)) AS pub_field_PHYSICAL_break_public_public_ctq,
    SUM(IF(field22_code = 'PHYSICAL', funded_private_owned_eng, 0.0)) AS pub_field_PHYSICAL_break_public_private_ctq,
    SUM(IF(field22_code = 'PHYSICAL', private_private_eng, 0.0)) AS pub_field_PHYSICAL_break_private_private_ctq,
    SUM(IF(field22_code = 'PHYSICAL', unclassified_eng, 0.0)) AS pub_field_PHYSICAL_break_unclassified_ctq,
    SUM(IF(field22_code = 'PSYCH', total_eng, 0.0)) AS pub_field_PSYCH_break_ctq,
    SUM(IF(field22_code = 'PSYCH', owned_eng, 0.0)) AS pub_field_PSYCH_break_public_public_ctq,
    SUM(IF(field22_code = 'PSYCH', funded_private_owned_eng, 0.0)) AS pub_field_PSYCH_break_public_private_ctq,
    SUM(IF(field22_code = 'PSYCH', private_private_eng, 0.0)) AS pub_field_PSYCH_break_private_private_ctq,
    SUM(IF(field22_code = 'PSYCH', unclassified_eng, 0.0)) AS pub_field_PSYCH_break_unclassified_ctq
  FROM field_break_long
  GROUP BY country_code, quarter
),

disc_break_long AS (
  SELECT
    country_code,
    quarter,
    disc6_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_disc6_breakthrough_surico4")}
),

disc_break_wide AS (
  SELECT
    country_code,
    quarter,
    SUM(IF(disc6_code = 'DISC1', total_eng, 0.0)) AS pub_disc_DISC1_break_ctq,
    SUM(IF(disc6_code = 'DISC1', owned_eng, 0.0)) AS pub_disc_DISC1_break_public_public_ctq,
    SUM(IF(disc6_code = 'DISC1', funded_private_owned_eng, 0.0)) AS pub_disc_DISC1_break_public_private_ctq,
    SUM(IF(disc6_code = 'DISC1', private_private_eng, 0.0)) AS pub_disc_DISC1_break_private_private_ctq,
    SUM(IF(disc6_code = 'DISC1', unclassified_eng, 0.0)) AS pub_disc_DISC1_break_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC2', total_eng, 0.0)) AS pub_disc_DISC2_break_ctq,
    SUM(IF(disc6_code = 'DISC2', owned_eng, 0.0)) AS pub_disc_DISC2_break_public_public_ctq,
    SUM(IF(disc6_code = 'DISC2', funded_private_owned_eng, 0.0)) AS pub_disc_DISC2_break_public_private_ctq,
    SUM(IF(disc6_code = 'DISC2', private_private_eng, 0.0)) AS pub_disc_DISC2_break_private_private_ctq,
    SUM(IF(disc6_code = 'DISC2', unclassified_eng, 0.0)) AS pub_disc_DISC2_break_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC3', total_eng, 0.0)) AS pub_disc_DISC3_break_ctq,
    SUM(IF(disc6_code = 'DISC3', owned_eng, 0.0)) AS pub_disc_DISC3_break_public_public_ctq,
    SUM(IF(disc6_code = 'DISC3', funded_private_owned_eng, 0.0)) AS pub_disc_DISC3_break_public_private_ctq,
    SUM(IF(disc6_code = 'DISC3', private_private_eng, 0.0)) AS pub_disc_DISC3_break_private_private_ctq,
    SUM(IF(disc6_code = 'DISC3', unclassified_eng, 0.0)) AS pub_disc_DISC3_break_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC4', total_eng, 0.0)) AS pub_disc_DISC4_break_ctq,
    SUM(IF(disc6_code = 'DISC4', owned_eng, 0.0)) AS pub_disc_DISC4_break_public_public_ctq,
    SUM(IF(disc6_code = 'DISC4', funded_private_owned_eng, 0.0)) AS pub_disc_DISC4_break_public_private_ctq,
    SUM(IF(disc6_code = 'DISC4', private_private_eng, 0.0)) AS pub_disc_DISC4_break_private_private_ctq,
    SUM(IF(disc6_code = 'DISC4', unclassified_eng, 0.0)) AS pub_disc_DISC4_break_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC5', total_eng, 0.0)) AS pub_disc_DISC5_break_ctq,
    SUM(IF(disc6_code = 'DISC5', owned_eng, 0.0)) AS pub_disc_DISC5_break_public_public_ctq,
    SUM(IF(disc6_code = 'DISC5', funded_private_owned_eng, 0.0)) AS pub_disc_DISC5_break_public_private_ctq,
    SUM(IF(disc6_code = 'DISC5', private_private_eng, 0.0)) AS pub_disc_DISC5_break_private_private_ctq,
    SUM(IF(disc6_code = 'DISC5', unclassified_eng, 0.0)) AS pub_disc_DISC5_break_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC6', total_eng, 0.0)) AS pub_disc_DISC6_break_ctq,
    SUM(IF(disc6_code = 'DISC6', owned_eng, 0.0)) AS pub_disc_DISC6_break_public_public_ctq,
    SUM(IF(disc6_code = 'DISC6', funded_private_owned_eng, 0.0)) AS pub_disc_DISC6_break_public_private_ctq,
    SUM(IF(disc6_code = 'DISC6', private_private_eng, 0.0)) AS pub_disc_DISC6_break_private_private_ctq,
    SUM(IF(disc6_code = 'DISC6', unclassified_eng, 0.0)) AS pub_disc_DISC6_break_unclassified_ctq
  FROM disc_break_long
  GROUP BY country_code, quarter
),

-- Breakthrough eligibility at the publication level (ANY eligible field for a pub)
eligible_pub AS (
  SELECT
    pub_id,
    quarter,
    MAX(eligible_for_breakthrough) AS break_eligible
  FROM ${ref("rd_stage", "pub_breakthrough_pub_field")}
  GROUP BY pub_id, quarter
),

eligible_overall AS (
  SELECT
    g.country_code,
    g.quarter,
    COALESCE(SUM(cf.total_eng * e.break_eligible), 0.0) AS pub_break_eligible_ctq,
    COALESCE(SUM(cf.owned_eng * e.break_eligible), 0.0) AS pub_break_eligible_public_public_ctq,
    COALESCE(SUM(cf.funded_private_owned_eng * e.break_eligible), 0.0) AS pub_break_eligible_public_private_ctq,
    COALESCE(SUM(cf.private_private_eng * e.break_eligible), 0.0) AS pub_break_eligible_private_private_ctq,
    COALESCE(SUM(cf.unclassified_eng * e.break_eligible), 0.0) AS pub_break_eligible_unclassified_ctq
  FROM grid g
  LEFT JOIN ${ref("rd_int", "pub2_country_flags")} cf
    ON cf.country_code = g.country_code AND cf.quarter = g.quarter
  LEFT JOIN eligible_pub e
    ON e.pub_id = cf.pub_id AND e.quarter = cf.quarter
  GROUP BY g.country_code, g.quarter
),

-- ------------------------------------------------------------
-- Discipline-level totals (classified only; FoR-based)
-- ------------------------------------------------------------
disc_long AS (
  SELECT
    country_code,
    quarter,
    disc6_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_disc6_surico4")}
),

disc_wide AS (
  SELECT
    country_code,
    quarter,
    SUM(IF(disc6_code = 'DISC1', total_eng, 0.0)) AS pub_disc_DISC1_ctq,
    SUM(IF(disc6_code = 'DISC1', owned_eng, 0.0)) AS pub_disc_DISC1_public_public_ctq,
    SUM(IF(disc6_code = 'DISC1', funded_private_owned_eng, 0.0)) AS pub_disc_DISC1_public_private_ctq,
    SUM(IF(disc6_code = 'DISC1', private_private_eng, 0.0)) AS pub_disc_DISC1_private_private_ctq,
    SUM(IF(disc6_code = 'DISC1', unclassified_eng, 0.0)) AS pub_disc_DISC1_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC2', total_eng, 0.0)) AS pub_disc_DISC2_ctq,
    SUM(IF(disc6_code = 'DISC2', owned_eng, 0.0)) AS pub_disc_DISC2_public_public_ctq,
    SUM(IF(disc6_code = 'DISC2', funded_private_owned_eng, 0.0)) AS pub_disc_DISC2_public_private_ctq,
    SUM(IF(disc6_code = 'DISC2', private_private_eng, 0.0)) AS pub_disc_DISC2_private_private_ctq,
    SUM(IF(disc6_code = 'DISC2', unclassified_eng, 0.0)) AS pub_disc_DISC2_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC3', total_eng, 0.0)) AS pub_disc_DISC3_ctq,
    SUM(IF(disc6_code = 'DISC3', owned_eng, 0.0)) AS pub_disc_DISC3_public_public_ctq,
    SUM(IF(disc6_code = 'DISC3', funded_private_owned_eng, 0.0)) AS pub_disc_DISC3_public_private_ctq,
    SUM(IF(disc6_code = 'DISC3', private_private_eng, 0.0)) AS pub_disc_DISC3_private_private_ctq,
    SUM(IF(disc6_code = 'DISC3', unclassified_eng, 0.0)) AS pub_disc_DISC3_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC4', total_eng, 0.0)) AS pub_disc_DISC4_ctq,
    SUM(IF(disc6_code = 'DISC4', owned_eng, 0.0)) AS pub_disc_DISC4_public_public_ctq,
    SUM(IF(disc6_code = 'DISC4', funded_private_owned_eng, 0.0)) AS pub_disc_DISC4_public_private_ctq,
    SUM(IF(disc6_code = 'DISC4', private_private_eng, 0.0)) AS pub_disc_DISC4_private_private_ctq,
    SUM(IF(disc6_code = 'DISC4', unclassified_eng, 0.0)) AS pub_disc_DISC4_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC5', total_eng, 0.0)) AS pub_disc_DISC5_ctq,
    SUM(IF(disc6_code = 'DISC5', owned_eng, 0.0)) AS pub_disc_DISC5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC5', funded_private_owned_eng, 0.0)) AS pub_disc_DISC5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC5', private_private_eng, 0.0)) AS pub_disc_DISC5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC5', unclassified_eng, 0.0)) AS pub_disc_DISC5_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC6', total_eng, 0.0)) AS pub_disc_DISC6_ctq,
    SUM(IF(disc6_code = 'DISC6', owned_eng, 0.0)) AS pub_disc_DISC6_public_public_ctq,
    SUM(IF(disc6_code = 'DISC6', funded_private_owned_eng, 0.0)) AS pub_disc_DISC6_public_private_ctq,
    SUM(IF(disc6_code = 'DISC6', private_private_eng, 0.0)) AS pub_disc_DISC6_private_private_ctq,
    SUM(IF(disc6_code = 'DISC6', unclassified_eng, 0.0)) AS pub_disc_DISC6_unclassified_ctq
  FROM disc_long
  GROUP BY country_code, quarter
),

-- ------------------------------------------------------------
-- Assemble wide (uncensored)
-- ------------------------------------------------------------
pub_raw AS (
  SELECT
    g.country_code,
    g.quarter,

    -- overall totals
    COALESCE(pt.pub_total_ctq, 0.0) AS pub_total_ctq,
    COALESCE(pt.pub_public_public_ctq, 0.0) AS pub_public_public_ctq,
    COALESCE(pt.pub_public_private_ctq, 0.0) AS pub_public_private_ctq,
    COALESCE(pt.pub_private_private_ctq, 0.0) AS pub_private_private_ctq,
    COALESCE(pt.pub_unclassified_ctq, 0.0) AS pub_unclassified_ctq,

    -- classified / unclassified-to-field diagnostics
    COALESCE(fc.pub_total_classified_ctq, 0.0) AS pub_total_classified_ctq,
    COALESCE(fc.pub_total_classified_public_public_ctq, 0.0) AS pub_total_classified_public_public_ctq,
    COALESCE(fc.pub_total_classified_public_private_ctq, 0.0) AS pub_total_classified_public_private_ctq,
    COALESCE(fc.pub_total_classified_private_private_ctq, 0.0) AS pub_total_classified_private_private_ctq,
    COALESCE(fc.pub_total_classified_unclassified_ctq, 0.0) AS pub_total_classified_unclassified_ctq,

    COALESCE(fu.pub_total_unclassified_ctq, 0.0) AS pub_total_unclassified_ctq,
    COALESCE(fu.pub_total_unclassified_public_public_ctq, 0.0) AS pub_total_unclassified_public_public_ctq,
    COALESCE(fu.pub_total_unclassified_public_private_ctq, 0.0) AS pub_total_unclassified_public_private_ctq,
    COALESCE(fu.pub_total_unclassified_private_private_ctq, 0.0) AS pub_total_unclassified_private_private_ctq,
    COALESCE(fu.pub_total_unclassified_unclassified_ctq, 0.0) AS pub_total_unclassified_unclassified_ctq,

    -- top5 overall
    COALESCE(t5.pub_top5_ctq, 0.0) AS pub_top5_ctq,
    COALESCE(t5.pub_top5_public_public_ctq, 0.0) AS pub_top5_public_public_ctq,
    COALESCE(t5.pub_top5_public_private_ctq, 0.0) AS pub_top5_public_private_ctq,
    COALESCE(t5.pub_top5_private_private_ctq, 0.0) AS pub_top5_private_private_ctq,
    COALESCE(t5.pub_top5_unclassified_ctq, 0.0) AS pub_top5_unclassified_ctq,

    -- breakthrough overall
    COALESCE(br.pub_break_ctq, 0.0) AS pub_break_ctq,
    COALESCE(br.pub_break_public_public_ctq, 0.0) AS pub_break_public_public_ctq,
    COALESCE(br.pub_break_public_private_ctq, 0.0) AS pub_break_public_private_ctq,
    COALESCE(br.pub_break_private_private_ctq, 0.0) AS pub_break_private_private_ctq,
    COALESCE(br.pub_break_unclassified_ctq, 0.0) AS pub_break_unclassified_ctq,

    -- breakthrough eligibility overall
    COALESCE(el.pub_break_eligible_ctq, 0.0) AS pub_break_eligible_ctq,
    COALESCE(el.pub_break_eligible_public_public_ctq, 0.0) AS pub_break_eligible_public_public_ctq,
    COALESCE(el.pub_break_eligible_public_private_ctq, 0.0) AS pub_break_eligible_public_private_ctq,
    COALESCE(el.pub_break_eligible_private_private_ctq, 0.0) AS pub_break_eligible_private_private_ctq,
    COALESCE(el.pub_break_eligible_unclassified_ctq, 0.0) AS pub_break_eligible_unclassified_ctq,

    -- discipline totals + top5 + breakthrough
    COALESCE(dw.pub_disc_DISC1_ctq, 0.0) AS pub_disc_DISC1_ctq, COALESCE(dw.pub_disc_DISC1_public_public_ctq, 0.0) AS pub_disc_DISC1_public_public_ctq, COALESCE(dw.pub_disc_DISC1_public_private_ctq, 0.0) AS pub_disc_DISC1_public_private_ctq, COALESCE(dw.pub_disc_DISC1_private_private_ctq, 0.0) AS pub_disc_DISC1_private_private_ctq, COALESCE(dw.pub_disc_DISC1_unclassified_ctq, 0.0) AS pub_disc_DISC1_unclassified_ctq, COALESCE(dw.pub_disc_DISC2_ctq, 0.0) AS pub_disc_DISC2_ctq, COALESCE(dw.pub_disc_DISC2_public_public_ctq, 0.0) AS pub_disc_DISC2_public_public_ctq, COALESCE(dw.pub_disc_DISC2_public_private_ctq, 0.0) AS pub_disc_DISC2_public_private_ctq, COALESCE(dw.pub_disc_DISC2_private_private_ctq, 0.0) AS pub_disc_DISC2_private_private_ctq, COALESCE(dw.pub_disc_DISC2_unclassified_ctq, 0.0) AS pub_disc_DISC2_unclassified_ctq, COALESCE(dw.pub_disc_DISC3_ctq, 0.0) AS pub_disc_DISC3_ctq, COALESCE(dw.pub_disc_DISC3_public_public_ctq, 0.0) AS pub_disc_DISC3_public_public_ctq, COALESCE(dw.pub_disc_DISC3_public_private_ctq, 0.0) AS pub_disc_DISC3_public_private_ctq, COALESCE(dw.pub_disc_DISC3_private_private_ctq, 0.0) AS pub_disc_DISC3_private_private_ctq, COALESCE(dw.pub_disc_DISC3_unclassified_ctq, 0.0) AS pub_disc_DISC3_unclassified_ctq, COALESCE(dw.pub_disc_DISC4_ctq, 0.0) AS pub_disc_DISC4_ctq, COALESCE(dw.pub_disc_DISC4_public_public_ctq, 0.0) AS pub_disc_DISC4_public_public_ctq, COALESCE(dw.pub_disc_DISC4_public_private_ctq, 0.0) AS pub_disc_DISC4_public_private_ctq, COALESCE(dw.pub_disc_DISC4_private_private_ctq, 0.0) AS pub_disc_DISC4_private_private_ctq, COALESCE(dw.pub_disc_DISC4_unclassified_ctq, 0.0) AS pub_disc_DISC4_unclassified_ctq, COALESCE(dw.pub_disc_DISC5_ctq, 0.0) AS pub_disc_DISC5_ctq, COALESCE(dw.pub_disc_DISC5_public_public_ctq, 0.0) AS pub_disc_DISC5_public_public_ctq, COALESCE(dw.pub_disc_DISC5_public_private_ctq, 0.0) AS pub_disc_DISC5_public_private_ctq, COALESCE(dw.pub_disc_DISC5_private_private_ctq, 0.0) AS pub_disc_DISC5_private_private_ctq, COALESCE(dw.pub_disc_DISC5_unclassified_ctq, 0.0) AS pub_disc_DISC5_unclassified_ctq, COALESCE(dw.pub_disc_DISC6_ctq, 0.0) AS pub_disc_DISC6_ctq, COALESCE(dw.pub_disc_DISC6_public_public_ctq, 0.0) AS pub_disc_DISC6_public_public_ctq, COALESCE(dw.pub_disc_DISC6_public_private_ctq, 0.0) AS pub_disc_DISC6_public_private_ctq, COALESCE(dw.pub_disc_DISC6_private_private_ctq, 0.0) AS pub_disc_DISC6_private_private_ctq, COALESCE(dw.pub_disc_DISC6_unclassified_ctq, 0.0) AS pub_disc_DISC6_unclassified_ctq,
