eld_LANG_break_public_private_ctq, 0.0) AS pub_field_LANG_break_public_private_ctq, COALESCE(fb.pub_field_LANG_break_private_private_ctq, 0.0) AS pub_field_LANG_break_private_private_ctq, COALESCE(fb.pub_field_LANG_break_unclassified_ctq, 0.0) AS pub_field_LANG_break_unclassified_ctq, COALESCE(fb.pub_field_LAW_break_ctq, 0.0) AS pub_field_LAW_break_ctq, COALESCE(fb.pub_field_LAW_break_public_public_ctq, 0.0) AS pub_field_LAW_break_public_public_ctq, COALESCE(fb.pub_field_LAW_break_public_private_ctq, 0.0) AS pub_field_LAW_break_public_private_ctq, COALESCE(fb.pub_field_LAW_break_private_private_ctq, 0.0) AS pub_field_LAW_break_private_private_ctq, COALESCE(fb.pub_field_LAW_break_unclassified_ctq, 0.0) AS pub_field_LAW_break_unclassified_ctq, COALESCE(fb.pub_field_MATH_break_ctq, 0.0) AS pub_field_MATH_break_ctq, COALESCE(fb.pub_field_MATH_break_public_public_ctq, 0.0) AS pub_field_MATH_break_public_public_ctq, COALESCE(fb.pub_field_MATH_break_public_private_ctq, 0.0) AS pub_field_MATH_break_public_private_ctq, COALESCE(fb.pub_field_MATH_break_private_private_ctq, 0.0) AS pub_field_MATH_break_private_private_ctq, COALESCE(fb.pub_field_MATH_break_unclassified_ctq, 0.0) AS pub_field_MATH_break_unclassified_ctq, COALESCE(fb.pub_field_PHIL_break_ctq, 0.0) AS pub_field_PHIL_break_ctq, COALESCE(fb.pub_field_PHIL_break_public_public_ctq, 0.0) AS pub_field_PHIL_break_public_public_ctq, COALESCE(fb.pub_field_PHIL_break_public_private_ctq, 0.0) AS pub_field_PHIL_break_public_private_ctq, COALESCE(fb.pub_field_PHIL_break_private_private_ctq, 0.0) AS pub_field_PHIL_break_private_private_ctq, COALESCE(fb.pub_field_PHIL_break_unclassified_ctq, 0.0) AS pub_field_PHIL_break_unclassified_ctq, COALESCE(fb.pub_field_PHYSICAL_break_ctq, 0.0) AS pub_field_PHYSICAL_break_ctq, COALESCE(fb.pub_field_PHYSICAL_break_public_public_ctq, 0.0) AS pub_field_PHYSICAL_break_public_public_ctq, COALESCE(fb.pub_field_PHYSICAL_break_public_private_ctq, 0.0) AS pub_field_PHYSICAL_break_public_private_ctq, COALESCE(fb.pub_field_PHYSICAL_break_private_private_ctq, 0.0) AS pub_field_PHYSICAL_break_private_private_ctq, COALESCE(fb.pub_field_PHYSICAL_break_unclassified_ctq, 0.0) AS pub_field_PHYSICAL_break_unclassified_ctq, COALESCE(fb.pub_field_PSYCH_break_ctq, 0.0) AS pub_field_PSYCH_break_ctq, COALESCE(fb.pub_field_PSYCH_break_public_public_ctq, 0.0) AS pub_field_PSYCH_break_public_public_ctq, COALESCE(fb.pub_field_PSYCH_break_public_private_ctq, 0.0) AS pub_field_PSYCH_break_public_private_ctq, COALESCE(fb.pub_field_PSYCH_break_private_private_ctq, 0.0) AS pub_field_PSYCH_break_private_private_ctq, COALESCE(fb.pub_field_PSYCH_break_unclassified_ctq, 0.0) AS pub_field_PSYCH_break_unclassified_ctq

  FROM grid g
  LEFT JOIN pub_total pt
    ON pt.country_code = g.country_code AND pt.quarter = g.quarter
  LEFT JOIN field_classified fc
    ON fc.country_code = g.country_code AND fc.quarter = g.quarter
  LEFT JOIN field_unclassified fu
    ON fu.country_code = g.country_code AND fu.quarter = g.quarter
  LEFT JOIN top5_overall t5
    ON t5.country_code = g.country_code AND t5.quarter = g.quarter
  LEFT JOIN break_overall br
    ON br.country_code = g.country_code AND br.quarter = g.quarter
  LEFT JOIN eligible_overall el
    ON el.country_code = g.country_code AND el.quarter = g.quarter

  LEFT JOIN disc_wide dw
    ON dw.country_code = g.country_code AND dw.quarter = g.quarter
  LEFT JOIN disc_top5_wide d5
    ON d5.country_code = g.country_code AND d5.quarter = g.quarter
  LEFT JOIN disc_break_wide db
    ON db.country_code = g.country_code AND db.quarter = g.quarter

  LEFT JOIN field_wide fw
    ON fw.country_code = g.country_code AND fw.quarter = g.quarter
  LEFT JOIN field_top5_wide ft5
    ON ft5.country_code = g.country_code AND ft5.quarter = g.quarter
  LEFT JOIN field_break_wide fb
    ON fb.country_code = g.country_code AND fb.quarter = g.quarter
),

last_pub_qtr AS (
  SELECT MAX(quarter) AS last_pub_quarter
  FROM pub_raw
  WHERE pub_total_ctq > 0
)

SELECT
  r.country_code,
  r.quarter,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_ctq, CAST(NULL AS FLOAT64)) AS pub_total_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_classified_ctq, CAST(NULL AS FLOAT64)) AS pub_total_classified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_classified_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_total_classified_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_classified_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_total_classified_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_classified_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_total_classified_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_classified_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_total_classified_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_total_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_unclassified_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_total_unclassified_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_unclassified_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_total_unclassified_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_unclassified_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_total_unclassified_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_total_unclassified_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_total_unclassified_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_top5_ctq, CAST(NULL AS FLOAT64)) AS pub_top5_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_top5_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_top5_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_top5_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_top5_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_top5_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_top5_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_top5_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_top5_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_ctq, CAST(NULL AS FLOAT64)) AS pub_break_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_break_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_break_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_break_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_break_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_eligible_ctq, CAST(NULL AS FLOAT64)) AS pub_break_eligible_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_eligible_public_public_ctq, CAST(NULL AS FLOAT64)) AS pub_break_eligible_public_public_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_eligible_public_private_ctq, CAST(NULL AS FLOAT64)) AS pub_break_eligible_public_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_eligible_private_private_ctq, CAST(NULL AS FLOAT64)) AS pub_break_eligible_private_private_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_break_eligible_unclassified_ctq, CAST(NULL AS FLOAT64)) AS pub_break_eligible_unclassified_ctq,
  IF(r.quarter <= lpq.last_pub_quarter, r.pub_disc_DISC1_ctq, CAST(NULL AS FLOAT64)) AS pub_disc_DISC1_ctq,
