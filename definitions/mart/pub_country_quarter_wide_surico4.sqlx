  FROM field_top5_long
  GROUP BY country_code, quarter
),

disc_top5_long AS (
  SELECT
    country_code,
    quarter,
    disc6_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_disc6_top5_surico4")}
),

disc_top5_wide AS (
  SELECT
    country_code,
    quarter,
    SUM(IF(disc6_code = 'DISC1', total_eng, 0.0)) AS pub_disc_DISC1_top5_ctq,
    SUM(IF(disc6_code = 'DISC1', owned_eng, 0.0)) AS pub_disc_DISC1_top5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC1', funded_private_owned_eng, 0.0)) AS pub_disc_DISC1_top5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC1', private_private_eng, 0.0)) AS pub_disc_DISC1_top5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC1', unclassified_eng, 0.0)) AS pub_disc_DISC1_top5_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC2', total_eng, 0.0)) AS pub_disc_DISC2_top5_ctq,
    SUM(IF(disc6_code = 'DISC2', owned_eng, 0.0)) AS pub_disc_DISC2_top5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC2', funded_private_owned_eng, 0.0)) AS pub_disc_DISC2_top5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC2', private_private_eng, 0.0)) AS pub_disc_DISC2_top5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC2', unclassified_eng, 0.0)) AS pub_disc_DISC2_top5_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC3', total_eng, 0.0)) AS pub_disc_DISC3_top5_ctq,
    SUM(IF(disc6_code = 'DISC3', owned_eng, 0.0)) AS pub_disc_DISC3_top5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC3', funded_private_owned_eng, 0.0)) AS pub_disc_DISC3_top5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC3', private_private_eng, 0.0)) AS pub_disc_DISC3_top5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC3', unclassified_eng, 0.0)) AS pub_disc_DISC3_top5_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC4', total_eng, 0.0)) AS pub_disc_DISC4_top5_ctq,
    SUM(IF(disc6_code = 'DISC4', owned_eng, 0.0)) AS pub_disc_DISC4_top5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC4', funded_private_owned_eng, 0.0)) AS pub_disc_DISC4_top5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC4', private_private_eng, 0.0)) AS pub_disc_DISC4_top5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC4', unclassified_eng, 0.0)) AS pub_disc_DISC4_top5_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC5', total_eng, 0.0)) AS pub_disc_DISC5_top5_ctq,
    SUM(IF(disc6_code = 'DISC5', owned_eng, 0.0)) AS pub_disc_DISC5_top5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC5', funded_private_owned_eng, 0.0)) AS pub_disc_DISC5_top5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC5', private_private_eng, 0.0)) AS pub_disc_DISC5_top5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC5', unclassified_eng, 0.0)) AS pub_disc_DISC5_top5_unclassified_ctq,
    SUM(IF(disc6_code = 'DISC6', total_eng, 0.0)) AS pub_disc_DISC6_top5_ctq,
    SUM(IF(disc6_code = 'DISC6', owned_eng, 0.0)) AS pub_disc_DISC6_top5_public_public_ctq,
    SUM(IF(disc6_code = 'DISC6', funded_private_owned_eng, 0.0)) AS pub_disc_DISC6_top5_public_private_ctq,
    SUM(IF(disc6_code = 'DISC6', private_private_eng, 0.0)) AS pub_disc_DISC6_top5_private_private_ctq,
    SUM(IF(disc6_code = 'DISC6', unclassified_eng, 0.0)) AS pub_disc_DISC6_top5_unclassified_ctq
  FROM disc_top5_long
  GROUP BY country_code, quarter
),

-- ------------------------------------------------------------
-- Breakthrough publications (FoR-based)
-- ------------------------------------------------------------
break_overall AS (
  SELECT
    country_code,
    quarter,
    total_eng AS pub_break_ctq,
    owned_eng AS pub_break_public_public_ctq,
    funded_private_owned_eng AS pub_break_public_private_ctq,
    private_private_eng AS pub_break_private_private_ctq,
    unclassified_eng AS pub_break_unclassified_ctq
  FROM ${ref("rd_mart", "pub2_country_quarter_overall_breakthrough_surico4")}
),

field_break_long AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng
  FROM ${ref("rd_mart", "pub2_country_quarter_field22_breakthrough_surico4")}
),

