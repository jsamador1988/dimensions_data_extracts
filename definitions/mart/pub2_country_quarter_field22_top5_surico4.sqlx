config {
  type: "table",
  name: "pub2_country_quarter_field22_top5_surico4",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter×field22 top5 output (top-5% journals) with Surico4 decomposition."
}

WITH field_dim AS (
  SELECT DISTINCT
    field22_code,
    field22_name
  FROM ${ref("rd_stage", "pub_fields_distinct")}
  WHERE field22_code IS NOT NULL
),

grid AS (
  SELECT
    qg.country_code,
    qg.quarter,
    fd.field22_code,
    fd.field22_name
  FROM ${ref("quarter_grid")} qg
  CROSS JOIN field_dim fd
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,
    tf.field22_code,

    (cf.w_aff * tf.w_field * tf.is_top5) AS w_top5,

    (cf.w_public_prod * tf.w_field * tf.is_top5) AS w_top5_owned,

    (CASE WHEN cf.gov_funded_flag THEN (cf.w_aff * tf.w_field * tf.is_top5) ELSE 0 END) AS w_top5_funded_any,

    (CASE WHEN cf.gov_funded_flag THEN (cf.w_private_prod * tf.w_field * tf.is_top5) ELSE 0 END) AS w_top5_funded_private_owned,

    (CASE WHEN NOT cf.gov_funded_flag THEN (cf.w_private_prod * tf.w_field * tf.is_top5) ELSE 0 END) AS w_top5_private_private,

    (cf.w_unclassified * tf.w_field * tf.is_top5) AS w_top5_unclassified
  FROM ${ref("pub2_country_flags")} cf
  JOIN ${ref("rd_stage", "pub_top5_pub_field")} tf
    ON tf.pub_id = cf.pub_id
   AND tf.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    SUM(w_top5) AS top5_total_eng,
    SUM(w_top5_owned) AS top5_owned_eng,
    SUM(w_top5_funded_any) AS top5_funded_any_eng,
    SUM(w_top5_funded_private_owned) AS top5_funded_private_owned_eng,
    SUM(w_top5_private_private) AS top5_private_private_eng,
    SUM(w_top5_unclassified) AS top5_unclassified_eng
  FROM base
  GROUP BY country_code, quarter, field22_code
)

SELECT
  g.country_code,
  g.quarter,
  g.field22_code,
  g.field22_name,
  COALESCE(a.top5_total_eng, 0) AS top5_total_eng,
  COALESCE(a.top5_owned_eng, 0) AS top5_owned_eng,
  COALESCE(a.top5_funded_any_eng, 0) AS top5_funded_any_eng,
  COALESCE(a.top5_funded_private_owned_eng, 0) AS top5_funded_private_owned_eng,
  COALESCE(a.top5_private_private_eng, 0) AS top5_private_private_eng,
  COALESCE(a.top5_unclassified_eng, 0) AS top5_unclassified_eng
FROM grid g
LEFT JOIN agg a
  ON a.country_code = g.country_code
 AND a.quarter = g.quarter
 And a.field22_code = g.field22_code
ORDER BY country_code, quarter, field22_code