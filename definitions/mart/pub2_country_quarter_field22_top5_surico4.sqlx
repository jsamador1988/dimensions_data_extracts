config {
  type: "table",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter×field22 Surico4 series for top-5% journals (field-specific)."
}

WITH pf AS (
  SELECT
    pub_id,
    quarter,
    field22_code,
    w_field
  FROM ${ref("rd_stage", "pub_field_flags")}
  WHERE is_top5_field = 1
),

cf AS (
  SELECT
    pub_id,
    quarter,
    country_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng,
    funded_any_eng
  FROM ${ref("rd_int", "pub2_country_flags")}
),

fields AS (
  SELECT field22_code, field22_name, disc6_code, disc6_name
  FROM ${ref("rd_stage", "pub_fields_distinct")}
)

SELECT
  cf.country_code,
  cf.quarter,
  pf.field22_code,
  f.field22_name,
  f.disc6_code,
  f.disc6_name,

  SUM(cf.total_eng * pf.w_field) AS total_eng,
  SUM(cf.owned_eng * pf.w_field) AS owned_eng,
  SUM(cf.funded_private_owned_eng * pf.w_field) AS funded_private_owned_eng,
  SUM(cf.private_private_eng * pf.w_field) AS private_private_eng,
  SUM(cf.unclassified_eng * pf.w_field) AS unclassified_eng,
  SUM(cf.funded_any_eng * pf.w_field) AS funded_any_eng
FROM pf
JOIN cf
  ON cf.pub_id = pf.pub_id
 AND cf.quarter = pf.quarter
LEFT JOIN fields f
  ON f.field22_code = pf.field22_code
GROUP BY
  cf.country_code, cf.quarter,
  pf.field22_code, f.field22_name, f.disc6_code, f.disc6_name
ORDER BY
  country_code, quarter, field22_code
