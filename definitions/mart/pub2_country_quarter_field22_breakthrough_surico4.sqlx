config {
  type: "table",
  schema: "rd_mart",
  name: "pub2_country_quarter_field22_breakthrough_surico4",
  tags: ["mart", "pub2"],
  description: "Country×quarter×field22 Surico-4 series for breakthroughs (top 1% normalized 5y citations within field22×year). Uses rd_stage.pub_breakthrough_pub_field."
}

WITH pf AS (
  SELECT
    pub_id,
    quarter,
    field22_code,
    w_field
  FROM ${ref("rd_stage", "pub_breakthrough_pub_field")}
  WHERE is_breakthrough = 1
),

cf AS (
  SELECT
    pub_id,
    quarter,
    country_code,
    total_eng,
    owned_eng,
    funded_private_owned_eng,
    private_private_eng,
    unclassified_eng,
    funded_any_eng
  FROM ${ref("rd_int", "pub2_country_flags")}
),

fields AS (
  SELECT field22_code, field22_name, disc6_code, disc6_name
  FROM ${ref("rd_stage", "pub_fields_distinct")}
  WHERE field22_code IS NOT NULL
),

grid AS (
  SELECT
    qg.country_code,
    qg.quarter,
    f.field22_code,
    f.field22_name,
    f.disc6_code,
    f.disc6_name
  FROM ${ref("quarter_grid")} qg
  CROSS JOIN fields f
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,
    pf.field22_code,

    (cf.total_eng * pf.w_field) AS w_total,
    (cf.owned_eng * pf.w_field) AS w_owned,
    (cf.funded_any_eng * pf.w_field) AS w_funded_any,
    (cf.funded_private_owned_eng * pf.w_field) AS w_funded_private_owned,
    (cf.private_private_eng * pf.w_field) AS w_private_private,
    (cf.unclassified_eng * pf.w_field) AS w_unclassified

  FROM pf
  JOIN cf
    ON cf.pub_id = pf.pub_id
   AND cf.quarter = pf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    SUM(w_total) AS total_eng,
    SUM(w_owned) AS owned_eng,
    SUM(w_funded_any) AS funded_any_eng,
    SUM(w_funded_private_owned) AS funded_private_owned_eng,
    SUM(w_private_private) AS private_private_eng,
    SUM(w_unclassified) AS unclassified_eng
  FROM base
  GROUP BY country_code, quarter, field22_code
)

SELECT
  g.country_code,
  g.quarter,
  g.field22_code,
  g.field22_name,
  g.disc6_code,
  g.disc6_name,
  COALESCE(a.total_eng, 0.0) AS total_eng,
  COALESCE(a.owned_eng, 0.0) AS owned_eng,
  COALESCE(a.funded_any_eng, 0.0) AS funded_any_eng,
  COALESCE(a.funded_private_owned_eng, 0.0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0.0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0.0) AS unclassified_eng
FROM grid g
LEFT JOIN agg a
  ON a.country_code = g.country_code
 AND a.quarter = g.quarter
 AND a.field22_code = g.field22_code
