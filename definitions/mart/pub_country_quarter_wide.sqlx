config {
  type: "table",
  name: "pub_country_quarter_wide",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Publication country×quarter wide measures (overall + field + discipline), including breakthrough (eligible-only).",

  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  }
}

-- Base keys: only country×quarter that actually exist in overall publication measures
WITH base AS (
  SELECT
    country_code,
    quarter,
    pub_total_ctq,
    pub_top5_ctq,
    pub_break_ctq,
    pub_break_eligible_weight_ctq,
    pub_public_produced_ctq,
    pub_private_produced_ctq
  FROM ${ref({schema: "rd_int", name: "pub_country_quarter_overall"})}
  WHERE quarter >= DATE '1950-01-01' AND quarter < DATE '2025-01-01'
),

-- Field long -> wide
field_wide AS (
  SELECT
    country_code,
    quarter,

    -- field totals (NULL if missing)
    SUM(IF(field22_code = 'AGRI',     pub_field_ctq, NULL)) AS pub_field_AGRI_ctq,
    SUM(IF(field22_code = 'BIO',      pub_field_ctq, NULL)) AS pub_field_BIO_ctq,
    SUM(IF(field22_code = 'BIOMED',   pub_field_ctq, NULL)) AS pub_field_BIOMED_ctq,
    SUM(IF(field22_code = 'BUILT',    pub_field_ctq, NULL)) AS pub_field_BUILT_ctq,
    SUM(IF(field22_code = 'CHEM',     pub_field_ctq, NULL)) AS pub_field_CHEM_ctq,
    SUM(IF(field22_code = 'COMMERCE', pub_field_ctq, NULL)) AS pub_field_COMMERCE_ctq,
    SUM(IF(field22_code = 'CREATIVE', pub_field_ctq, NULL)) AS pub_field_CREATIVE_ctq,
    SUM(IF(field22_code = 'EARTH',    pub_field_ctq, NULL)) AS pub_field_EARTH_ctq,
    SUM(IF(field22_code = 'ECON',     pub_field_ctq, NULL)) AS pub_field_ECON_ctq,
    SUM(IF(field22_code = 'EDUC',     pub_field_ctq, NULL)) AS pub_field_EDUC_ctq,
    SUM(IF(field22_code = 'ENG',      pub_field_ctq, NULL)) AS pub_field_ENG_ctq,
    SUM(IF(field22_code = 'ENV',      pub_field_ctq, NULL)) AS pub_field_ENV_ctq,
    SUM(IF(field22_code = 'HEALTH',   pub_field_ctq, NULL)) AS pub_field_HEALTH_ctq,
    SUM(IF(field22_code = 'HISTORY',  pub_field_ctq, NULL)) AS pub_field_HISTORY_ctq,
    SUM(IF(field22_code = 'HUMAN',    pub_field_ctq, NULL)) AS pub_field_HUMAN_ctq,
    SUM(IF(field22_code = 'INFOCOMP', pub_field_ctq, NULL)) AS pub_field_INFOCOMP_ctq,
    SUM(IF(field22_code = 'LANG',     pub_field_ctq, NULL)) AS pub_field_LANG_ctq,
    SUM(IF(field22_code = 'LAW',      pub_field_ctq, NULL)) AS pub_field_LAW_ctq,
    SUM(IF(field22_code = 'MATH',     pub_field_ctq, NULL)) AS pub_field_MATH_ctq,
    SUM(IF(field22_code = 'PHIL',     pub_field_ctq, NULL)) AS pub_field_PHIL_ctq,
    SUM(IF(field22_code = 'PHYSICAL', pub_field_ctq, NULL)) AS pub_field_PHYSICAL_ctq,
    SUM(IF(field22_code = 'PSYCH',    pub_field_ctq, NULL)) AS pub_field_PSYCH_ctq,

    -- field top5 (NULL if missing)
    SUM(IF(field22_code = 'AGRI',     pub_field_top5_ctq, NULL)) AS pub_field_AGRI_top5_ctq,
    SUM(IF(field22_code = 'BIO',      pub_field_top5_ctq, NULL)) AS pub_field_BIO_top5_ctq,
    SUM(IF(field22_code = 'BIOMED',   pub_field_top5_ctq, NULL)) AS pub_field_BIOMED_top5_ctq,
    SUM(IF(field22_code = 'BUILT',    pub_field_top5_ctq, NULL)) AS pub_field_BUILT_top5_ctq,
    SUM(IF(field22_code = 'CHEM',     pub_field_top5_ctq, NULL)) AS pub_field_CHEM_top5_ctq,
    SUM(IF(field22_code = 'COMMERCE', pub_field_top5_ctq, NULL)) AS pub_field_COMMERCE_top5_ctq,
    SUM(IF(field22_code = 'CREATIVE', pub_field_top5_ctq, NULL)) AS pub_field_CREATIVE_top5_ctq,
    SUM(IF(field22_code = 'EARTH',    pub_field_top5_ctq, NULL)) AS pub_field_EARTH_top5_ctq,
    SUM(IF(field22_code = 'ECON',     pub_field_top5_ctq, NULL)) AS pub_field_ECON_top5_ctq,
    SUM(IF(field22_code = 'EDUC',     pub_field_top5_ctq, NULL)) AS pub_field_EDUC_top5_ctq,
    SUM(IF(field22_code = 'ENG',      pub_field_top5_ctq, NULL)) AS pub_field_ENG_top5_ctq,
    SUM(IF(field22_code = 'ENV',      pub_field_top5_ctq, NULL)) AS pub_field_ENV_top5_ctq,
    SUM(IF(field22_code = 'HEALTH',   pub_field_top5_ctq, NULL)) AS pub_field_HEALTH_top5_ctq,
    SUM(IF(field22_code = 'HISTORY',  pub_field_top5_ctq, NULL)) AS pub_field_HISTORY_top5_ctq,
    SUM(IF(field22_code = 'HUMAN',    pub_field_top5_ctq, NULL)) AS pub_field_HUMAN_top5_ctq,
    SUM(IF(field22_code = 'INFOCOMP', pub_field_top5_ctq, NULL)) AS pub_field_INFOCOMP_top5_ctq,
    SUM(IF(field22_code = 'LANG',     pub_field_top5_ctq, NULL)) AS pub_field_LANG_top5_ctq,
    SUM(IF(field22_code = 'LAW',      pub_field_top5_ctq, NULL)) AS pub_field_LAW_top5_ctq,
    SUM(IF(field22_code = 'MATH',     pub_field_top5_ctq, NULL)) AS pub_field_MATH_top5_ctq,
    SUM(IF(field22_code = 'PHIL',     pub_field_top5_ctq, NULL)) AS pub_field_PHIL_top5_ctq,
    SUM(IF(field22_code = 'PHYSICAL', pub_field_top5_ctq, NULL)) AS pub_field_PHYSICAL_top5_ctq,
    SUM(IF(field22_code = 'PSYCH',    pub_field_top5_ctq, NULL)) AS pub_field_PSYCH_top5_ctq

  FROM ${ref({schema: "rd_int", name: "pub_country_quarter_field_long"})}
  WHERE quarter >= DATE '1950-01-01' AND quarter < DATE '2025-01-01'
  GROUP BY country_code, quarter
),

-- Discipline long -> wide
disc_wide AS (
  SELECT
    country_code,
    quarter,

    SUM(IF(disc6_code = 'LIFE',     pub_disc_ctq, NULL)) AS pub_disc_LIFE_ctq,
    SUM(IF(disc6_code = 'PHYS',     pub_disc_ctq, NULL)) AS pub_disc_PHYS_ctq,
    SUM(IF(disc6_code = 'ENGTECH',  pub_disc_ctq, NULL)) AS pub_disc_ENGTECH_ctq,
    SUM(IF(disc6_code = 'SOCSCI',   pub_disc_ctq, NULL)) AS pub_disc_SOCSCI_ctq,
    SUM(IF(disc6_code = 'HUMARTS',  pub_disc_ctq, NULL)) AS pub_disc_HUMARTS_ctq,

    SUM(IF(disc6_code = 'LIFE',     pub_disc_top5_ctq, NULL)) AS pub_disc_LIFE_top5_ctq,
    SUM(IF(disc6_code = 'PHYS',     pub_disc_top5_ctq, NULL)) AS pub_disc_PHYS_top5_ctq,
    SUM(IF(disc6_code = 'ENGTECH',  pub_disc_top5_ctq, NULL)) AS pub_disc_ENGTECH_top5_ctq,
    SUM(IF(disc6_code = 'SOCSCI',   pub_disc_top5_ctq, NULL)) AS pub_disc_SOCSCI_top5_ctq,
    SUM(IF(disc6_code = 'HUMARTS',  pub_disc_top5_ctq, NULL)) AS pub_disc_HUMARTS_top5_ctq

  FROM ${ref({schema: "rd_int", name: "pub_country_quarter_disc_long"})}
  WHERE quarter >= DATE '1950-01-01' AND quarter < DATE '2025-01-01'
  GROUP BY country_code, quarter
)

SELECT
  'pub_country_quarter_wide_v1_fix_breaks' AS __build_id,

  b.country_code,
  b.quarter,

  -- overall
  b.pub_total_ctq,
  b.pub_top5_ctq,

  -- breakthrough: NULL when not eligible (avoids “0 means missing” confusion)
  CASE
    WHEN b.pub_break_eligible_weight_ctq > 0 THEN b.pub_break_ctq
    ELSE NULL
  END AS pub_break_ctq,

  b.pub_break_eligible_weight_ctq,

  b.pub_public_produced_ctq,
  b.pub_private_produced_ctq,

  -- residual (keeps your existing diagnostics possible)
  GREATEST(
    b.pub_total_ctq - b.pub_public_produced_ctq - b.pub_private_produced_ctq,
    0
  ) AS pub_unknown_produced_ctq,

  -- fields
  f.* EXCEPT(country_code, quarter),

  -- disciplines
  d.* EXCEPT(country_code, quarter)

FROM base b
LEFT JOIN field_wide f USING (country_code, quarter)
LEFT JOIN disc_wide d USING (country_code, quarter)
