config {
  type: "table",
  schema: "rd_mart",
  tags: ["mart"],
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code"]
  },
  description: "WIDE country-quarter publications panel: overall series + 22 field columns (+top5) + 6 discipline columns (+top5)."
}

WITH overall AS (
  SELECT *
  FROM ${ref("pub_country_quarter_overall")}
),

field_long AS (
  SELECT country_code, quarter, field22_code, pub_field_ctq, pub_field_top5_ctq
  FROM ${ref("pub_country_quarter_field_long")}
),

disc_long AS (
  SELECT country_code, quarter, disc6_code, pub_disc_ctq, pub_disc_top5_ctq
  FROM ${ref("pub_country_quarter_disc_long")}
),

field_pivot AS (
  SELECT
    country_code,
    quarter,

    -- 22 fields: levels
    SUM(IF(field22_code='AGRI',     pub_field_ctq, 0)) AS pub_field_AGRI_ctq,
    SUM(IF(field22_code='BIO',      pub_field_ctq, 0)) AS pub_field_BIO_ctq,
    SUM(IF(field22_code='BIOMED',   pub_field_ctq, 0)) AS pub_field_BIOMED_ctq,
    SUM(IF(field22_code='BUILT',    pub_field_ctq, 0)) AS pub_field_BUILT_ctq,
    SUM(IF(field22_code='CHEM',     pub_field_ctq, 0)) AS pub_field_CHEM_ctq,
    SUM(IF(field22_code='COMMERCE', pub_field_ctq, 0)) AS pub_field_COMMERCE_ctq,
    SUM(IF(field22_code='CREATIVE', pub_field_ctq, 0)) AS pub_field_CREATIVE_ctq,
    SUM(IF(field22_code='EARTH',    pub_field_ctq, 0)) AS pub_field_EARTH_ctq,
    SUM(IF(field22_code='ECON',     pub_field_ctq, 0)) AS pub_field_ECON_ctq,
    SUM(IF(field22_code='EDUC',     pub_field_ctq, 0)) AS pub_field_EDUC_ctq,
    SUM(IF(field22_code='ENG',      pub_field_ctq, 0)) AS pub_field_ENG_ctq,
    SUM(IF(field22_code='ENV',      pub_field_ctq, 0)) AS pub_field_ENV_ctq,
    SUM(IF(field22_code='HEALTH',   pub_field_ctq, 0)) AS pub_field_HEALTH_ctq,
    SUM(IF(field22_code='HISTORY',  pub_field_ctq, 0)) AS pub_field_HISTORY_ctq,
    SUM(IF(field22_code='SOCIETY',  pub_field_ctq, 0)) AS pub_field_SOCIETY_ctq,
    SUM(IF(field22_code='INFOCOMP', pub_field_ctq, 0)) AS pub_field_INFOCOMP_ctq,
    SUM(IF(field22_code='LANGUAGE', pub_field_ctq, 0)) AS pub_field_LANGUAGE_ctq,
    SUM(IF(field22_code='LAW',      pub_field_ctq, 0)) AS pub_field_LAW_ctq,
    SUM(IF(field22_code='MATH',     pub_field_ctq, 0)) AS pub_field_MATH_ctq,
    SUM(IF(field22_code='PHIL',     pub_field_ctq, 0)) AS pub_field_PHIL_ctq,
    SUM(IF(field22_code='PHYSICAL', pub_field_ctq, 0)) AS pub_field_PHYSICAL_ctq,
    SUM(IF(field22_code='PSYCH',    pub_field_ctq, 0)) AS pub_field_PSYCH_ctq,

    -- 22 fields: top5 within field
    SUM(IF(field22_code='AGRI',     pub_field_top5_ctq, 0)) AS pub_field_AGRI_top5_ctq,
    SUM(IF(field22_code='BIO',      pub_field_top5_ctq, 0)) AS pub_field_BIO_top5_ctq,
    SUM(IF(field22_code='BIOMED',   pub_field_top5_ctq, 0)) AS pub_field_BIOMED_top5_ctq,
    SUM(IF(field22_code='BUILT',    pub_field_top5_ctq, 0)) AS pub_field_BUILT_top5_ctq,
    SUM(IF(field22_code='CHEM',     pub_field_top5_ctq, 0)) AS pub_field_CHEM_top5_ctq,
    SUM(IF(field22_code='COMMERCE', pub_field_top5_ctq, 0)) AS pub_field_COMMERCE_top5_ctq,
    SUM(IF(field22_code='CREATIVE', pub_field_top5_ctq, 0)) AS pub_field_CREATIVE_top5_ctq,
    SUM(IF(field22_code='EARTH',    pub_field_top5_ctq, 0)) AS pub_field_EARTH_top5_ctq,
    SUM(IF(field22_code='ECON',     pub_field_top5_ctq, 0)) AS pub_field_ECON_top5_ctq,
    SUM(IF(field22_code='EDUC',     pub_field_top5_ctq, 0)) AS pub_field_EDUC_top5_ctq,
    SUM(IF(field22_code='ENG',      pub_field_top5_ctq, 0)) AS pub_field_ENG_top5_ctq,
    SUM(IF(field22_code='ENV',      pub_field_top5_ctq, 0)) AS pub_field_ENV_top5_ctq,
    SUM(IF(field22_code='HEALTH',   pub_field_top5_ctq, 0)) AS pub_field_HEALTH_top5_ctq,
    SUM(IF(field22_code='HISTORY',  pub_field_top5_ctq, 0)) AS pub_field_HISTORY_top5_ctq,
    SUM(IF(field22_code='SOCIETY',  pub_field_top5_ctq, 0)) AS pub_field_SOCIETY_top5_ctq,
    SUM(IF(field22_code='INFOCOMP', pub_field_top5_ctq, 0)) AS pub_field_INFOCOMP_top5_ctq,
    SUM(IF(field22_code='LANGUAGE', pub_field_top5_ctq, 0)) AS pub_field_LANGUAGE_top5_ctq,
    SUM(IF(field22_code='LAW',      pub_field_top5_ctq, 0)) AS pub_field_LAW_top5_ctq,
    SUM(IF(field22_code='MATH',     pub_field_top5_ctq, 0)) AS pub_field_MATH_top5_ctq,
    SUM(IF(field22_code='PHIL',     pub_field_top5_ctq, 0)) AS pub_field_PHIL_top5_ctq,
    SUM(IF(field22_code='PHYSICAL', pub_field_top5_ctq, 0)) AS pub_field_PHYSICAL_top5_ctq,
    SUM(IF(field22_code='PSYCH',    pub_field_top5_ctq, 0)) AS pub_field_PSYCH_top5_ctq

  FROM field_long
  GROUP BY country_code, quarter
),

disc_pivot AS (
  SELECT
    country_code,
    quarter,

    SUM(IF(disc6_code='LIFE',    pub_disc_ctq, 0)) AS pub_disc_LIFE_ctq,
    SUM(IF(disc6_code='PHYS',    pub_disc_ctq, 0)) AS pub_disc_PHYS_ctq,
    SUM(IF(disc6_code='ENGTECH', pub_disc_ctq, 0)) AS pub_disc_ENGTECH_ctq,
    SUM(IF(disc6_code='SOCSCI',  pub_disc_ctq, 0)) AS pub_disc_SOCSCI_ctq,
    SUM(IF(disc6_code='HUMARTS', pub_disc_ctq, 0)) AS pub_disc_HUMARTS_ctq,

    SUM(IF(disc6_code='LIFE',    pub_disc_top5_ctq, 0)) AS pub_disc_LIFE_top5_ctq,
    SUM(IF(disc6_code='PHYS',    pub_disc_top5_ctq, 0)) AS pub_disc_PHYS_top5_ctq,
    SUM(IF(disc6_code='ENGTECH', pub_disc_top5_ctq, 0)) AS pub_disc_ENGTECH_top5_ctq,
    SUM(IF(disc6_code='SOCSCI',  pub_disc_top5_ctq, 0)) AS pub_disc_SOCSCI_top5_ctq,
    SUM(IF(disc6_code='HUMARTS', pub_disc_top5_ctq, 0)) AS pub_disc_HUMARTS_top5_ctq

  FROM disc_long
  GROUP BY country_code, quarter
)

SELECT
  o.*,
  fp.* EXCEPT(country_code, quarter),
  dp.* EXCEPT(country_code, quarter)
FROM overall o
LEFT JOIN field_pivot fp USING (country_code, quarter)
LEFT JOIN disc_pivot dp USING (country_code, quarter)
