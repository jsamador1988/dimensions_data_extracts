config {
  type: "table",
  name: "pub2_country_quarter_field22_surico4",
  schema: "rd_mart",
  tags: ["mart", "phase4", "pub2"],
  description: "Country×quarter×field22 publications: totals + Surico-4 split using Option-2 ownership and gov_funded_flag."
}

WITH field22_dim AS (
  SELECT
    field22_code,
    ANY_VALUE(field22_name) AS field22_name
  FROM ${ref("rd_ref", "for4_to_field22")}
  WHERE field22_code IS NOT NULL
  GROUP BY field22_code
),

grid AS (
  SELECT
    g.country_code,
    g.quarter,
    d.field22_code,
    d.field22_name
  FROM ${ref("quarter_grid")} g
  CROSS JOIN field22_dim d
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,
    fw.field22_code,

    (cf.w_aff * fw.w_field) AS w_total_f22,
    (cf.w_public_prod * fw.w_field) AS w_owned_f22,
    (cf.w_private_prod * fw.w_field) AS w_private_f22,
    (cf.w_unclassified * fw.w_field) AS w_unclassified_f22,

    cf.gov_funded_flag
  FROM ${ref("pub2_country_flags")} cf
  JOIN ${ref("pub_field_weights")} fw
    ON fw.pub_id = cf.pub_id
   AND fw.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    field22_code,

    SUM(w_total_f22) AS total_eng,
    SUM(w_owned_f22) AS owned_eng,
    SUM(IF(gov_funded_flag, w_total_f22, 0)) AS funded_any_eng,

    SUM(IF(gov_funded_flag, w_private_f22, 0)) AS funded_private_owned_eng,
    SUM(IF(NOT gov_funded_flag, w_private_f22, 0)) AS private_private_eng,
    SUM(w_unclassified_f22) AS unclassified_eng
  FROM base
  GROUP BY country_code, quarter, field22_code
)

SELECT
  gr.country_code,
  gr.quarter,
  gr.field22_code,
  gr.field22_name,

  COALESCE(a.total_eng, 0) AS total_eng,
  COALESCE(a.owned_eng, 0) AS owned_eng,
  COALESCE(a.funded_any_eng, 0) AS funded_any_eng,
  COALESCE(a.funded_private_owned_eng, 0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0) AS unclassified_eng
FROM grid gr
LEFT JOIN agg a
  ON a.country_code = gr.country_code
 AND a.quarter = gr.quarter
 AND a.field22_code = gr.field22_code
ORDER BY gr.country_code, gr.quarter, gr.field22_code
