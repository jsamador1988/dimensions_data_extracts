config {
  type: "table",
  schema: "rd_mart",
  tags: ["pub2", "mart", "publications"],
  description: "Country×quarter×field22 Surico-4 decomposition for publications (Option-2 ownership buckets)."
}

WITH field22_list AS (
  SELECT DISTINCT field22_code, field22_name
  FROM ${ref("for_to_field22")}
),

grid AS (
  SELECT
    g.country_code,
    g.quarter,
    f.field22_code,
    f.field22_name
  FROM ${ref("quarter_grid")} g
  CROSS JOIN field22_list f
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,
    fw.field22_code,

    (cf.w_total        * fw.w_field22) AS w_total_f22,
    (cf.w_owned        * fw.w_field22) AS w_owned_f22,
    (cf.w_private      * fw.w_field22) AS w_private_f22,
    (cf.w_unclassified * fw.w_field22) AS w_unclassified_f22,

    cf.gov_funded_flag AS gov_funded_flag
  FROM ${ref("pub2_country_flags")} cf
  JOIN ${ref("pub_field_weights")} fw
    ON fw.pub_id = cf.pub_id
   AND fw.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    field22_code,

    SUM(w_total_f22) AS total_eng,
    SUM(w_owned_f22) AS owned_eng,

    SUM(IF(gov_funded_flag, w_total_f22, 0)) AS funded_any_eng,

    SUM(IF(gov_funded_flag, w_private_f22, 0)) AS funded_private_owned_eng,
    SUM(IF(NOT gov_funded_flag, w_private_f22, 0)) AS private_private_eng,
    SUM(w_unclassified_f22) AS unclassified_eng
  FROM base
  GROUP BY country_code, quarter, field22_code
)

SELECT
  gr.country_code,
  gr.quarter,
  gr.field22_code,
  gr.field22_name,

  COALESCE(a.total_eng, 0) AS total_eng,
  COALESCE(a.owned_eng, 0) AS owned_eng,
  COALESCE(a.funded_any_eng, 0) AS funded_any_eng,
  COALESCE(a.funded_private_owned_eng, 0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0) AS unclassified_eng
FROM grid gr
LEFT JOIN agg a
  ON a.country_code = gr.country_code
 AND a.quarter = gr.quarter
 AND a.field22_code = gr.field22_code
ORDER BY country_code, quarter, field22_code
