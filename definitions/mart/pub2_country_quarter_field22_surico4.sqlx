config {
  type: "table",
  name: "pub2_country_quarter_field22_surico4",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter×field22 publication totals decomposed into Surico4. Field weights from rd_stage.pub_field_weights."
}

WITH field_dim AS (
  SELECT DISTINCT
    field22_code,
    field22_name
  FROM ${ref("rd_stage", "pub_fields_distinct")}
  WHERE field22_code IS NOT NULL
),

grid AS (
  SELECT
    qg.country_code,
    qg.quarter,
    fd.field22_code,
    fd.field22_name
  FROM ${ref("quarter_grid")} qg
  CROSS JOIN field_dim fd
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,
    fw.field22_code,

    (CAST(cf.w_aff AS FLOAT64) * fw.w_field) AS w_total,
    (CAST(cf.w_public_prod AS FLOAT64) * fw.w_field) AS w_owned,

    IF(cf.gov_funded_flag = 1, CAST(cf.w_private_prod AS FLOAT64) * fw.w_field, 0.0) AS w_funded_private_owned,
    IF(cf.gov_funded_flag = 0, CAST(cf.w_private_prod AS FLOAT64) * fw.w_field, 0.0) AS w_private_private,

    (GREATEST(0.0, CAST(cf.w_aff AS FLOAT64) - CAST(cf.w_public_prod AS FLOAT64) - CAST(cf.w_private_prod AS FLOAT64))
      * fw.w_field) AS w_unclassified

  FROM ${ref("rd_int", "pub2_country_flags")} cf
  JOIN ${ref("pub_field_weights")} fw
    ON fw.pub_id = cf.pub_id
   AND fw.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    SUM(w_total) AS total_eng,
    SUM(w_owned) AS owned_eng,
    SUM(w_funded_private_owned) AS funded_private_owned_eng,
    SUM(w_private_private) AS private_private_eng,
    SUM(w_unclassified) AS unclassified_eng
  FROM base
  GROUP BY country_code, quarter, field22_code
)

SELECT
  g.country_code,
  g.quarter,
  g.field22_code,
  g.field22_name,
  COALESCE(a.total_eng, 0.0) AS total_eng,
  COALESCE(a.owned_eng, 0.0) AS owned_eng,
  COALESCE(a.funded_private_owned_eng, 0.0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0.0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0.0) AS unclassified_eng
FROM grid g
LEFT JOIN agg a
  ON a.country_code = g.country_code
 AND a.quarter = g.quarter
 AND a.field22_code = g.field22_code
ORDER BY country_code, quarter, field22_code
