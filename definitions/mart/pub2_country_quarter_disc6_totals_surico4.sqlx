config {
  type: "table",
  name: "pub2_country_quarter_disc6_totals_surico4",
  schema: "rd_mart",
  tags: ["mart"],
  description: "Country×quarter×disc6 publication totals decomposed into Surico4. Disc weights from rd_stage.pub_disc_weights."
}

WITH disc_dim AS (
  SELECT DISTINCT
    disc6_code,
    disc6_name
  FROM ${ref("rd_stage", "pub_fields_distinct")}
  WHERE disc6_code IS NOT NULL
),

grid AS (
  SELECT
    qg.country_code,
    qg.quarter,
    dd.disc6_code,
    dd.disc6_name
  FROM ${ref("quarter_grid")} qg
  CROSS JOIN disc_dim dd
),

base AS (
  SELECT
    cf.country_code,
    cf.quarter,
    dw.disc6_code,

    (CAST(cf.w_aff AS FLOAT64) * dw.w_disc) AS w_total,
    (CAST(cf.w_public_prod AS FLOAT64) * dw.w_disc) AS w_owned,

    IF(cf.gov_funded_flag = 1, CAST(cf.w_private_prod AS FLOAT64) * dw.w_disc, 0.0) AS w_funded_private_owned,
    IF(cf.gov_funded_flag = 0, CAST(cf.w_private_prod AS FLOAT64) * dw.w_disc, 0.0) AS w_private_private,

    (GREATEST(0.0, CAST(cf.w_aff AS FLOAT64) - CAST(cf.w_public_prod AS FLOAT64) - CAST(cf.w_private_prod AS FLOAT64))
      * dw.w_disc) AS w_unclassified

  FROM ${ref("rd_int", "pub2_country_flags")} cf
  JOIN ${ref("rd_stage", "pub_disc_weights")} dw
    ON dw.pub_id = cf.pub_id
   AND dw.quarter = cf.quarter
),

agg AS (
  SELECT
    country_code,
    quarter,
    disc6_code,
    SUM(w_total) AS total_eng,
    SUM(w_owned) AS owned_eng,
    SUM(w_funded_private_owned) AS funded_private_owned_eng,
    SUM(w_private_private) AS private_private_eng,
    SUM(w_unclassified) AS unclassified_eng
  FROM base
  GROUP BY country_code, quarter, disc6_code
)

SELECT
  g.country_code,
  g.quarter,
  g.disc6_code,
  g.disc6_name,
  COALESCE(a.total_eng, 0.0) AS total_eng,
  COALESCE(a.owned_eng, 0.0) AS owned_eng,
  COALESCE(a.funded_private_owned_eng, 0.0) AS funded_private_owned_eng,
  COALESCE(a.private_private_eng, 0.0) AS private_private_eng,
  COALESCE(a.unclassified_eng, 0.0) AS unclassified_eng
FROM grid g
LEFT JOIN agg a
  ON a.country_code = g.country_code
 AND a.quarter = g.quarter
 AND a.disc6_code = g.disc6_code
ORDER BY country_code, quarter, disc6_code
