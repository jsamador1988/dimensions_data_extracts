config {
  type: "table",
  name: "field22_to_disc6",
  schema: "rd_ref",
  tags: ["ref"],
  description: "Map 22 field codes -> 6 discipline codes. Includes both field22_code and field22 for compatibility."
}

-- Disciplines (6): STEM_LIFE, STEM_PHYSENG, STEM_MATHCOMP, SOCSCI, HUMANITIES, ARTS
SELECT 'AGRICULTURE'  AS field22_code, 'AGRICULTURE'  AS field22, 'STEM_LIFE'     AS disc6_code, 'STEM_LIFE'     AS disc6, 'STEM: Life/Health/Environment' AS disc6_name UNION ALL
SELECT 'BIOLOGY',        'BIOLOGY',        'STEM_LIFE',     'STEM_LIFE',     'STEM: Life/Health/Environment' UNION ALL
SELECT 'BIOMEDICAL',     'BIOMEDICAL',     'STEM_LIFE',     'STEM_LIFE',     'STEM: Life/Health/Environment' UNION ALL
SELECT 'HEALTH',         'HEALTH',         'STEM_LIFE',     'STEM_LIFE',     'STEM: Life/Health/Environment' UNION ALL
SELECT 'ENVIRONMENT',    'ENVIRONMENT',    'STEM_LIFE',     'STEM_LIFE',     'STEM: Life/Health/Environment' UNION ALL

SELECT 'PHYSICAL',       'PHYSICAL',       'STEM_PHYSENG',  'STEM_PHYSENG',  'STEM: Physical/Chemical/Engineering' UNION ALL
SELECT 'CHEMICAL',       'CHEMICAL',       'STEM_PHYSENG',  'STEM_PHYSENG',  'STEM: Physical/Chemical/Engineering' UNION ALL
SELECT 'ENGINEERING',    'ENGINEERING',    'STEM_PHYSENG',  'STEM_PHYSENG',  'STEM: Physical/Chemical/Engineering' UNION ALL
SELECT 'EARTH',          'EARTH',          'STEM_PHYSENG',  'STEM_PHYSENG',  'STEM: Physical/Chemical/Engineering' UNION ALL
SELECT 'BUILT_ENV',      'BUILT_ENV',      'STEM_PHYSENG',  'STEM_PHYSENG',  'STEM: Physical/Chemical/Engineering' UNION ALL

SELECT 'MATH',           'MATH',           'STEM_MATHCOMP', 'STEM_MATHCOMP', 'STEM: Math/Computing' UNION ALL
SELECT 'INFO_COMP',      'INFO_COMP',      'STEM_MATHCOMP', 'STEM_MATHCOMP', 'STEM: Math/Computing' UNION ALL

SELECT 'ECON',           'ECON',           'SOCSCI',        'SOCSCI',        'Social Sciences' UNION ALL
SELECT 'COMMERCE',       'COMMERCE',       'SOCSCI',        'SOCSCI',        'Social Sciences' UNION ALL
SELECT 'EDUCATION',      'EDUCATION',      'SOCSCI',        'SOCSCI',        'Social Sciences' UNION ALL
SELECT 'HUMAN_SOCIETY',  'HUMAN_SOCIETY',  'SOCSCI',        'SOCSCI',        'Social Sciences' UNION ALL
SELECT 'PSYCHOLOGY',     'PSYCHOLOGY',     'SOCSCI',        'SOCSCI',        'Social Sciences' UNION ALL
SELECT 'LAW',            'LAW',            'SOCSCI',        'SOCSCI',        'Social Sciences' UNION ALL

SELECT 'HISTORY',        'HISTORY',        'HUMANITIES',    'HUMANITIES',    'Humanities' UNION ALL
SELECT 'LANGUAGE',       'LANGUAGE',       'HUMANITIES',    'HUMANITIES',    'Humanities' UNION ALL
SELECT 'PHILOSOPHY',     'PHILOSOPHY',     'HUMANITIES',    'HUMANITIES',    'Humanities' UNION ALL

SELECT 'CREATIVE',       'CREATIVE',       'ARTS',          'ARTS',          'Arts & Creative'
