config {
  type: "table",
  name: "field22_to_disc6",
  schema: "rd_ref",
  tags: ["stage", "ref"],
  description: "Mapping from 22 broad fields (field22_code) to 6 discipline buckets (disc6_code)."
}

WITH m AS (
  SELECT 'AGRI'     AS field22_code, 'DISC1' AS disc6_code, 'Life & Health'                 AS disc6_name UNION ALL
  SELECT 'BIO'      AS field22_code, 'DISC1' AS disc6_code, 'Life & Health'                 AS disc6_name UNION ALL
  SELECT 'BIOMED'   AS field22_code, 'DISC1' AS disc6_code, 'Life & Health'                 AS disc6_name UNION ALL
  SELECT 'HEALTH'   AS field22_code, 'DISC1' AS disc6_code, 'Life & Health'                 AS disc6_name UNION ALL
  SELECT 'PSYCH'    AS field22_code, 'DISC1' AS disc6_code, 'Life & Health'                 AS disc6_name UNION ALL

  SELECT 'CHEM'     AS field22_code, 'DISC2' AS disc6_code, 'Physical, Math & Engineering'  AS disc6_name UNION ALL
  SELECT 'ENG'      AS field22_code, 'DISC2' AS disc6_code, 'Physical, Math & Engineering'  AS disc6_name UNION ALL
  SELECT 'MATH'     AS field22_code, 'DISC2' AS disc6_code, 'Physical, Math & Engineering'  AS disc6_name UNION ALL
  SELECT 'PHYSICAL' AS field22_code, 'DISC2' AS disc6_code, 'Physical, Math & Engineering'  AS disc6_name UNION ALL

  SELECT 'EARTH'    AS field22_code, 'DISC3' AS disc6_code, 'Earth & Environment'           AS disc6_name UNION ALL
  SELECT 'ENV'      AS field22_code, 'DISC3' AS disc6_code, 'Earth & Environment'           AS disc6_name UNION ALL

  SELECT 'ECON'     AS field22_code, 'DISC4' AS disc6_code, 'Social Sciences'               AS disc6_name UNION ALL
  SELECT 'EDUC'     AS field22_code, 'DISC4' AS disc6_code, 'Social Sciences'               AS disc6_name UNION ALL
  SELECT 'COMMERCE' AS field22_code, 'DISC4' AS disc6_code, 'Social Sciences'               AS disc6_name UNION ALL
  SELECT 'HUMAN'    AS field22_code, 'DISC4' AS disc6_code, 'Social Sciences'               AS disc6_name UNION ALL
  SELECT 'INFOCOMP' AS field22_code, 'DISC4' AS disc6_code, 'Social Sciences'               AS disc6_name UNION ALL

  SELECT 'HISTORY'  AS field22_code, 'DISC5' AS disc6_code, 'Arts & Humanities'             AS disc6_name UNION ALL
  SELECT 'LANG'     AS field22_code, 'DISC5' AS disc6_code, 'Arts & Humanities'             AS disc6_name UNION ALL
  SELECT 'LAW'      AS field22_code, 'DISC5' AS disc6_code, 'Arts & Humanities'             AS disc6_name UNION ALL
  SELECT 'PHIL'     AS field22_code, 'DISC5' AS disc6_code, 'Arts & Humanities'             AS disc6_name UNION ALL
  SELECT 'CREATIVE' AS field22_code, 'DISC5' AS disc6_code, 'Arts & Humanities'             AS disc6_name UNION ALL

  SELECT 'BUILT'    AS field22_code, 'DISC6' AS disc6_code, 'Built & Other'                 AS disc6_name
)

SELECT * FROM m
