config {
  type: "table",
  schema: "rd_ref",
  tags: ["ref"],
  description: "Map field22_code (22 fields) -> disc6_code (6 broad disciplines) used for aggregated series."
}

-- Disciplines (example):
-- LIFE     = life/biomed/health/ag/env
-- PHYS     = math/physical/chem/earth
-- ENGTECH  = engineering + built + computing
-- SOCSCI   = economics + education + commerce + society + psychology + law
-- HUMARTS  = history + language + philosophy + creative arts
-- OTHER    = spare bucket if you later add fields

SELECT 'AGRI'     AS field22_code, 'LIFE'    AS disc6_code, 'Life Sciences' AS disc6_name UNION ALL
SELECT 'BIO',                       'LIFE',                 'Life Sciences' UNION ALL
SELECT 'BIOMED',                    'LIFE',                 'Life Sciences' UNION ALL
SELECT 'HEALTH',                    'LIFE',                 'Life Sciences' UNION ALL
SELECT 'ENV',                       'LIFE',                 'Life Sciences' UNION ALL

SELECT 'MATH',                      'PHYS',                 'Physical Sciences' UNION ALL
SELECT 'PHYSICAL',                  'PHYS',                 'Physical Sciences' UNION ALL
SELECT 'CHEM',                      'PHYS',                 'Physical Sciences' UNION ALL
SELECT 'EARTH',                     'PHYS',                 'Physical Sciences' UNION ALL

SELECT 'ENG',                       'ENGTECH',              'Engineering & Technology' UNION ALL
SELECT 'BUILT',                     'ENGTECH',              'Engineering & Technology' UNION ALL
SELECT 'INFOCOMP',                  'ENGTECH',              'Engineering & Technology' UNION ALL

SELECT 'ECON',                      'SOCSCI',               'Social Sciences' UNION ALL
SELECT 'EDUC',                      'SOCSCI',               'Social Sciences' UNION ALL
SELECT 'COMMERCE',                  'SOCSCI',               'Social Sciences' UNION ALL
SELECT 'SOCIETY',                   'SOCSCI',               'Social Sciences' UNION ALL
SELECT 'PSYCH',                     'SOCSCI',               'Social Sciences' UNION ALL
SELECT 'LAW',                       'SOCSCI',               'Social Sciences' UNION ALL

SELECT 'HISTORY',                   'HUMARTS',              'Humanities & Arts' UNION ALL
SELECT 'LANGUAGE',                  'HUMARTS',              'Humanities & Arts' UNION ALL
SELECT 'PHIL',                      'HUMARTS',              'Humanities & Arts' UNION ALL
SELECT 'CREATIVE',                  'HUMARTS',              'Humanities & Arts'
