config {
  type: "table",
  schema: "rd_ref",
  tags: ["ref"],
  description: "EPC (EPO) membership start dates for use in time-varying domestic filing logic."
}

SELECT 'AT' AS country_code, DATE '1979-05-01' AS epo_start_date, CAST(NULL AS DATE) AS epo_end_date UNION ALL
SELECT 'BE', DATE '1977-10-07', CAST(NULL AS DATE) UNION ALL
SELECT 'CH', DATE '1977-10-07', CAST(NULL AS DATE) UNION ALL
SELECT 'DE', DATE '1977-10-07', CAST(NULL AS DATE) UNION ALL
SELECT 'DK', DATE '1990-01-01', CAST(NULL AS DATE) UNION ALL
SELECT 'ES', DATE '1986-10-01', CAST(NULL AS DATE) UNION ALL
SELECT 'FI', DATE '1996-03-01', CAST(NULL AS DATE) UNION ALL
SELECT 'FR', DATE '1977-10-07', CAST(NULL AS DATE) UNION ALL
SELECT 'GB', DATE '1977-10-07', CAST(NULL AS DATE) UNION ALL
SELECT 'IT', DATE '1978-12-01', CAST(NULL AS DATE) UNION ALL
SELECT 'NL', DATE '1977-10-07', CAST(NULL AS DATE) UNION ALL
SELECT 'SE', DATE '1978-05-01', CAST(NULL AS DATE)
