config {
  type: "table",
  schema: "rd_ref",
  name: "for_to_field22",
  tags: ["ref", "deprecated"],
  description: "DEPRECATED: legacy field list. Use rd_ref.field22_to_disc6 for the canonical Field-22 + Discipline-6 mapping (and rd_ref.for4_to_field22 for FoR4→Field22 mapping)."
}

SELECT
  field22_code,
  ANY_VALUE(field22_name) AS field22_name
FROM ${ref("rd_ref", "field22_to_disc6")}
GROUP BY field22_code
ORDER BY field22_code
