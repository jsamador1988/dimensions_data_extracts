config {
  type: "table",
  schema: "rd_ref",
  name: "whitelist_de",
  tags: ["ref", "deprecated"],
  description: "DEPRECATED: Use rd_ref.gov_org_whitelist (multi-country) instead. This view-like table is kept only to avoid breaking older SQLX that still joins on whitelist_de."
}

SELECT org_id
FROM ${ref("rd_ref", "gov_org_whitelist")}
WHERE country_code = 'DE'
