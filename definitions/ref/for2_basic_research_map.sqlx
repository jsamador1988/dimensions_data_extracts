config {
  type: "table",
  schema: "rd_ref",
  name: "for2_basic_research_map",
  tags: ["ref"],
  description: "Maps FoR 2020 2-digit divisions to basic vs applied research categories (Frascati-inspired). Divisions 31, 34, 37, 41, 49, 51 (natural/physical/life sciences) are classified as basic research; remaining divisions are applied. Uses ANZSRC 2020 codes (30-52), which is the classification system in Dimensions."
}

SELECT *
FROM UNNEST([
  STRUCT("30" AS for2_code, "Agricultural, Veterinary and Food Sciences" AS for2_name, FALSE AS is_basic_science),
  STRUCT("31", "Biological Sciences", TRUE),
  STRUCT("32", "Biomedical and Clinical Sciences", FALSE),
  STRUCT("33", "Built Environment and Design", FALSE),
  STRUCT("34", "Chemical Sciences", TRUE),
  STRUCT("35", "Commerce, Management, Tourism and Services", FALSE),
  STRUCT("36", "Creative Arts and Writing", FALSE),
  STRUCT("37", "Earth Sciences", TRUE),
  STRUCT("38", "Economics", FALSE),
  STRUCT("39", "Education", FALSE),
  STRUCT("40", "Engineering", FALSE),
  STRUCT("41", "Environmental Sciences", TRUE),
  STRUCT("42", "Health Sciences", FALSE),
  STRUCT("43", "History, Heritage and Archaeology", FALSE),
  STRUCT("44", "Human Society", FALSE),
  STRUCT("45", "Indigenous Studies", FALSE),
  STRUCT("46", "Information and Computing Sciences", FALSE),
  STRUCT("47", "Language, Communication and Culture", FALSE),
  STRUCT("48", "Law and Legal Studies", FALSE),
  STRUCT("49", "Mathematical Sciences", TRUE),
  STRUCT("50", "Philosophy and Religious Studies", FALSE),
  STRUCT("51", "Physical Sciences", TRUE),
  STRUCT("52", "Psychology", FALSE)
])
