config {
  type: "table",
  schema: "rd_ref",
  name: "org_gov_surico",
  description: "Organization government flag consistent with Surico: Government type OR country whitelist. Universities are NOT government unless explicitly whitelisted.",
  tags: ["ref", "phase3"]
}

WITH orgs AS (
  SELECT
    o.id AS org_id,
    o.name AS org_name,
    CASE WHEN o.legal_country_code = 'UK' THEN 'GB' ELSE o.legal_country_code END AS country_code,
    o.types
  FROM `dimensions-ai.data_analytics.organizations` o
),

wl AS (
  SELECT
    country_code,
    org_id,
    org_name AS whitelist_name,
    note,
    start_date,
    end_date
  FROM `dimensionsdataextracts.rd_ref.gov_org_whitelist`
)

SELECT
  o.org_id,
  o.org_name,
  o.country_code,

  -- Surico-consistent government flag:
  -- Government in types OR explicitly whitelisted (by domestic country)
  (
    'Government' IN UNNEST(IFNULL(o.types, []))
    OR EXISTS (
      SELECT 1
      FROM wl
      WHERE wl.country_code = o.country_code
        AND wl.org_id = o.org_id
        AND (wl.start_date IS NULL OR wl.start_date <= CURRENT_DATE())
        AND (wl.end_date IS NULL OR wl.end_date >= CURRENT_DATE())
    )
  ) AS is_gov_surico

FROM orgs o
WHERE o.org_id IS NOT NULL
