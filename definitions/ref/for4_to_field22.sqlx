config {
  type: "table",
  name: "for4_to_field22",
  schema: "rd_ref",
  tags: ["stage", "ref"],
  description: "FoR4 (4-digit) -> field22 mapping using FoR2 prefix (first 2 digits). Includes field22_name."
}

WITH for4_distinct AS (
  SELECT DISTINCT
    CAST(for4 AS STRING) AS for4
  FROM ${ref("rd_stage", "pub_core")} c
  CROSS JOIN UNNEST(IFNULL(c.for4_codes, [])) AS for4
  WHERE for4 IS NOT NULL
),

mapped AS (
  SELECT
    for4,
    CASE SUBSTR(for4, 1, 2)
      WHEN '30' THEN 'AGRI'
      WHEN '31' THEN 'BIO'
      WHEN '32' THEN 'BIOMED'
      WHEN '33' THEN 'BUILT'
      WHEN '34' THEN 'CHEM'
      WHEN '35' THEN 'COMMERCE'
      WHEN '36' THEN 'CREATIVE'
      WHEN '37' THEN 'EARTH'
      WHEN '38' THEN 'ECON'
      WHEN '39' THEN 'EDUC'
      WHEN '40' THEN 'ENG'
      WHEN '41' THEN 'ENV'
      WHEN '42' THEN 'HEALTH'
      WHEN '43' THEN 'HISTORY'
      WHEN '44' THEN 'HUMAN'
      WHEN '45' THEN 'HUMAN'
      WHEN '46' THEN 'INFOCOMP'
      WHEN '47' THEN 'LANG'
      WHEN '48' THEN 'LAW'
      WHEN '49' THEN 'MATH'
      WHEN '50' THEN 'PHIL'
      WHEN '51' THEN 'PHYSICAL'
      WHEN '52' THEN 'PSYCH'
      ELSE NULL
    END AS field22_code
  FROM for4_distinct
),

with_names AS (
  SELECT
    for4,
    field22_code,
    CASE field22_code
      WHEN 'AGRI'     THEN 'Agriculture'
      WHEN 'BIO'      THEN 'Biological Sciences'
      WHEN 'BIOMED'   THEN 'Biomedical Sciences'
      WHEN 'BUILT'    THEN 'Built Environment & Design'
      WHEN 'CHEM'     THEN 'Chemistry'
      WHEN 'COMMERCE' THEN 'Commerce, Management & Tourism'
      WHEN 'CREATIVE' THEN 'Creative Arts & Writing'
      WHEN 'EARTH'    THEN 'Earth Sciences'
      WHEN 'ECON'     THEN 'Economics'
      WHEN 'EDUC'     THEN 'Education'
      WHEN 'ENG'      THEN 'Engineering'
      WHEN 'ENV'      THEN 'Environmental Sciences'
      WHEN 'HEALTH'   THEN 'Health Sciences'
      WHEN 'HISTORY'  THEN 'History & Archaeology'
      WHEN 'HUMAN'    THEN 'Social & Human Sciences'
      WHEN 'INFOCOMP' THEN 'Information & Computing'
      WHEN 'LANG'     THEN 'Language & Communication'
      WHEN 'LAW'      THEN 'Law'
      WHEN 'MATH'     THEN 'Mathematics'
      WHEN 'PHIL'     THEN 'Philosophy & Religion'
      WHEN 'PHYSICAL' THEN 'Physical Sciences'
      WHEN 'PSYCH'    THEN 'Psychology'
      ELSE NULL
    END AS field22_name
  FROM mapped
)

SELECT
  for4,
  field22_code,
  field22_name
FROM with_names
WHERE field22_code IS NOT NULL
