config {
  type: "table",
  schema: "rd_ref",
  tags: ["ref"],
  description: "FOR 4-digit code -> field22_code/field22_name via 2-digit division mapping. Generated programmatically (0000..9999)."
}

WITH all_for4 AS (
  SELECT
    LPAD(CAST(n AS STRING), 4, '0') AS for4,
    SAFE_CAST(SUBSTR(LPAD(CAST(n AS STRING), 4, '0'), 1, 2) AS INT64) AS for_division
  FROM UNNEST(GENERATE_ARRAY(0, 9999)) AS n
)
SELECT
  a.for4,
  m.field22_code,
  m.field22_name
FROM all_for4 a
JOIN ${ref("for_to_field_22")} m
  ON m.for_division = a.for_division
