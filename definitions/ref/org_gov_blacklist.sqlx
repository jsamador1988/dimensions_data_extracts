config {
  type: "table",
  schema: "rd_ref",
  name: "org_gov_blacklist",
  tags: ["ref"],
  description: "Intergovernmental organizations that should NOT be classified as domestic government for any country. These are supranational bodies (EU institutions, UN agencies, international financial institutions) typed Government in Dimensions but not representing any single nation's government research. Each entry includes a justification URL. 45 entries as of 2026-04-02."
}

SELECT *
FROM (
  SELECT 'grid.1098717.31' AS org_id, 'European Atomic Energy Community Euratom' AS org_name, 'BE' AS host_country,
         'EU nuclear energy community established by Treaty of Rome 1957, intergovernmental. https://en.wikipedia.org/wiki/Euratom' AS blacklist_reason
  UNION ALL
  SELECT 'grid.455279.8' AS org_id, 'European Commission' AS org_name, 'BE' AS host_country,
         'EU executive body (Treaty on European Union), not domestic government of any member state. https://en.wikipedia.org/wiki/European_Commission' AS blacklist_reason
  UNION ALL
