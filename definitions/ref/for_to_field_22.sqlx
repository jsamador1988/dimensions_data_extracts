config {
  type: "table",
  schema: "rd_ref",
  name: "for_to_field_22",
  tags: ["ref", "deprecated"],
  description: "DEPRECATED: legacy mapping table. Use rd_ref.field22_to_disc6 (Field22→Disc6) and rd_ref.for4_to_field22 (FoR4→Field22)."
}

SELECT
  field22_code,
  field22_name,
  disc6_code,
  disc6_name
FROM ${ref("rd_ref", "field22_to_disc6")}
ORDER BY field22_code
