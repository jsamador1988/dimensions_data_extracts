config {
  type: "table",
  schema: "rd_ref",
  name: "nagaraj_yao_region_map",
  tags: ["ref", "regions"],
  description: "Nagaraj & Yao (NBER w34694, 2026) five-region classification. Regions stored: US, EU, REST_HI, CHINA. REST_OF_WORLD is NOT stored - computed downstream as world_total minus sum of the four explicit regions. EU = EU-27 + UK + EFTA intersected with panel universe (time-invariant, following N-Y's practice of keeping membership stable across the 1980-2022 window). Unassigned panel members (MX, TR, CO, CR) flow into the residual."
}

WITH region_map AS (
  SELECT * FROM UNNEST([
    -- US
    STRUCT('US' AS country_code, 'US'      AS ny_region),
    -- China
    STRUCT('CN' AS country_code, 'CHINA'   AS ny_region),
    -- Rest High-Income (non-US, non-EU, non-China high-income economies in our panel)
    STRUCT('JP' AS country_code, 'REST_HI' AS ny_region),
    STRUCT('KR' AS country_code, 'REST_HI' AS ny_region),
    STRUCT('CA' AS country_code, 'REST_HI' AS ny_region),
    STRUCT('AU' AS country_code, 'REST_HI' AS ny_region),
    STRUCT('IL' AS country_code, 'REST_HI' AS ny_region),
    STRUCT('NZ' AS country_code, 'REST_HI' AS ny_region),
    STRUCT('CL' AS country_code, 'REST_HI' AS ny_region),
    -- European Union (EU-27 + UK + EFTA), panel intersection
    STRUCT('AT' AS country_code, 'EU' AS ny_region),
    STRUCT('BE' AS country_code, 'EU' AS ny_region),
    STRUCT('CH' AS country_code, 'EU' AS ny_region),
    STRUCT('CZ' AS country_code, 'EU' AS ny_region),
    STRUCT('DE' AS country_code, 'EU' AS ny_region),
    STRUCT('DK' AS country_code, 'EU' AS ny_region),
    STRUCT('EE' AS country_code, 'EU' AS ny_region),
    STRUCT('ES' AS country_code, 'EU' AS ny_region),
    STRUCT('FI' AS country_code, 'EU' AS ny_region),
    STRUCT('FR' AS country_code, 'EU' AS ny_region),
    STRUCT('GB' AS country_code, 'EU' AS ny_region),
    STRUCT('GR' AS country_code, 'EU' AS ny_region),
    STRUCT('HU' AS country_code, 'EU' AS ny_region),
    STRUCT('IE' AS country_code, 'EU' AS ny_region),
    STRUCT('IS' AS country_code, 'EU' AS ny_region),
    STRUCT('IT' AS country_code, 'EU' AS ny_region),
    STRUCT('LT' AS country_code, 'EU' AS ny_region),
    STRUCT('LU' AS country_code, 'EU' AS ny_region),
    STRUCT('LV' AS country_code, 'EU' AS ny_region),
    STRUCT('NL' AS country_code, 'EU' AS ny_region),
    STRUCT('NO' AS country_code, 'EU' AS ny_region),
    STRUCT('PL' AS country_code, 'EU' AS ny_region),
    STRUCT('PT' AS country_code, 'EU' AS ny_region),
    STRUCT('SE' AS country_code, 'EU' AS ny_region),
    STRUCT('SI' AS country_code, 'EU' AS ny_region),
    STRUCT('SK' AS country_code, 'EU' AS ny_region)
  ])
)

SELECT country_code, ny_region
FROM region_map
