config {
  type: "table",
  schema: "rd_ref",
  name: "analysis_country_map",
  tags: ["ref", "analysis"],
  description: "Analysis country mapping (ISO2 to display name) used by the pipeline without requiring external benchmark inputs."
}

SELECT *
FROM UNNEST([
  STRUCT("AU" AS country_code, "Australia" AS country_name),
  STRUCT("AT", "Austria"),
  STRUCT("BE", "Belgium"),
  STRUCT("CA", "Canada"),
  STRUCT("CL", "Chile"),
  STRUCT("CO", "Colombia"),
  STRUCT("CR", "Costa Rica"),
  STRUCT("CZ", "Czechia"),
  STRUCT("DK", "Denmark"),
  STRUCT("EE", "Estonia"),
  STRUCT("FI", "Finland"),
  STRUCT("FR", "France"),
  STRUCT("DE", "Germany"),
  STRUCT("GR", "Greece"),
  STRUCT("HU", "Hungary"),
  STRUCT("IS", "Iceland"),
  STRUCT("IE", "Ireland"),
  STRUCT("IL", "Israel"),
  STRUCT("IT", "Italy"),
  STRUCT("JP", "Japan"),
  STRUCT("KR", "Korea"),
  STRUCT("LV", "Latvia"),
  STRUCT("LT", "Lithuania"),
  STRUCT("LU", "Luxembourg"),
  STRUCT("MX", "Mexico"),
  STRUCT("NL", "Netherlands"),
  STRUCT("NZ", "New Zealand"),
  STRUCT("NO", "Norway"),
  STRUCT("PL", "Poland"),
  STRUCT("PT", "Portugal"),
  STRUCT("SK", "Slovakia"),
  STRUCT("SI", "Slovenia"),
  STRUCT("ES", "Spain"),
  STRUCT("SE", "Sweden"),
  STRUCT("CH", "Switzerland"),
  STRUCT("TR", "Turkiye"),
  STRUCT("GB", "United Kingdom"),
  STRUCT("US", "United States")
])
