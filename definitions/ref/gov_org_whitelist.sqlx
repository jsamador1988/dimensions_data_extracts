UNION ALL
SELECT 'NL', 'grid.7861.8', 'Energy Research Centre of the Netherlands (ECN)',
       'Netherlands: national energy research centre (merged into TNO 2018); Facility in Dimensions; 261 patent families. Batch 2 audit.',
