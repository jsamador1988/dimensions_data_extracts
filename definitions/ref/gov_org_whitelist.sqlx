-- === CA: Batch 1 whitelist expansion (2026-03-08) ===
-- FRQ-NT is typed Nonprofit while sister agencies FRQ-Santé and FRQ-SC are Government.
-- CFI and Genome Canada are federally created/funded agencies typed Nonprofit.
UNION ALL
SELECT 'CA', 'grid.453081.b', 'Fonds de Recherche du Québec - Nature et Technologies (FRQ-NT)',
       'Canada: Quebec provincial research funding agency; Nonprofit in Dimensions but sister FRQ agencies are Government; 7,627 grants, $416M. Batch 1 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'CA', 'grid.439998.6', 'Canada Foundation for Innovation (CFI)',
       'Canada: federally created research infrastructure funder; Nonprofit in Dimensions; 9,307 grants, $4.4B. Batch 1 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'CA', 'grid.440163.4', 'Genome Canada',
       'Canada: federally created genomics research funder; Nonprofit in Dimensions; 365 grants, $904M. Batch 1 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)

-- === CH: Tier 1 investigation (2026-03-09) ===
-- Switzerland's four federal research institutes under the ETH Domain (Board of
-- Swiss Federal Institutes of Technology, grid.451538.e) are all typed Facility
-- or Education. PSI and Empa have significant patent portfolios.
UNION ALL
SELECT 'CH', 'grid.5991.4', 'Paul Scherrer Institute (PSI)',
       'Switzerland: federal research institute under ETH Board; Facility in Dimensions; 207 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'CH', 'grid.7354.5', 'Swiss Federal Laboratories for Materials Science and Technology (Empa)',
       'Switzerland: federal research lab under ETH Board; Education in Dimensions; 166 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'CH', 'grid.419754.a', 'Swiss Federal Institute for Forest, Snow and Landscape Research (WSL)',
       'Switzerland: federal research institute under ETH Board; Facility in Dimensions; 4 patent families. Tier 1 investigation.',
