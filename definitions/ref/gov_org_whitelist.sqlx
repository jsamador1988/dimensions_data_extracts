-- === AU: Batch 1 whitelist expansion (2026-03-08) ===
-- CSIRO umbrella (grid.1016.6) is already Government, but sub-divisions have separate org_ids typed Facility.
-- AIMS is a Commonwealth statutory authority typed Facility.
UNION ALL
SELECT 'AU', 'grid.469914.7', 'CSIRO Land and Water',
       'Australia: CSIRO division; Facility in Dimensions; 3,227 pubs. Batch 1 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'AU', 'grid.417653.2', 'CSIRO Ecosystem Sciences',
       'Australia: CSIRO division; Facility in Dimensions; 2,910 pubs. Batch 1 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'AU', 'grid.1046.3', 'Australian Institute of Marine Science (AIMS)',
       'Australia: Commonwealth statutory authority; Facility in Dimensions; 2,030 pubs. Batch 1 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'AU', 'grid.492990.f', 'CSIRO Oceans and Atmosphere',
       'Australia: CSIRO division; Facility in Dimensions; 1,985 pubs. Batch 1 audit.',
