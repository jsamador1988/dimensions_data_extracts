-- INFN umbrella (grid.6045.7) is already Government, but 12 individual sections are typed Facility.
-- Same pattern as Germany's research society institutes.
UNION ALL
SELECT 'IT', 'grid.5326.2', 'Consiglio Nazionale delle Ricerche (CNR)',
