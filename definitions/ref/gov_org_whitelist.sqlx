config {
  type: "table",
  schema: "rd_ref",
  name: "gov_org_whitelist",
  tags: ["ref"],
  description: "Manual whitelist of organizations that should be treated as Surico-government even if their Dimensions org types are incomplete. Use this to patch known cases (e.g., Germany's DFG). Columns: country_code, org_id, org_name, note, start_date, end_date."
}

SELECT 'DE' AS country_code, 'grid.424150.6' AS org_id, 'Deutsche Forschungsgemeinschaft (DFG)' AS org_name,
       'Germany: national research funding agency (treat as government for Surico classification).' AS note,
       CAST(NULL AS DATE) AS start_date, CAST(NULL AS DATE) AS end_date
UNION ALL
SELECT 'DE', 'grid.453068.c', 'Arbeitsgemeinschaft industrieller Forschungsvereinigungen (AiF)',
       'Germany: AiF (treat as government for Surico classification).',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'DE', 'grid.453150.6', 'Deutsche Bundesstiftung Umwelt (DBU)',
       'Germany: DBU (treat as government for Surico classification).',
       CAST(NULL AS DATE), CAST(NULL AS DATE)

-- === JP: WS2 Phase 2B audit (2026-03-06) ===
-- JSPS is Japan's primary research funding council under MEXT.
-- Dimensions types it as Nonprofit; it is clearly government.
UNION ALL
SELECT 'JP', 'grid.54432.34', 'Japan Society for the Promotion of Science (JSPS)',
       'Japan: national research funding council under MEXT; 44,334 grants, $6.2B; Dimensions type=Nonprofit. WS2 Phase 2B audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
-- NEDO is Japan's national R&D agency under METI.
-- Dimensions types it as Education; it is clearly government.
UNION ALL
SELECT 'JP', 'grid.453049.f', 'New Energy and Industrial Technology Development Organization (NEDO)',
       'Japan: national R&D agency under METI; $906M in grants; Dimensions type=Education. WS2 Phase 2B audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
-- RIKEN is Japan's flagship national research institute.
-- Dimensions types it as Education; it is clearly government.
UNION ALL
SELECT 'JP', 'grid.7597.c', 'RIKEN',
       'Japan: national research institute; 1,626 patent families, 27,630 pubs; Dimensions type=Education. WS2 Phase 2B audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)

-- === DE: WS2 Phase 2B audit (2026-03-06) ===
-- Germany's four major publicly-funded research societies (Fraunhofer, Max Planck,
-- Helmholtz, Leibniz) have umbrella orgs that are mostly typed Government or Nonprofit,
-- but their individual institutes are typed Facility or Education and thus missed.
-- These 21 entries cover institutes with >=50 patent families (94.7% of the 9,124 missed families).
-- Max Planck Society umbrella (Nonprofit in Dimensions)
UNION ALL
SELECT 'DE', 'grid.4372.2', 'Max Planck Society',
       'Germany: Max Planck Society umbrella; Nonprofit in Dimensions; 2,307 patent families. WS2 Phase 2B audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
-- Fraunhofer individual institutes (umbrella grid.4561.6 is already Government)
UNION ALL
SELECT 'DE', 'grid.452493.d', 'Fraunhofer Institute for Biomedical Engineering (IBMT)',
       'Germany: Fraunhofer institute; Education in Dimensions; 2,620 patent families. WS2 Phase 2B audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'DE', 'grid.435231.2', 'Fraunhofer Institute for Telecommunications, Heinrich Hertz Institute',
