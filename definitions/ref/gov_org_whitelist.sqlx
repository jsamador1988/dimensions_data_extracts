-- === DK: Tier 1 investigation (2026-03-09) ===
-- Risø was Denmark's national nuclear/energy research lab (merged into DTU 2012).
-- Statens Serum Institut is the Danish state institute for infectious disease control.
UNION ALL
SELECT 'DK', 'grid.798877.e', 'Risø National Laboratory',
       'Denmark: national energy/nuclear research lab (merged into DTU 2012); Other in Dimensions; 104 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'DK', 'grid.6203.7', 'Statens Serum Institut',
       'Denmark: state institute for infectious disease; Facility in Dimensions; 92 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)

-- === FI: Tier 1 investigation (2026-03-09) ===
-- VTT is Finland's state-owned technical research center under Ministry of
-- Economic Affairs. 1,816 patent families — by far the largest misclassified
-- gov org among Tier 1 countries. Typed Nonprofit in Dimensions.
UNION ALL
SELECT 'FI', 'grid.6324.3', 'VTT Technical Research Centre of Finland',
       'Finland: state-owned technical research center under MEAE; Nonprofit in Dimensions; 1,816 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'FI', 'grid.434062.7', 'Finnish Geospatial Research Institute',
       'Finland: national geospatial institute under NLS; Facility in Dimensions; 6 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'FI', 'grid.6975.d', 'Finnish Institute of Occupational Health',
       'Finland: government occupational health institute; Facility in Dimensions; 2 patent families. Tier 1 investigation.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)

-- === NL: Batch 2 whitelist expansion (2026-03-09) ===
-- TNO is Netherlands Organisation for Applied Scientific Research, established
-- by law (TNO Act). Typed Company in Dimensions but is a public-law org.
-- ECN (Energy Research Centre) merged into TNO in 2018.
UNION ALL
SELECT 'NL', 'grid.4858.1', 'Nederlandse Organisatie voor Toegepast Natuurwetenschappelijk Onderzoek (TNO)',
       'Netherlands: public-law applied research org (TNO Act); Company in Dimensions; 2,083 patent families. Batch 2 audit.',
       CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'NL', 'grid.796792.4', 'TNO Institute of Industrial Technology',
       'Netherlands: TNO subsidiary; Company in Dimensions; 183 patent families. Batch 2 audit.',
