config {
  type: "assertion",
  schema: "rd_assert",
  name: "assert_uni_bounds",
  tags: ["assert"],
  description: "Validates monotone inclusion bounds for university and science linkage variables. All set-inclusion relationships must hold: subsets <= supersets."
}

-- Returns rows that violate the monotone bounds (should be empty).
-- Tolerance of 0.001 for floating-point rounding.

WITH p AS (
  SELECT * FROM ${ref("rd_mart", "panel_country_quarter_wide")}
)

-- University bounds
SELECT country_code, quarter, 'pat_uni_total > pat_total' AS violation
FROM p WHERE pat_uni_total_ctq > pat_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_govfund > pat_uni_total'
FROM p WHERE pat_uni_govfund_ctq > pat_uni_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pub_uni_total > pub_total'
FROM p WHERE pub_uni_total_ctq > pub_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pub_uni_basic > pub_uni_total'
FROM p WHERE pub_uni_basic_ctq > pub_uni_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pub_uni_govfund > pub_uni_total'
FROM p WHERE pub_uni_govfund_ctq > pub_uni_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pub_uni_basic_govfund > pub_uni_basic'
FROM p WHERE pub_uni_basic_govfund_ctq > pub_uni_basic_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pub_uni_basic_govfund > pub_uni_govfund'
FROM p WHERE pub_uni_basic_govfund_ctq > pub_uni_govfund_ctq + 0.001

-- Science linkage inclusion chain
UNION ALL
SELECT country_code, quarter, 'pat_citepub > pat_total'
FROM p WHERE pat_citepub_ctq > pat_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_citepub_basic > pat_citepub'
FROM p WHERE pat_citepub_basic_ctq > pat_citepub_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_citepub_govfund > pat_citepub'
FROM p WHERE pat_citepub_govfund_ctq > pat_citepub_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_citepub_govfund_basic > pat_citepub_govfund'
FROM p WHERE pat_citepub_govfund_basic_ctq > pat_citepub_govfund_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_citepub_govfund_basic > pat_citepub_basic'
FROM p WHERE pat_citepub_govfund_basic_ctq > pat_citepub_basic_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_citepub_uni > pat_citepub'
FROM p WHERE pat_citepub_uni_ctq > pat_citepub_ctq + 0.001

-- Cross-combination bounds
UNION ALL
SELECT country_code, quarter, 'pat_uni_citepub > pat_uni_total'
FROM p WHERE pat_uni_citepub_ctq > pat_uni_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_citepub > pat_citepub'
FROM p WHERE pat_uni_citepub_ctq > pat_citepub_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_citepub_basic > pat_uni_citepub'
FROM p WHERE pat_uni_citepub_basic_ctq > pat_uni_citepub_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_citepub_govfund_basic > pat_uni_citepub_basic'
FROM p WHERE pat_uni_citepub_govfund_basic_ctq > pat_uni_citepub_basic_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_basic > pat_uni_total'
FROM p WHERE pat_uni_basic_ctq > pat_uni_total_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_basic_govfund > pat_uni_basic'
FROM p WHERE pat_uni_basic_govfund_ctq > pat_uni_basic_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_uni_basic_govfund > pat_uni_govfund'
FROM p WHERE pat_uni_basic_govfund_ctq > pat_uni_govfund_ctq + 0.001

UNION ALL
SELECT country_code, quarter, 'pat_govfund_citepub > pat_govfund_any_excl'
FROM p WHERE pat_govfund_citepub_ctq > pat_govfund_any_excl_ctq + 0.001
