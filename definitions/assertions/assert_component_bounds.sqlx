config {
  type: "assertion",
  name: "assert_component_bounds",
  tags: ["assert", "assertion"],
  description: "Validates non-negative total counts and parent-child bounds for government-owned and private totals in the live apr_02 mart."
}

WITH p AS (
  SELECT * FROM ${ref("rd_mart", "panel_country_quarter_wide")}
)

SELECT 'pat_total_negative' AS series, country_code, quarter
FROM p
WHERE pat_total_ctq < -0.001

UNION ALL
SELECT 'pub_total_negative' AS series, country_code, quarter
FROM p
WHERE pub_total_ctq < -0.001

UNION ALL
SELECT 'pat_gov_owned_exceeds_total' AS series, country_code, quarter
FROM p
WHERE pat_gov_owned_ctq > pat_total_ctq + 0.01

UNION ALL
SELECT 'pub_gov_owned_exceeds_total' AS series, country_code, quarter
FROM p
WHERE pub_gov_owned_ctq > pub_total_ctq + 0.01

UNION ALL
SELECT 'pat_private_exceeds_total' AS series, country_code, quarter
FROM p
WHERE pat_private_total_ctq > pat_total_ctq + 0.01

UNION ALL
SELECT 'pub_private_exceeds_total' AS series, country_code, quarter
FROM p
WHERE pub_private_total_ctq > pub_total_ctq + 0.01
