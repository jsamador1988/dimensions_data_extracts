config {
  type: "assertion",
  schema: "dataform_assertions",
  name: "assert_citation_partition",
  tags: ["assertion"],
  description: "Verify binary citation decomposition: citing_gov + not_citing_gov = private_total (within tolerance). Checks at mart level where private_total comes from the measures table (full base), not the citation pipeline subset."
}

-- Patent citation partition: binary decomposition should sum to private total from measures
SELECT 'patent' AS doc_type, country_code, quarter,
  pat_private_citing_gov_ctq + pat_private_not_citing_gov_ctq AS sum_binary,
  pat_private_total_ctq AS expected,
  ABS(pat_private_citing_gov_ctq + pat_private_not_citing_gov_ctq - pat_private_total_ctq) AS diff
FROM ${ref("rd_mart", "panel_country_quarter_wide")}
WHERE ABS(pat_private_citing_gov_ctq + pat_private_not_citing_gov_ctq - pat_private_total_ctq) > 0.01
  AND pat_private_total_ctq > 0

UNION ALL

-- Publication citation partition: binary decomposition should sum to private total from measures
SELECT 'publication' AS doc_type, country_code, quarter,
  pub_private_citing_gov_ctq + pub_private_not_citing_gov_ctq AS sum_binary,
  pub_private_total_ctq AS expected,
  ABS(pub_private_citing_gov_ctq + pub_private_not_citing_gov_ctq - pub_private_total_ctq) AS diff
FROM ${ref("rd_mart", "panel_country_quarter_wide")}
WHERE ABS(pub_private_citing_gov_ctq + pub_private_not_citing_gov_ctq - pub_private_total_ctq) > 0.01
  AND pub_private_total_ctq > 0
