config {
  type: "assertion",
  schema: "dataform_assertions",
  name: "assert_whole_count_bounds",
  tags: ["assertion"],
  description: "Verify whole counts >= fractional counts (fractional weights <= 1 per item, so whole count of distinct items must be at least as large as the sum of fractional weights)."
}

SELECT 'pat_total' AS series, country_code, quarter
FROM ${ref("rd_mart", "panel_country_quarter_wide")}
WHERE pat_total_whole_ctq < pat_total_ctq - 0.001

UNION ALL
SELECT 'pub_total' AS series, country_code, quarter
FROM ${ref("rd_mart", "panel_country_quarter_wide")}
WHERE pub_total_whole_ctq < pub_total_ctq - 0.001

UNION ALL
SELECT 'pat_gov_owned' AS series, country_code, quarter
FROM ${ref("rd_mart", "panel_country_quarter_wide")}
WHERE pat_gov_owned_whole_ctq < pat_gov_owned_ctq - 0.001

UNION ALL
SELECT 'pub_gov_owned' AS series, country_code, quarter
FROM ${ref("rd_mart", "panel_country_quarter_wide")}
WHERE pub_gov_owned_whole_ctq < pub_gov_owned_ctq - 0.001
