config {
  type: "table",
  name: "grants_base",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Core grants staging table: parses start date, attaches funder org + funder country/types, keeps key IDs for later Tier-2 matching."
}

WITH g AS (
  SELECT
    id AS grant_id,
    funder_org,
    -- Prefer start_date; fall back to start_year at Jan 1.
    COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', start_date),
      CASE WHEN start_year IS NOT NULL THEN DATE(CAST(start_year AS INT64), 1, 1) END
    ) AS start_dt,
    funding_usd,
    researcher_ids,
    investigators,
    organisation_details,
    category_for
  FROM `dimensions-ai.data_analytics.grants`
),

f AS (
  SELECT
    o.id AS org_id,
    o.legal_country_code AS funder_country_code,
    o.types AS funder_types
  FROM `dimensions-ai.data_analytics.organizations` o
)

SELECT
  g.grant_id,
  g.funder_org,
  f.funder_country_code AS country_code,
  f.funder_types,
  g.start_dt,
  DATE_TRUNC(g.start_dt, QUARTER) AS start_qtr,
  g.funding_usd,
  g.researcher_ids,
  g.investigators,
  g.organisation_details,
  ARRAY(
    SELECT DISTINCT LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0')
    FROM UNNEST(IFNULL(g.category_for.second_level.codes, [])) AS code
    WHERE code IS NOT NULL
  ) AS grant_for4
FROM g
LEFT JOIN f
  ON f.org_id = g.funder_org
WHERE g.start_dt IS NOT NULL
