config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Grant base with funder country/types, start date, funding_usd, FOR4 codes, investigator RIDs, recipient org grid_ids."
}

WITH grants_raw AS (
  SELECT
    g.id AS grant_id,
    g.funder_org AS funder_org_id,
    COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', g.start_date), DATE(g.start_year, 1, 1)) AS start_dt,
    g.funding_usd,
    g.researcher_ids,
    g.investigators,
    g.organisation_details,
    ARRAY(
      SELECT DISTINCT LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0')
      FROM UNNEST(IFNULL(g.category_for.second_level.codes, [])) AS code
      WHERE code IS NOT NULL
    ) AS grant_for4
  FROM `dimensions-ai.data_analytics.grants` g
  WHERE (g.start_date IS NOT NULL OR g.start_year IS NOT NULL)
),
funder_enriched AS (
  SELECT
    gr.*,
    o.legal_country_code AS funder_country,
    o.types AS funder_types
  FROM grants_raw gr
  LEFT JOIN ${ref("orgs_basic")} o
    ON o.org_id = gr.funder_org_id
)
SELECT * FROM funder_enriched
