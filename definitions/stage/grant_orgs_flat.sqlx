config {
  type: "table",
  schema: "rd_stage",
  name: "grant_orgs_flat",
  tags: ["stage"],
  description: "Flatten grant recipient organizations (grid_id) for institution matching. Includes grant start_dt for time-window rules."
}

SELECT DISTINCT
  g.country_code,
  g.grant_id,
  g.start_dt,
  od.grid_id AS org_id
FROM ${ref("rd_stage", "grants_gov_core")} g
CROSS JOIN UNNEST(IFNULL(g.organisation_details, [])) AS od
WHERE od.grid_id IS NOT NULL
  AND g.start_dt IS NOT NULL
