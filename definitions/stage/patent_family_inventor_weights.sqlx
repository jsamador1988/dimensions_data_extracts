config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Family×country inventor fractional weights w_inv (normalized over observed inventor countries)."
}

WITH inv AS (
  SELECT
    p.family_id,
    -- normalize UK -> GB for macro merges
    CASE WHEN inv.address.country = 'UK' THEN 'GB' ELSE inv.address.country END AS country_code,

    -- de-dup key: prefer researcher_id; else fallback
    COALESCE(
      inv.researcher_id,
      CONCAT(IFNULL(inv.first_name,''), '|', IFNULL(inv.last_name,''), '|', IFNULL(inv.address.country,''))
    ) AS inv_key
  FROM `dimensions-ai.data_analytics.patents` p
  CROSS JOIN UNNEST(p.inventors) AS inv
  WHERE p.family_id IS NOT NULL
),

inv_clean AS (
  SELECT *
  FROM inv
  WHERE country_code IS NOT NULL
    AND REGEXP_CONTAINS(country_code, r'^[A-Z]{2}$')
)

, by_cty AS (
  SELECT
    family_id,
    country_code,
    COUNT(DISTINCT inv_key) AS n_inv
  FROM inv_clean
  GROUP BY family_id, country_code
),

tot AS (
  SELECT family_id, SUM(n_inv) AS n_inv_total
  FROM by_cty
  GROUP BY family_id
)

SELECT
  b.family_id,
  b.country_code,
  SAFE_DIVIDE(b.n_inv, t.n_inv_total) AS w_inv
FROM by_cty b
JOIN tot t USING (family_id)
WHERE t.n_inv_total > 0
