config {
  type: "table",
  name: "patent_family_base",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Slim patent base table with only required fields (avoids BigQuery 100MB row limit) and safe FoR4 array (no null elements)."
}

SELECT
  p.family_id,
  p.id AS patent_id,
  p.jurisdiction,

  SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date) AS priority_dt,
  SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date) AS filing_dt,

  CASE
    WHEN SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date) IS NOT NULL
     AND SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date)   IS NOT NULL
      THEN LEAST(
        SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
        SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date)
      )
    ELSE COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
      SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date)
    )
  END AS doc_earliest_app_dt,

  p.inventors,
  IFNULL(p.assignee_orgs, []) AS assignee_orgs,

  ARRAY(
    SELECT DISTINCT LPAD(digits, 4, '0')
    FROM (
      SELECT REGEXP_EXTRACT(code, r'\\d+') AS digits
      FROM UNNEST(IFNULL(p.category_for.second_level.codes, [])) AS code
      WHERE code IS NOT NULL
    )
    WHERE digits IS NOT NULL
  ) AS for4_codes

FROM `dimensions-ai.data_analytics.patents` p
WHERE p.family_id IS NOT NULL
