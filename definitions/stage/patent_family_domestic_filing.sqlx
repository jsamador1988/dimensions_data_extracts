config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Family×country domestic filing indicator dom_filing, using time-varying EPO membership: national office OR EP if EPC active at family_app_dt."
}

WITH anchor AS (
  SELECT family_id, family_app_dt, jurisdictions
  FROM ${ref("patent_family_anchor")}
),

countries AS (
  -- define the country set as union of inventor+assignee countries for that family
  SELECT DISTINCT family_id, country_code
  FROM (
    SELECT family_id, country_code FROM ${ref("patent_family_inventor_weights")}
    UNION DISTINCT
    SELECT family_id, country_code FROM ${ref("patent_family_assignee_weights")}
  )
),

epo AS (
  SELECT country_code, epo_start_date, epo_end_date
  FROM ${ref("epo_membership")}
)

SELECT
  c.family_id,
  c.country_code,
  a.family_app_dt,

  -- national filing exists if jurisdiction list contains the country code
  CASE WHEN EXISTS (
    SELECT 1 FROM UNNEST(a.jurisdictions) j WHERE j = c.country_code
  ) THEN 1 ELSE 0 END AS has_nat_filing,

  CASE WHEN EXISTS (
    SELECT 1 FROM UNNEST(a.jurisdictions) j WHERE j = 'EP'
  ) THEN 1 ELSE 0 END AS has_ep_filing,

  CASE
    WHEN e.country_code IS NULL THEN 0
    WHEN a.family_app_dt >= e.epo_start_date
     AND (e.epo_end_date IS NULL OR a.family_app_dt <= e.epo_end_date)
    THEN 1 ELSE 0
  END AS epo_active,

  CASE
    WHEN EXISTS (SELECT 1 FROM UNNEST(a.jurisdictions) j WHERE j = c.country_code) THEN 1
    WHEN (
      EXISTS (SELECT 1 FROM UNNEST(a.jurisdictions) j WHERE j = 'EP')
      AND (
        e.country_code IS NOT NULL
        AND a.family_app_dt >= e.epo_start_date
        AND (e.epo_end_date IS NULL OR a.family_app_dt <= e.epo_end_date)
      )
    ) THEN 1
    ELSE 0
  END AS dom_filing

FROM countries c
JOIN anchor a USING (family_id)
LEFT JOIN epo e
  ON e.country_code = c.country_code
