config {
  type: "table",
  name: "pub_field_quality",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Publication×field22 weights plus quality flags: top5 journal and breakthrough (top 5% nc_5y).",
  bigquery: {
    clusterBy: ["pub_id", "field22_code"]
  }
}

WITH core AS (
  SELECT
    pub_id,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year,
    journal_id
  FROM ${ref("rd_stage", "pub_core")}
  WHERE pub_id IS NOT NULL
    AND pub_dt_best IS NOT NULL
),

fw AS (
  SELECT pub_id, field22_code, w_field
  FROM ${ref("rd_stage", "pub_field_weights")}
),

cit AS (
  SELECT pub_id, pub_year, citations_5y
  FROM ${ref("rd_stage", "pub_citations_5y")}
),

norm AS (
  SELECT field22_code, pub_year, exp_citations_5y
  FROM ${ref("rd_stage", "pub_field_year_norm")}
),

thr AS (
  SELECT field22_code, pub_year, p95_nc5y
  FROM ${ref("rd_stage", "pub_breakthrough_thresholds")}
),

top5 AS (
  SELECT journal_id, field22_code, is_top5
  FROM ${ref("rd_stage", "journal_top5_by_field")}
),

paper_field AS (
  SELECT
    c.pub_id,
    c.pub_year,
    c.journal_id,
    fw.field22_code,
    fw.w_field,
    cit.citations_5y,
    norm.exp_citations_5y,
    SAFE_DIVIDE(cit.citations_5y, NULLIF(norm.exp_citations_5y, 0)) AS nc_5y
  FROM core c
  JOIN fw
    ON fw.pub_id = c.pub_id
  LEFT JOIN cit
    ON cit.pub_id = c.pub_id
   AND cit.pub_year = c.pub_year
  LEFT JOIN norm
    ON norm.field22_code = fw.field22_code
   AND norm.pub_year = c.pub_year
)

SELECT
  pf.pub_id,
  pf.field22_code,
  pf.w_field,
  IFNULL(t5.is_top5, 0) AS is_top5,
  CASE
    WHEN pf.nc_5y IS NULL OR thr.p95_nc5y IS NULL THEN 0
    WHEN pf.nc_5y >= thr.p95_nc5y THEN 1
    ELSE 0
  END AS is_breakthrough
FROM paper_field pf
LEFT JOIN top5 t5
  ON t5.journal_id = pf.journal_id
 AND t5.field22_code = pf.field22_code
LEFT JOIN thr
  ON thr.field22_code = pf.field22_code
 AND thr.pub_year = pf.pub_year
WHERE pf.field22_code IS NOT NULL
  AND pf.w_field IS NOT NULL
