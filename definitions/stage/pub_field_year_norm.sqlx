config {
  type: "table",
  name: "pub_field_year_norm",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Expected (mean) 5y citations by field22×year, weighted by pub_field_weights.",
  bigquery: {
    partitionBy: "pub_year",
    clusterBy: ["field22_code"]
  }
}

WITH fw AS (
  SELECT pub_id, quarter, field22_code, w_field
  FROM ${ref("rd_stage", "pub_field_weights")}
),

cit AS (
  SELECT pub_id, pub_year, citations_5y
  FROM ${ref("rd_stage", "pub_citations_5y")}
)

SELECT
  fw.field22_code,
  cit.pub_year,
  SAFE_DIVIDE(SUM(fw.w_field * cit.citations_5y), SUM(fw.w_field)) AS exp_citations_5y,
  COUNT(DISTINCT fw.pub_id) AS n_pubs
FROM fw
JOIN cit
  ON cit.pub_id = fw.pub_id
WHERE fw.field22_code IS NOT NULL
  AND cit.pub_year IS NOT NULL
GROUP BY fw.field22_code, cit.pub_year
