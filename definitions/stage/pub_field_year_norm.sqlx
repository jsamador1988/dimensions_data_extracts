config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Field-year expected citations (5y): E[citations_5y | field22_code, pub_year], weighted by paper field weights."
}

WITH core AS (
  SELECT
    pub_id,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year
  FROM ${ref("rd_stage", "pub_core")}
  WHERE pub_dt_best IS NOT NULL
),

cit AS (
  SELECT
    pub_id,
    citations_5y
  FROM ${ref("rd_stage", "pub_citations_5y")}
),

fw AS (
  SELECT
    pub_id,
    field22_code,
    w_field
  FROM ${ref("rd_stage", "pub_field_weights")}
),

panel AS (
  SELECT
    fw.field22_code,
    core.pub_year,
    fw.w_field,
    IFNULL(cit.citations_5y, 0) AS citations_5y
  FROM fw
  JOIN core
    ON core.pub_id = fw.pub_id
  LEFT JOIN cit
    ON cit.pub_id = fw.pub_id
  WHERE core.pub_year IS NOT NULL
)

SELECT
  field22_code,
  pub_year,
  SAFE_DIVIDE(SUM(w_field * citations_5y), SUM(w_field)) AS exp_citations_5y
FROM panel
GROUP BY field22_code, pub_year
HAVING SUM(w_field) > 0
