config {
  type: "table",
  name: "pub_field_year_norm",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Field-year expected citations (5y) for normalization. Produces E[citations_5y | field22_code, pub_year]."
}

WITH core AS (
  SELECT
    pub_id,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year
  FROM ${ref("pub_core")}
),

cits AS (
  -- must contain: pub_id, citations_5y
  SELECT
    pub_id,
    citations_5y
  FROM ${ref("pub_citations_5y")}
),

pw AS (
  -- must contain: pub_id, field22_code, w_field
  SELECT
    pub_id,
    field22_code,
    w_field
  FROM ${ref("pub_field_weights")}
),

paper_field AS (
  SELECT
    c.pub_id,
    c.pub_year,
    pw.field22_code,
    pw.w_field,
    cits.citations_5y
  FROM core c
  JOIN pw
    ON pw.pub_id = c.pub_id
  LEFT JOIN cits
    ON cits.pub_id = c.pub_id
  WHERE c.pub_year IS NOT NULL
)

SELECT
  field22_code,
  pub_year,
  AVG(COALESCE(citations_5y, 0.0)) AS exp_citations_5y
FROM paper_field
GROUP BY field22_code, pub_year
