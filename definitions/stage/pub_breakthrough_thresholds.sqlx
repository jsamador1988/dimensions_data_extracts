config {
  type: "table",
  name: "pub_breakthrough_thresholds",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Field22×year breakthrough threshold (95th percentile) of normalized 5y citations.",
  bigquery: {
    partitionBy: "RANGE_BUCKET(pub_year, GENERATE_ARRAY(1900, 2100, 1))",
    clusterBy: ["field22_code"]
  }
}

WITH core AS (
  SELECT
    pub_id,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year
  FROM ${ref("rd_stage", "pub_core")}
  WHERE pub_id IS NOT NULL
    AND pub_dt_best IS NOT NULL
),

fw AS (
  SELECT pub_id, field22_code, w_field
  FROM ${ref("rd_stage", "pub_field_weights")}
),

cit AS (
  SELECT pub_id, pub_year, citations_5y
  FROM ${ref("rd_stage", "pub_citations_5y")}
),

norm AS (
  SELECT field22_code, pub_year, exp_citations_5y
  FROM ${ref("rd_stage", "pub_field_year_norm")}
),

paper_field AS (
  SELECT
    c.pub_id,
    c.pub_year,
    fw.field22_code,
    SAFE_DIVIDE(cit.citations_5y, NULLIF(norm.exp_citations_5y, 0)) AS nc_5y
  FROM core c
  JOIN fw
    ON fw.pub_id = c.pub_id
  LEFT JOIN cit
    ON cit.pub_id = c.pub_id
   AND cit.pub_year = c.pub_year
  LEFT JOIN norm
    ON norm.field22_code = fw.field22_code
   AND norm.pub_year = c.pub_year
  WHERE fw.field22_code IS NOT NULL
    AND c.pub_year IS NOT NULL
    AND cit.citations_5y IS NOT NULL
    AND norm.exp_citations_5y IS NOT NULL
)

SELECT
  field22_code,
  pub_year,
  APPROX_QUANTILES(nc_5y, 100)[OFFSET(95)] AS p95_nc5y
FROM paper_field
WHERE nc_5y IS NOT NULL
GROUP BY field22_code, pub_year
