config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Publication×field22 flags: top-5% journal (by field) and breakthrough (top 1% nc_5y within field-year)."
}

WITH cfg AS (
  SELECT
    DATE('${dataform.projectConfig.vars.sample_end}') AS sample_end_dt,
    CAST('${dataform.projectConfig.vars.breakthrough_window_years}' AS INT64) AS window_years,
    0.01 AS breakthrough_pct
),

core AS (
  SELECT
    pub_id,
    quarter,
    pub_dt_best,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year,
    journal_id
  FROM ${ref("rd_stage", "pub_core")}
  WHERE pub_id IS NOT NULL
    AND quarter IS NOT NULL
    AND pub_dt_best IS NOT NULL
),

fw AS (
  SELECT
    pub_id,
    quarter,
    field22_code,
    w_field
  FROM ${ref("rd_stage", "pub_field_weights")}
),

cit AS (
  SELECT pub_id, citations_5y
  FROM ${ref("rd_stage", "pub_citations_5y")}
),

norm AS (
  SELECT field22_code, pub_year, exp_citations_5y
  FROM ${ref("rd_stage", "pub_field_year_norm")}
),

top5 AS (
  SELECT journal_id, field22_code, is_top5
  FROM ${ref("rd_stage", "journal_top5_by_field")}
),

-- Paper × field panel with normalized citations + flags
paper_field AS (
  SELECT
    c.pub_id,
    c.quarter,
    c.pub_dt_best,
    c.pub_year,
    c.journal_id,
    fw.field22_code,
    fw.w_field,
    cit.citations_5y,
    norm.exp_citations_5y,
    SAFE_DIVIDE(cit.citations_5y, NULLIF(norm.exp_citations_5y, 0)) AS nc_5y,
    COALESCE(t.is_top5, 0) AS is_top5_field
  FROM core c
  JOIN fw
    ON fw.pub_id = c.pub_id
   AND fw.quarter = c.quarter
  LEFT JOIN cit
    ON cit.pub_id = c.pub_id
  LEFT JOIN norm
    ON norm.field22_code = fw.field22_code
   AND norm.pub_year = c.pub_year
  LEFT JOIN top5 t
    ON t.journal_id = c.journal_id
   AND t.field22_code = fw.field22_code
),

-- Rolling window for breakthroughs (avoid full-history ranking drift)
paper_field_window AS (
  SELECT
    pf.*
  FROM paper_field pf
  CROSS JOIN cfg
  WHERE pf.pub_dt_best >= DATE_SUB(cfg.sample_end_dt, INTERVAL cfg.window_years YEAR)
    AND pf.pub_dt_best <= cfg.sample_end_dt
    AND pf.field22_code IS NOT NULL
    AND pf.nc_5y IS NOT NULL
),

ranked AS (
  SELECT
    pfw.*,
    PERCENT_RANK() OVER (
      PARTITION BY field22_code, pub_year
      ORDER BY nc_5y DESC
    ) AS pr_nc
  FROM paper_field_window pfw
)

SELECT
  pub_id,
  quarter,
  pub_year,
  field22_code,
  w_field,
  is_top5_field,
  CAST(pr_nc <= (SELECT breakthrough_pct FROM cfg) AS INT64) AS is_breakthrough_field
FROM ranked
