config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Field-specific flags per (pub_id, field): top5 journal + breakthrough (top 0.1% within field-year)."
}

WITH core AS (
  SELECT pub_id, pub_dt_best, pub_year, journal_id
  FROM ${ref("pub_core")}
),

norm AS (
  SELECT pub_id, field22_code, pub_year, nc_w
  FROM ${ref("pub_field_year_norm")}
),

-- Breakthrough threshold: ~99.9th percentile within (field,year)
thr AS (
  SELECT
    field22_code,
    pub_year,
    APPROX_QUANTILES(nc_w, 1000)[OFFSET(999)] AS nc_thr_999
  FROM norm
  GROUP BY field22_code, pub_year
),

top5 AS (
  SELECT field22_code, journal_id, is_top5_within_field
  FROM ${ref("journal_top5_by_field")}
),

joined AS (
  SELECT
    n.pub_id,
    n.field22_code,
    n.pub_year,
    n.nc_w,
    c.pub_dt_best,
    c.journal_id,

    -- top journal within field
    COALESCE(t.is_top5_within_field, 0) AS is_top5_field,

    -- breakthrough eligibility: need full window
    CASE
      WHEN c.pub_dt_best <= DATE_SUB(DATE('${vars.sample_end}'), INTERVAL CAST('${vars.breakthrough_window_years}' AS INT64) YEAR)
      THEN 1 ELSE 0
    END AS break_eligible
  FROM norm n
  JOIN core c USING (pub_id)
  LEFT JOIN top5 t
    ON t.field22_code = n.field22_code
   AND t.journal_id = c.journal_id
)

SELECT
  j.pub_id,
  j.field22_code,
  j.pub_year,
  j.nc_w,
  j.is_top5_field,
  CASE
    WHEN j.break_eligible = 1 AND j.nc_w >= th.nc_thr_999 THEN 1 ELSE 0
  END AS is_breakthrough_field
FROM joined j
JOIN thr th
  ON th.field22_code = j.field22_code
 AND th.pub_year     = j.pub_year
