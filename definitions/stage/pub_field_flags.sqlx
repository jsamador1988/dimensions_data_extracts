config {
  type: "table",
  schema: "rd_stage",
  name: "pub_field_flags",
  tags: ["stage"],
  description: "Canonical publication×field22 flags: w_field plus top5 and breakthrough flags. This table is used by older downstream aggregates (pub_country_quarter_*). Internally, it is built from pub_field_weights + pub_top5_pub_field + pub_breakthrough_pub_field."
}

WITH core AS (
  SELECT
    pub_id,
    DATE_TRUNC(pub_dt_best, QUARTER) AS quarter,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year
  FROM ${ref("pub_core")}
  WHERE pub_id IS NOT NULL
    AND pub_dt_best IS NOT NULL
),

fw AS (
  SELECT
    pub_id,
    quarter,
    field22_code,
    w_field
  FROM ${ref("pub_field_weights")}
  WHERE pub_id IS NOT NULL
    AND quarter IS NOT NULL
    AND field22_code IS NOT NULL
    AND w_field IS NOT NULL
),

top5 AS (
  SELECT
    pub_id,
    quarter,
    field22_code,
    is_top5
  FROM ${ref("rd_stage", "pub_top5_pub_field")}
),

br AS (
  SELECT
    pub_id,
    quarter,
    field22_code,
    eligible_for_breakthrough,
    is_breakthrough
  FROM ${ref("rd_stage", "pub_breakthrough_pub_field")}
)

SELECT
  fw.pub_id,
  fw.quarter,
  c.pub_year,
  fw.field22_code,
  fw.w_field,

  COALESCE(t.is_top5, 0) AS is_top5_field,

  COALESCE(b.is_breakthrough, 0) AS is_breakthrough_field,

  COALESCE(b.eligible_for_breakthrough, 0) AS break_eligible

FROM fw
JOIN core c
  ON c.pub_id = fw.pub_id
 AND c.quarter = fw.quarter
LEFT JOIN top5 t
  ON t.pub_id = fw.pub_id
 AND t.quarter = fw.quarter
 AND t.field22_code = fw.field22_code
LEFT JOIN br b
  ON b.pub_id = fw.pub_id
 AND b.quarter = fw.quarter
 AND b.field22_code = fw.field22_code
