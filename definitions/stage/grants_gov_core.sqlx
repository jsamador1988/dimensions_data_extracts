config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Surico-style government-funded grants (government+DE whitelist), with country, start date, FoR(4) set, funding_usd."
}

-- Edit whitelist here if you expand it later.
WITH whitelist_de AS (
  SELECT 'grid.424150.6' AS org_id UNION ALL -- DFG
  SELECT 'grid.453068.c' UNION ALL          -- AiF
  SELECT 'grid.453150.6'                   -- DBU
),

target_countries AS (
  SELECT DISTINCT country_code
  FROM ${ref("rd_stage", "analysis_country_quarter_grid")}
),

funder_orgs AS (
  SELECT
    o.id AS org_id,
    CASE WHEN o.legal_country_code = 'UK' THEN 'GB' ELSE o.legal_country_code END AS country_code,
    o.types,
    CASE
      WHEN 'Government' IN UNNEST(IFNULL(o.types, [])) THEN TRUE
      WHEN (CASE WHEN o.legal_country_code='UK' THEN 'GB' ELSE o.legal_country_code END) = 'DE'
           AND o.id IN (SELECT org_id FROM whitelist_de) THEN TRUE
      ELSE FALSE
    END AS is_gov_surico
  FROM `dimensions-ai.data_analytics.organizations` o
  WHERE o.legal_country_code IS NOT NULL
),

gov_funder_orgs AS (
  SELECT f.*
  FROM funder_orgs f
  JOIN target_countries tc
    ON tc.country_code = f.country_code
  WHERE f.is_gov_surico
),

grants AS (
  SELECT
    g.id AS grant_id,
    g.funder_org AS funder_org_id,
    COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', g.start_date),
      DATE(SAFE_CAST(g.start_year AS INT64), 1, 1)
    ) AS start_dt,
    g.funding_usd,

    ARRAY(
      SELECT DISTINCT LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0')
      FROM UNNEST(IFNULL(g.category_for.second_level.codes, [])) AS code
      WHERE code IS NOT NULL
    ) AS grant_for4,

    g.researcher_ids,
    g.investigators,
    g.organisation_details
  FROM `dimensions-ai.data_analytics.grants` g
  WHERE (g.start_date IS NOT NULL OR g.start_year IS NOT NULL)
)

SELECT
  gfo.country_code,
  g.grant_id,
  g.start_dt,
  g.funding_usd,
  g.grant_for4,
  g.researcher_ids,
  g.investigators,
  g.organisation_details
FROM grants g
JOIN gov_funder_orgs gfo
  ON gfo.org_id = g.funder_org_id
WHERE g.start_dt IS NOT NULL
