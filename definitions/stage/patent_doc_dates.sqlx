config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Patent document-level parsed dates and earliest application date."
}

SELECT
  p.family_id,
  p.id AS patent_id,
  p.jurisdiction,

  COALESCE(
    SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
    CASE WHEN p.priority_year IS NOT NULL THEN DATE(SAFE_CAST(p.priority_year AS INT64), 1, 1) END
  ) AS priority_dt,

  COALESCE(
    SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date),
    CASE WHEN p.filing_year IS NOT NULL THEN DATE(SAFE_CAST(p.filing_year AS INT64), 1, 1) END
  ) AS filing_dt,

  CASE
    WHEN COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
                  CASE WHEN p.priority_year IS NOT NULL THEN DATE(SAFE_CAST(p.priority_year AS INT64),1,1) END) IS NOT NULL
     AND COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date),
                  CASE WHEN p.filing_year IS NOT NULL THEN DATE(SAFE_CAST(p.filing_year AS INT64),1,1) END) IS NOT NULL
    THEN LEAST(
      COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
               CASE WHEN p.priority_year IS NOT NULL THEN DATE(SAFE_CAST(p.priority_year AS INT64),1,1) END),
      COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date),
               CASE WHEN p.filing_year IS NOT NULL THEN DATE(SAFE_CAST(p.filing_year AS INT64),1,1) END)
    )
    ELSE COALESCE(
      COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
               CASE WHEN p.priority_year IS NOT NULL THEN DATE(SAFE_CAST(p.priority_year AS INT64),1,1) END),
      COALESCE(SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date),
               CASE WHEN p.filing_year IS NOT NULL THEN DATE(SAFE_CAST(p.filing_year AS INT64),1,1) END)
    )
  END AS doc_earliest_app_dt
FROM `dimensions-ai.data_analytics.patents` p
WHERE p.family_id IS NOT NULL
