config {
  type: "table",
  name: "pub_affiliations_flat",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Publication×affiliation rows: (pub_id, quarter, org_id, country_code). Joins org_id->organizations to get ISO2 country_code."
}

-- We assume pub_core already defines the publication universe (research articles, month-level dates, sample window)
WITH core AS (
  SELECT
    pub_id,
    quarter
  FROM ${ref("pub_core")}
),

pub_orgs AS (
  SELECT
    c.pub_id,
    c.quarter,
    org_id
  FROM core c
  JOIN `dimensions-ai.data_analytics.publications` p
    ON p.id = c.pub_id
  -- IMPORTANT: many Dimensions publication affiliation/org arrays are STRING org IDs.
  -- Do NOT try org_id.country_code.
  LEFT JOIN UNNEST(IFNULL(p.research_orgs, [])) AS org_id
  WHERE org_id IS NOT NULL
),

orgs AS (
  SELECT
    id AS org_id,
    CASE
      WHEN legal_country_code = 'UK' THEN 'GB'
      ELSE legal_country_code
    END AS country_code
  FROM `dimensions-ai.data_analytics.organizations`
)

SELECT
  po.pub_id,
  po.quarter,
  po.org_id,
  o.country_code
FROM pub_orgs po
LEFT JOIN orgs o
  ON o.org_id = po.org_id
WHERE o.country_code IS NOT NULL
  AND REGEXP_CONTAINS(o.country_code, r'^[A-Z]{2}$')
  AND o.country_code NOT IN ('EP', 'WO')
