config {
  type: "table",
  name: "pub_field_weights",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Publication×for4 fractional weights w_field based on distinct FoR4 codes on the paper (temporary: replaces missing for4_to_field22 mapping)."
}

WITH core AS (
  SELECT
    pub_id,
    quarter,
    for4_codes
  FROM ${ref("pub_core")}
  WHERE pub_id IS NOT NULL AND quarter IS NOT NULL
),

for4_flat AS (
  SELECT
    c.pub_id,
    c.quarter,
    CAST(for4 AS STRING) AS field22_code
  FROM core c
  CROSS JOIN UNNEST(IFNULL(c.for4_codes, [])) AS for4
  WHERE for4 IS NOT NULL
),

mapped AS (
  SELECT DISTINCT
    pub_id,
    quarter,
    field22_code
  FROM for4_flat
),

totals AS (
  SELECT
    pub_id,
    quarter,
    COUNT(*) AS n_fields
  FROM mapped
  GROUP BY pub_id, quarter
)

SELECT
  m.pub_id,
  m.quarter,
  m.field22_code,
  SAFE_DIVIDE(1.0, t.n_fields) AS w_field
FROM mapped m
JOIN totals t
  USING (pub_id, quarter)
WHERE t.n_fields > 0
