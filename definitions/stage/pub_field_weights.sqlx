config {
  type: "table",
  name: "pub_field_weights",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Publication×field22 fractional weights w_field based on distinct mapped FoR4 codes on the paper."
}

WITH core AS (
  SELECT
    pub_id,
    quarter,
    for4_codes
  FROM ${ref("rd_stage", "pub_core")}
  WHERE pub_id IS NOT NULL AND quarter IS NOT NULL
),

for4_flat AS (
  SELECT
    c.pub_id,
    c.quarter,
    CAST(for4 AS STRING) AS for4
  FROM core c
  CROSS JOIN UNNEST(IFNULL(c.for4_codes, [])) AS for4
  WHERE for4 IS NOT NULL
),

mapped AS (
  SELECT DISTINCT
    f.pub_id,
    f.quarter,
    m.field22_code
  FROM for4_flat f
  JOIN ${ref("rd_ref", "for4_to_field22")} m
    ON m.for4 = f.for4
  WHERE m.field22_code IS NOT NULL
),

totals AS (
  SELECT
    pub_id,
    quarter,
    COUNT(DISTINCT field22_code) AS n_fields
  FROM mapped
  GROUP BY pub_id, quarter
)

SELECT
  m.pub_id,
  m.quarter,
  m.field22_code,
  SAFE_DIVIDE(1.0, t.n_fields) AS w_field
FROM mapped m
JOIN totals t
  USING (pub_id, quarter)
WHERE t.n_fields > 0
