config {
  type: "table",
  schema: "rd_stage",
  name: "patent_family_assignee_orgs",
  tags: ["stage", "patents"],
  description: "Family-level assignee organization IDs (GRID), deduplicated across family members."
}

SELECT DISTINCT
  p.family_id,
  org_id
FROM ${ref("rd_stage", "patent_doc_core")} p
CROSS JOIN UNNEST(IFNULL(p.assignee_orgs, CAST([] AS ARRAY<STRING>))) AS org_id
WHERE p.family_id IS NOT NULL
  AND org_id IS NOT NULL
