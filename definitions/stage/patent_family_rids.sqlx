config {
  type: "table",
  schema: "rd_stage",
  name: "patent_family_rids",
  tags: ["stage", "patents"],
  description: "Family-level inventor researcher IDs (RIDs), for Tier-2 researcher matching."
}

SELECT DISTINCT
  p.family_id,
  inv.researcher_id
FROM ${ref("rd_stage", "patent_doc_core")} p
CROSS JOIN UNNEST(p.inventors) AS inv
WHERE p.family_id IS NOT NULL
  AND inv.researcher_id IS NOT NULL
