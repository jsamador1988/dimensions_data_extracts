config {
  type: "table",
  schema: "rd_stage",
  name: "patent_family_anchor",
  tags: ["stage", "patents"],
  description: "Family-level anchor date/quarter: min earliest application date across all family members."
}

WITH d AS (
  SELECT family_id, doc_earliest_app_dt
  FROM ${ref("rd_stage", "patent_doc_core")}
  WHERE doc_earliest_app_dt IS NOT NULL
)

SELECT
  family_id,
  MIN(doc_earliest_app_dt) AS family_app_dt,
  DATE_TRUNC(MIN(doc_earliest_app_dt), QUARTER) AS family_app_qtr
FROM d
GROUP BY family_id
