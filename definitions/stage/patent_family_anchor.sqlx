config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Family-level anchor date and quarter (min earliest application date across family documents)."
}

SELECT
  family_id,
  MIN(doc_earliest_app_dt) AS family_app_dt,
  DATE_TRUNC(MIN(doc_earliest_app_dt), QUARTER) AS family_app_qtr
FROM ${ref("patent_doc_dates")}
WHERE doc_earliest_app_dt IS NOT NULL
GROUP BY family_id
