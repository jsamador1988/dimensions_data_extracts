config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Core publication universe: research articles with month-level earliest date within sample window."
}

WITH base AS (
  SELECT
    p.id AS pub_id,
    p.journal.id AS journal_id,
    p.journal.title AS journal_title,

    p.date        AS date_str,
    p.date_online AS date_online_str,
    p.date_print  AS date_print_str,

    p.document_type.classification AS doc_classification,
    CAST(p.document_type.is_citable AS STRING) AS is_citable_str,

    -- FoR codes live in p.category_for.second_level.codes (4-digit in most cases)
    p.category_for.second_level.codes AS for4_codes,

    -- funders for later
    p.funder_orgs AS funder_orgs,

    -- authors for affiliation extraction later
    p.authors AS authors,

    -- citations array for windowed citations
    p.citations AS citations
  FROM `dimensions-ai.data_analytics.publications` p
),

parsed AS (
  SELECT
    pub_id,
    journal_id,
    journal_title,
    for4_codes,
    funder_orgs,
    authors,
    citations,

    -- Helper: parse YYYY-MM-DD or YYYY-MM only. Reject year-only.
    CASE
      WHEN date_str IS NULL THEN NULL
      WHEN REGEXP_CONTAINS(date_str, r'^\d{4}-\d{2}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', date_str)
      WHEN REGEXP_CONTAINS(date_str, r'^\d{4}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(date_str, '-01'))
      ELSE NULL
    END AS dt_date,

    CASE
      WHEN date_online_str IS NULL THEN NULL
      WHEN REGEXP_CONTAINS(date_online_str, r'^\d{4}-\d{2}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', date_online_str)
      WHEN REGEXP_CONTAINS(date_online_str, r'^\d{4}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(date_online_str, '-01'))
      ELSE NULL
    END AS dt_online,

    CASE
      WHEN date_print_str IS NULL THEN NULL
      WHEN REGEXP_CONTAINS(date_print_str, r'^\d{4}-\d{2}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', date_print_str)
      WHEN REGEXP_CONTAINS(date_print_str, r'^\d{4}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', CONCAT(date_print_str, '-01'))
      ELSE NULL
    END AS dt_print,

    doc_classification,
    LOWER(is_citable_str) AS is_citable_lower
  FROM base
),

dated AS (
  SELECT
    *,
    -- Earliest non-null of dt_date, dt_online, dt_print
    (
      SELECT d
      FROM UNNEST([dt_date, dt_online, dt_print]) AS d
      WHERE d IS NOT NULL
      ORDER BY d
      LIMIT 1
    ) AS pub_dt_best
  FROM parsed
),

filtered AS (
  SELECT
    pub_id,
    journal_id,
    journal_title,
    pub_dt_best,
    DATE_TRUNC(pub_dt_best, QUARTER) AS quarter,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year,
    for4_codes,
    funder_orgs,
    authors,
    citations
  FROM dated
  WHERE pub_dt_best IS NOT NULL
    -- research article restriction
    AND doc_classification = 'RESEARCH_ARTICLE'
    AND is_citable_lower = 'true'
    -- keep only dates in window
    AND pub_dt_best BETWEEN DATE('${vars.sample_start}') AND DATE('${vars.sample_end}')
)

SELECT * FROM filtered
