config {
  type: "table",
  schema: "rd_stage",
  name: "pub_core",
  tags: ["stage", "publications"],
  description: "Publication core: one row per research-article publication with robust publication date (quarter), FoR4 codes, authors (with affiliations), funders, and outgoing citations."
}

-- NOTE on dates:
--  - If vars.pub_allow_year_only_dates = false (default), year-only dates (YYYY) are dropped.
--  - If true, year-only dates are assigned to Jan 1 (using Dimensions date_normal) and included.

WITH base AS (
  SELECT
    p.id AS pub_id,
    p.date AS date_str,
    p.date_normal AS date_normal,
    p.date_online AS date_online_str,
    p.date_print AS date_print_str,
    p.document_type.classification AS doc_class,
    SAFE_CAST(p.document_type.is_citable AS BOOL) AS is_citable,
    p.authors,
    IFNULL(p.funder_orgs, CAST([] AS ARRAY<STRING>)) AS funder_orgs,
    IFNULL(p.funding_details, CAST([] AS ARRAY<STRUCT<grid_id STRING, grant_id STRING>>)) AS funding_details,
    IFNULL(p.reference_ids, CAST([] AS ARRAY<STRING>)) AS reference_ids,

    ARRAY(
      SELECT DISTINCT LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0')
      FROM UNNEST(IFNULL(p.category_for.second_level.codes, [])) AS code
      WHERE code IS NOT NULL
        AND REGEXP_EXTRACT(code, r'\d+') IS NOT NULL
    ) AS for4_codes

  FROM `dimensions-ai.data_analytics.publications` p
  WHERE p.id IS NOT NULL
),

dates AS (
  SELECT
    b.*,

    -- Parse a Dimensions date string which can be: YYYY-MM-DD, YYYY-MM, or YYYY.
    -- If only YYYY is present, include only when pub_allow_year_only_dates=true.
    (
      SELECT MIN(d)
      FROM UNNEST([
        -- Version-of-record date
        CASE
          WHEN REGEXP_CONTAINS(b.date_str, r'^\d{4}-\d{2}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', b.date_str)
          WHEN REGEXP_CONTAINS(b.date_str, r'^\d{4}-\d{2}$') THEN DATE(SAFE_CAST(SUBSTR(b.date_str,1,4) AS INT64), SAFE_CAST(SUBSTR(b.date_str,6,2) AS INT64), 1)
          WHEN REGEXP_CONTAINS(b.date_str, r'^\d{4}$') THEN
            CASE
              WHEN LOWER('${dataform.projectConfig.vars.pub_allow_year_only_dates}') IN ('true','t','1','yes','y') THEN b.date_normal
              ELSE NULL
            END
          ELSE NULL
        END,

        -- Online date
        CASE
          WHEN REGEXP_CONTAINS(b.date_online_str, r'^\d{4}-\d{2}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', b.date_online_str)
          WHEN REGEXP_CONTAINS(b.date_online_str, r'^\d{4}-\d{2}$') THEN DATE(SAFE_CAST(SUBSTR(b.date_online_str,1,4) AS INT64), SAFE_CAST(SUBSTR(b.date_online_str,6,2) AS INT64), 1)
          WHEN REGEXP_CONTAINS(b.date_online_str, r'^\d{4}$') THEN
            CASE
              WHEN LOWER('${dataform.projectConfig.vars.pub_allow_year_only_dates}') IN ('true','t','1','yes','y') THEN DATE(SAFE_CAST(b.date_online_str AS INT64),1,1)
              ELSE NULL
            END
          ELSE NULL
        END,

        -- Print date
        CASE
          WHEN REGEXP_CONTAINS(b.date_print_str, r'^\d{4}-\d{2}-\d{2}$') THEN SAFE.PARSE_DATE('%Y-%m-%d', b.date_print_str)
          WHEN REGEXP_CONTAINS(b.date_print_str, r'^\d{4}-\d{2}$') THEN DATE(SAFE_CAST(SUBSTR(b.date_print_str,1,4) AS INT64), SAFE_CAST(SUBSTR(b.date_print_str,6,2) AS INT64), 1)
          WHEN REGEXP_CONTAINS(b.date_print_str, r'^\d{4}$') THEN
            CASE
              WHEN LOWER('${dataform.projectConfig.vars.pub_allow_year_only_dates}') IN ('true','t','1','yes','y') THEN DATE(SAFE_CAST(b.date_print_str AS INT64),1,1)
              ELSE NULL
            END
          ELSE NULL
        END
      ]) AS d
      WHERE d IS NOT NULL
    ) AS pub_dt_best

  FROM base b
),

filtered AS (
  SELECT
    pub_id,
    pub_dt_best,
    DATE_TRUNC(pub_dt_best, QUARTER) AS quarter,
    authors,
    funder_orgs,
    funding_details,
    reference_ids,
    for4_codes
  FROM dates
  WHERE pub_dt_best IS NOT NULL
    AND pub_dt_best >= DATE('${dataform.projectConfig.vars.sample_start}')
    AND pub_dt_best <= DATE('${dataform.projectConfig.vars.sample_end}')
    AND doc_class = 'RESEARCH_ARTICLE'
    AND is_citable
)

SELECT * FROM filtered
