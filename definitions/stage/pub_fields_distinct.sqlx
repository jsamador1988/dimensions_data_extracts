config { 
  type: "table",
  name: "pub_fields_distinct",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Distinct field22 and disc6 categories used for wide publication outputs."
}

WITH f AS (
  SELECT DISTINCT
    field22_code,
    field22_name
  FROM ${ref("rd_ref", "for4_to_field22")}
),

d AS (
  SELECT
    field22_code,
    disc6_code,
    disc6_name
  FROM ${ref("rd_ref", "field22_to_disc6")}
)

SELECT DISTINCT
  f.field22_code,
  f.field22_name,
  d.disc6_code,
  d.disc6_name
FROM f
LEFT JOIN d
  USING (field22_code)
WHERE f.field22_code IS NOT NULL
