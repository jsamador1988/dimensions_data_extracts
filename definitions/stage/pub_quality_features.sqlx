config {
  type: "table",
  schema: "rd_stage",
  name: "pub_quality_features",
  tags: ["stage", "publications"],
  description: "Publication-level quality features extracted independently from pub_core: journal identity (id + title), lifetime citation count (metrics.times_cited), and FoR codes for field normalization. No date filter applied — covers all years so journal ranking and breakthrough calculations are sample-window independent. Downstream quality flags join to pub_pub_country_base (which IS date-filtered) to enter the panel."
}

SELECT
  p.id AS pub_id,
  p.journal.id AS journal_id,
  p.journal.title AS journal_title,
  IFNULL(p.metrics.times_cited, 0) AS times_cited,

  -- Publication year for field-year normalization
  EXTRACT(YEAR FROM COALESCE(
    SAFE.PARSE_DATE('%Y-%m-%d', p.date),
    p.date_normal
  )) AS pub_year,

  -- FoR codes re-extracted for independence from pub_core
  ARRAY(
    SELECT DISTINCT LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0')
    FROM UNNEST(IFNULL(p.category_for.second_level.codes, CAST([] AS ARRAY<STRING>))) AS code
    WHERE code IS NOT NULL
      AND REGEXP_EXTRACT(code, r'\d+') IS NOT NULL
  ) AS for4_codes,

  -- FoR2 codes (2-digit division) for field normalization
  ARRAY(
    SELECT DISTINCT SUBSTR(LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0'), 1, 2)
    FROM UNNEST(IFNULL(p.category_for.second_level.codes, CAST([] AS ARRAY<STRING>))) AS code
    WHERE code IS NOT NULL
      AND REGEXP_EXTRACT(code, r'\d+') IS NOT NULL
  ) AS for2_codes

FROM `dimensions-ai.data_analytics.publications` p
WHERE p.id IS NOT NULL
  AND p.document_type.classification = 'RESEARCH_ARTICLE'
  AND SAFE_CAST(p.document_type.is_citable AS BOOL)
