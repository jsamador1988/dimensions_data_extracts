config {
  type: "table",
  name: "pub2_country_weights",
  schema: "rd_stage",
  tags: ["stage", "phase4", "pub2"],
  description: "Publication×country fractional weights (author-weighted w_aff) with Option-2 ownership bucket: if any gov affiliation exists for that pub×country×quarter, assign the whole country weight to public-owned; else private. Company is a subset of private."
}

WITH w AS (
  -- Keep the same author-weighted country fractional counting as the existing pipeline
  SELECT
    pub_id,
    quarter,
    country_code,
    w_aff
  FROM ${ref("pub_country_weights")}
),

flags AS (
  -- Determine whether a pub×country×quarter has ANY gov affiliation (Surico gov flag),
  -- and whether it has any non-gov affiliation, and any company affiliation.
  SELECT
    pub_id,
    quarter,
    country_code,
    LOGICAL_OR(n_gov_units > 0)     AS has_gov,
    LOGICAL_OR(n_nongov_units > 0)  AS has_nongov,
    LOGICAL_OR(n_company_units > 0) AS has_company
  FROM ${ref("pub_author_country_stats")}
  GROUP BY pub_id, quarter, country_code
)

SELECT
  w.pub_id,
  w.quarter,
  w.country_code,
  w.w_aff,

  -- Option 2: single bucket assignment per pub×country×quarter
  CASE WHEN IFNULL(f.has_gov, FALSE) THEN w.w_aff ELSE 0 END AS w_public_prod,

  CASE
    WHEN NOT IFNULL(f.has_gov, FALSE) AND IFNULL(f.has_nongov, TRUE) THEN w.w_aff
    ELSE 0
  END AS w_private_prod,

  -- Company subset (only if NOT gov-owned under Option 2)
  CASE
    WHEN NOT IFNULL(f.has_gov, FALSE) AND IFNULL(f.has_company, FALSE) THEN w.w_aff
    ELSE 0
  END AS w_company_prod,

  -- Defensive: only nonzero if something weird happens (no gov and no nongov flagged)
  CASE
    WHEN NOT IFNULL(f.has_gov, FALSE) AND NOT IFNULL(f.has_nongov, TRUE) THEN w.w_aff
    ELSE 0
  END AS w_unclassified

FROM w
LEFT JOIN flags f
  USING (pub_id, quarter, country_code)
WHERE w.pub_id IS NOT NULL
  AND w.quarter IS NOT NULL
  AND w.country_code IS NOT NULL
  AND w.w_aff IS NOT NULL
