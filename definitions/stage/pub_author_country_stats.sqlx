config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Per-publication author×country stats for author-weighted country fractional counting. Aggregates affiliation addresses to author-country level and counts public/private affiliation mass for produced shares."
}

WITH core AS (
  SELECT
    pub_id,
    quarter,
    authors
  FROM ${ref("pub_core")}
  WHERE pub_id IS NOT NULL AND quarter IS NOT NULL
),

org_dim AS (
  SELECT
    o.id AS org_id,
    o.legal_country_code,
    o.types
  FROM `dimensions-ai.data_analytics.organizations` o
),

author_aff AS (
  SELECT
    c.pub_id,
    c.quarter,

    -- stable author key: researcher_id if present, else pub_id + author index
    COALESCE(a.researcher_id, CONCAT(c.pub_id, ':a', CAST(author_offset AS STRING))) AS author_uid,

    aff.grid_id AS org_id,

    -- raw country from affiliation address
    CASE
      WHEN aff.country_code = 'UK' THEN 'GB'
      ELSE aff.country_code
    END AS aff_country_code

  FROM core c
  CROSS JOIN UNNEST(IFNULL(c.authors, [])) AS a WITH OFFSET AS author_offset
  LEFT JOIN UNNEST(IFNULL(a.affiliations_address, [])) AS aff
),

author_aff_norm AS (
  SELECT
    aa.pub_id,
    aa.quarter,
    aa.author_uid,
    aa.org_id,

    -- fallback to org legal country if affiliation country missing
    CASE
      WHEN aa.aff_country_code IS NOT NULL THEN aa.aff_country_code
      WHEN od.legal_country_code = 'UK' THEN 'GB'
      ELSE od.legal_country_code
    END AS country_code,

    -- ownership type flags (TEMP definition; Surico-consistent government comes later)
    CASE WHEN 'Company' IN UNNEST(IFNULL(od.types, [])) THEN 1 ELSE 0 END AS is_private,

    CASE
      WHEN (
        'Government' IN UNNEST(IFNULL(od.types, []))
        OR 'Education' IN UNNEST(IFNULL(od.types, []))
        OR 'Healthcare' IN UNNEST(IFNULL(od.types, []))
      ) THEN 1 ELSE 0
    END AS is_public

  FROM author_aff aa
  LEFT JOIN org_dim od
    ON od.org_id = aa.org_id
  WHERE
    -- keep only plausible ISO2 country codes after fallback
    (
      (aa.aff_country_code IS NOT NULL AND REGEXP_CONTAINS(aa.aff_country_code, r'^[A-Z]{2}$'))
      OR (aa.aff_country_code IS NULL AND od.legal_country_code IS NOT NULL AND REGEXP_CONTAINS(od.legal_country_code, r'^[A-Z]{2}$'))
    )
),

dedup AS (
  -- Deduplicate (author, country, org) to avoid double-counting repeated addresses
  SELECT DISTINCT
    pub_id,
    quarter,
    author_uid,
    country_code,
    org_id,
    is_public,
    is_private
  FROM author_aff_norm
  WHERE country_code IS NOT NULL
),

author_country AS (
  SELECT
    pub_id,
    quarter,
    author_uid,
    country_code,

    COUNT(*) AS n_aff_units,
    SUM(is_public) AS n_public_units,
    SUM(is_private) AS n_private_units
  FROM dedup
  GROUP BY pub_id, quarter, author_uid, country_code
)

SELECT
  pub_id,
  quarter,
  author_uid,
  country_code,
  n_aff_units,
  n_public_units,
  n_private_units
FROM author_country
