config {
  type: "table",
  schema: "rd_stage",
  name: "pub_author_country_stats",
  tags: ["stage", "phase4"],
  description: "Per-publication author×country stats for author-weighted country fractional counting. Ownership uses Surico gov definition; non-gov includes universities/nonprofits/companies/etc."
}

WITH core AS (
  SELECT
    pub_id,
    quarter,
    authors
  FROM ${ref("pub_core")}
  WHERE pub_id IS NOT NULL AND quarter IS NOT NULL
),

org_dim AS (
  SELECT
    o.id AS org_id,
    CASE WHEN o.legal_country_code = 'UK' THEN 'GB' ELSE o.legal_country_code END AS legal_country_code,
    o.types
  FROM `dimensions-ai.data_analytics.organizations` o
),

gov_dim AS (
  SELECT
    org_id,
    is_gov_surico,
    is_edu
  FROM ${ref("rd_ref", "org_gov_surico")}
),

author_aff AS (
  SELECT
    c.pub_id,
    c.quarter,
    COALESCE(a.researcher_id, CONCAT(c.pub_id, ':a', CAST(author_offset AS STRING))) AS author_uid,
    aff.grid_id AS org_id,
    CASE WHEN aff.country_code = 'UK' THEN 'GB' ELSE aff.country_code END AS aff_country_code
  FROM core c
  CROSS JOIN UNNEST(IFNULL(c.authors, [])) AS a WITH OFFSET AS author_offset
  LEFT JOIN UNNEST(IFNULL(a.affiliations_address, [])) AS aff
),

author_aff_norm AS (
  SELECT
    aa.pub_id,
    aa.quarter,
    aa.author_uid,
    aa.org_id,

    CASE
      WHEN aa.aff_country_code IS NOT NULL THEN aa.aff_country_code
      ELSE od.legal_country_code
    END AS country_code,

    -- Surico government flag
    IFNULL(gd.is_gov_surico, FALSE) AS is_gov,

    -- Education (university) flag
    IFNULL(gd.is_edu, FALSE) AS is_edu,

    -- Company flag (subcomponent of non-gov)
    ('Company' IN UNNEST(IFNULL(od.types, []))) AS is_company

  FROM author_aff aa
  LEFT JOIN org_dim od
    ON od.org_id = aa.org_id
  LEFT JOIN gov_dim gd
    ON gd.org_id = aa.org_id
  WHERE
    (
      (aa.aff_country_code IS NOT NULL AND REGEXP_CONTAINS(aa.aff_country_code, r'^[A-Z]{2}$'))
      OR (aa.aff_country_code IS NULL AND od.legal_country_code IS NOT NULL AND REGEXP_CONTAINS(od.legal_country_code, r'^[A-Z]{2}$'))
    )
),

dedup AS (
  SELECT DISTINCT
    pub_id,
    quarter,
    author_uid,
    country_code,
    org_id,
    is_gov,
    is_edu,
    is_company
  FROM author_aff_norm
  WHERE country_code IS NOT NULL
),

author_country AS (
  SELECT
    pub_id,
    quarter,
    author_uid,
    country_code,

    COUNT(*) AS n_aff_units,
    SUM(CASE WHEN is_gov THEN 1 ELSE 0 END) AS n_gov_units,
    SUM(CASE WHEN NOT is_gov THEN 1 ELSE 0 END) AS n_nongov_units,
    SUM(CASE WHEN is_edu THEN 1 ELSE 0 END) AS n_edu_units,
    SUM(CASE WHEN is_company THEN 1 ELSE 0 END) AS n_company_units

  FROM dedup
  GROUP BY pub_id, quarter, author_uid, country_code
)

SELECT
  pub_id,
  quarter,
  author_uid,
  country_code,
  n_aff_units,
  n_gov_units,
  n_nongov_units,
  n_edu_units,
  n_company_units
FROM author_country
