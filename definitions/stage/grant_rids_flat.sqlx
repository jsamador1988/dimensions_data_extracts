config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Flatten government grant RIDs (from researcher_ids and investigators), keeping FoR and start_dt."
}

WITH g AS (
  SELECT * FROM ${ref("grants_gov_core")}
),

rid1 AS (
  SELECT
    country_code, grant_id, start_dt, funding_usd, grant_for4,
    rid AS researcher_id
  FROM g, UNNEST(IFNULL(researcher_ids, [])) AS rid
  WHERE rid IS NOT NULL
),

rid2 AS (
  SELECT
    country_code, grant_id, start_dt, funding_usd, grant_for4,
    inv.researcher_id
  FROM g, UNNEST(IFNULL(investigators, [])) AS inv
  WHERE inv.researcher_id IS NOT NULL
)

SELECT DISTINCT * FROM (
  SELECT * FROM rid1
  UNION DISTINCT
  SELECT * FROM rid2
)
