config {
  type: "table",
  name: "grant_rids_flat",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Grant×researcher_id rows (scalar-only). Built from grants_gov_core; avoids UNION DISTINCT over ARRAY columns."
}

WITH g AS (
  SELECT
    country_code,
    grant_id,
    start_dt,
    researcher_ids,
    investigators
  FROM ${ref("grants_gov_core")}
  WHERE start_dt IS NOT NULL
),

rid1 AS (
  SELECT
    country_code,
    grant_id,
    start_dt,
    rid AS researcher_id
  FROM g
  CROSS JOIN UNNEST(IFNULL(researcher_ids, [])) AS rid
  WHERE rid IS NOT NULL
),

rid2 AS (
  SELECT
    country_code,
    grant_id,
    start_dt,
    inv.researcher_id AS researcher_id
  FROM g
  CROSS JOIN UNNEST(IFNULL(investigators, [])) AS inv
  WHERE inv.researcher_id IS NOT NULL
)

SELECT DISTINCT
  country_code,
  grant_id,
  start_dt,
  researcher_id
FROM (
  SELECT * FROM rid1
  UNION ALL
  SELECT * FROM rid2
)
