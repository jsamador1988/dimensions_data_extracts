config {
  type: "table",
  schema: "rd_stage",
  name: "patent_family_text_features",
  tags: ["stage", "patents"],
  description: "Phase-1 fuzzy features for patents at the family level (via representative patent): title tokens + top concepts. Restricted to anchored families in sample window."
}

WITH rep AS (
  SELECT family_id, rep_patent_id
  FROM ${ref("rd_stage", "patent_family_rep_doc")}
),

anchor AS (
  SELECT family_id, family_app_dt
  FROM ${ref("rd_stage", "patent_family_anchor")}
  WHERE family_app_dt >= DATE('${dataform.projectConfig.vars.sample_start}')
    AND family_app_dt <= DATE('${dataform.projectConfig.vars.sample_end}')
),

pat AS (
  SELECT
    p.id AS rep_patent_id,
    p.title AS pat_title,
    IFNULL(p.concepts, CAST([] AS ARRAY<STRUCT<concept STRING, relevance FLOAT64>>)) AS concept_src
  FROM `dimensions-ai.data_analytics.patents` p
)

SELECT
  r.family_id,
  r.rep_patent_id,
  p.pat_title,

  ARRAY(
    SELECT DISTINCT tok
    FROM UNNEST(
      SPLIT(
        REGEXP_REPLACE(LOWER(IFNULL(p.pat_title, "")), r"[^\p{L}\p{N}]+", " "),
        " "
      )
    ) AS tok
    WHERE tok IS NOT NULL
      AND tok != ""
      AND LENGTH(tok) >= CAST(${(dataform.projectConfig.vars.inst_fuzzy_min_title_token_len || 3)} AS INT64)
      AND NOT REGEXP_CONTAINS(tok, r"^\d+$")
      AND tok NOT IN UNNEST([
        "a","an","and","are","as","at","be","been","being","by","for","from","has","have","had",
        "in","into","is","it","its","of","on","or","that","the","their","this","to","was","were",
        "with","without","via","using","use","used","based","approach","approaches","method","methods",
        "study","analysis","data","model","models","system","systems","development","design","project",
        "research","program","programme","grant","funded","funding","proposal","investigation",
        "patent","invention","inventor","inventors"
      ])
  ) AS pat_title_tokens,

  ARRAY(
    SELECT concept
    FROM (
      SELECT
        LOWER(c.concept) AS concept,
        SAFE_CAST(c.relevance AS FLOAT64) AS rel
      FROM UNNEST(IFNULL(p.concept_src, CAST([] AS ARRAY<STRUCT<concept STRING, relevance FLOAT64>>))) AS c
      WHERE c.concept IS NOT NULL
        AND LOWER(c.concept) NOT IN UNNEST([
          "present invention","invention","device","devices","method","methods","system","systems",
          "apparatus","apparatuses","embodiment","embodiments"
        ])
    )
    ORDER BY rel DESC
    LIMIT CAST(${(dataform.projectConfig.vars.inst_fuzzy_max_concepts_patent || 20)} AS INT64)
  ) AS pat_concepts

FROM rep r
JOIN anchor a
  ON a.family_id = r.family_id
JOIN pat p
  ON p.rep_patent_id = r.rep_patent_id
