config {
  type: "table",
  name: "pub_citations_5y",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Per-publication 5-year citation counts using citation year in the citations array.",
  bigquery: {
    partitionBy: "RANGE_BUCKET(pub_year, GENERATE_ARRAY(1900, 2100, 1))",
    clusterBy: ["pub_id"]
  }
}

WITH core AS (
  SELECT
    pub_id,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year,
    citations
  FROM ${ref("rd_stage", "pub_core")}
  WHERE pub_id IS NOT NULL
    AND pub_dt_best IS NOT NULL
)

SELECT
  pub_id,
  pub_year,
  (
    SELECT COUNTIF(c.year IS NOT NULL AND c.year BETWEEN pub_year AND pub_year + 5)
    FROM UNNEST(IFNULL(citations, [])) AS c
  ) AS citations_5y
FROM core
