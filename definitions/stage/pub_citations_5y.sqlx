config {
  type: "table",
  schema: "rd_stage",
  tags: ["stage"],
  description: "Per-publication 5-year citation counts (year-based window) computed from publications.citations[].year."
}

WITH core AS (
  SELECT
    pub_id,
    EXTRACT(YEAR FROM pub_dt_best) AS pub_year
  FROM ${ref("pub_core")}
  WHERE pub_dt_best IS NOT NULL
),

cit_years AS (
  SELECT
    p.id AS pub_id,
    c.year AS citing_year
  FROM `dimensions-ai.data_analytics.publications` p
  JOIN core
    ON core.pub_id = p.id
  LEFT JOIN UNNEST(IFNULL(p.citations, ARRAY<STRUCT<id STRING, year INT64>>[])) AS c
)

SELECT
  c.pub_id,
  SUM(
    CASE
      WHEN cy.citing_year BETWEEN c.pub_year AND c.pub_year + 4 THEN 1
      ELSE 0
    END
  ) AS citations_5y
FROM core c
LEFT JOIN cit_years cy
  ON cy.pub_id = c.pub_id
GROUP BY c.pub_id
