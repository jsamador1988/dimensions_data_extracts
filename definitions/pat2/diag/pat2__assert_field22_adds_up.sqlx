config {
  type: "assertion",
  name: "pat2__assert_field22_adds_up",
  tags: ["pat2", "diag"],
  description: "Check: sum across Field22 equals overall totals (inventor-only) in each country-quarter."
}

WITH overall AS (
  SELECT
    country_code,
    quarter,
    pat_inv_total_ctq AS overall_total
  FROM ${ref("pat2__pat_country_quarter_4way")}
),

fieldsum AS (
  SELECT
    country_code,
    quarter,
    SUM(pat_inv_total_ctq) AS field_total
  FROM ${ref("pat2__pat_country_quarter_field22_long")}
  WHERE quarter >= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_start}'), QUARTER)
    AND quarter <= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_end}'),   QUARTER)
  GROUP BY 1,2
)

SELECT
  o.country_code,
  o.quarter,
  o.overall_total,
  f.field_total,
  (o.overall_total - f.field_total) AS diff
FROM overall o
JOIN fieldsum f
  USING (country_code, quarter)
WHERE ABS(o.overall_total - f.field_total) > 1e-6
