config {
  type: "table",
  schema: "rd_diag",
  name: "pat2__matched_grants_usd_coverage_ctq",
  tags: ["pat2", "diag"],
  description: "Diagnostics for matched grants: share with missing funding_usd, by grant start quarter."
}

WITH pg_union AS (
  SELECT DISTINCT family_id, country_code, grant_id
  FROM ${ref("pat2__pat_tier2_rid_matches")}
  UNION DISTINCT
  SELECT DISTINCT family_id, country_code, grant_id
  FROM ${ref("pat2__pat_tier2_inst_matches")}
),

pg_distinct_grants AS (
  SELECT DISTINCT country_code, grant_id
  FROM pg_union
),

g AS (
  SELECT
    country_code,
    grant_id,
    DATE_TRUNC(start_dt, QUARTER) AS quarter,
    funding_usd
  FROM ${ref("pat2__grants_gov_core")}
  WHERE start_dt IS NOT NULL
)

SELECT
  g.country_code,
  g.quarter,
  COUNT(DISTINCT g.grant_id) AS matched_grants_startqtr_ctq,
  COUNT(DISTINCT IF(g.funding_usd IS NULL, g.grant_id, NULL)) AS matched_grants_missing_usd_ctq,
  SAFE_DIVIDE(
    COUNT(DISTINCT IF(g.funding_usd IS NULL, g.grant_id, NULL)),
    COUNT(DISTINCT g.grant_id)
  ) AS share_missing_usd,
  SUM(IFNULL(g.funding_usd, 0.0)) AS matched_grants_amount_usd_startqtr_ctq
FROM pg_distinct_grants m
JOIN g
  ON g.country_code = m.country_code
 AND g.grant_id = m.grant_id
GROUP BY 1,2
ORDER BY 1,2
