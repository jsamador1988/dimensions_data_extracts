config {
  type: "assertion",
  name: "pat2__assert_4way_flags_exhaustive",
  tags: ["pat2", "diag"],
  description: "Check: 4-way split flags are mutually exclusive and exhaustive (sum to 1) for each family×country×quarter row."
}

SELECT
  family_id,
  country_code,
  quarter,
  (pat_public_public_flag + pat_public_private_flag + pat_private_private_flag + pat_unclassified_flag) AS flag_sum
FROM ${ref("pat2__patent_family_country_4way")}
WHERE (pat_public_public_flag + pat_public_private_flag + pat_private_private_flag + pat_unclassified_flag) != 1
