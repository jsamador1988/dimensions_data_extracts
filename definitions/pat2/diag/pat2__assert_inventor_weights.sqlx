config {
  type: "assertion",
  name: "pat2__assert_inventor_weights_sum_to_one",
  tags: ["pat2", "diag"],
  description: "Check: inventor weights sum to 1 within each patent family (over observed inventor countries)."
}

SELECT
  family_id,
  SUM(w_inv) AS sum_w_inv
FROM ${ref("pat2__patent_family_inventor_weights")}
GROUP BY family_id
HAVING ABS(sum_w_inv - 1.0) > 1e-6
