config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_anchor",
  tags: ["pat2", "stage"],
  description: "Family-level anchor date and application quarter, based on earliest doc-level date within sample window.",
  bigquery: { clusterBy: ["family_id"] }
}

SELECT
  family_id,
  MIN(doc_earliest_app_dt) AS family_app_dt,
  DATE_TRUNC(MIN(doc_earliest_app_dt), QUARTER) AS family_app_qtr
FROM ${ref("pat2__patent_family_base")}
GROUP BY family_id
