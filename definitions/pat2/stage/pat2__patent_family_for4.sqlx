config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_for4",
  tags: ["pat2", "stage"],
  description: "Family-level FoR4 code set (array of distinct 4-digit strings).",
  bigquery: { clusterBy: ["family_id"] }
}

WITH flat AS (
  SELECT
    p.family_id,
    for4 AS for4
  FROM ${ref("pat2__patent_family_base")} p
  CROSS JOIN UNNEST(IFNULL(p.for4_codes, [])) AS for4
  WHERE for4 IS NOT NULL
)

SELECT
  family_id,
  ARRAY_AGG(DISTINCT for4 ORDER BY for4) AS pat_for4
FROM flat
GROUP BY family_id
