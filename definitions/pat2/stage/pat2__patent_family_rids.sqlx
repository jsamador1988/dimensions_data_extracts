config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_rids",
  tags: ["pat2", "stage"],
  description: "Family×researcher_id (inventor) rows; used for RID-based grant matching.",
  bigquery: { clusterBy: ["family_id"] }
}

SELECT DISTINCT
  p.family_id,
  inv.researcher_id AS researcher_id
FROM ${ref("pat2__patent_family_base")} p
CROSS JOIN UNNEST(IFNULL(p.inventors, [])) AS inv
WHERE inv.researcher_id IS NOT NULL
