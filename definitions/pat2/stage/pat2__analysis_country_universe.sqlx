config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__analysis_country_universe",
  tags: ["pat2", "stage", "analysis"],
  description: "Patent v2 analysis country universe (OECD-focused)."
}

SELECT country_code
FROM UNNEST([
  -- Non-EU OECD
  'US','CA','AU','CH','GB',

  -- EU members that are OECD
  'AT','BE','CZ','DK','EE','FI','FR','DE','GR','HU','IE','IT','LV','LT','LU','NL',
  'PL','PT','SK','SI','ES','SE'
]) AS country_code
