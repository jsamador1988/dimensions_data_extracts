config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_assignee_flags",
  tags: ["pat2", "stage"],
  description: "Family×country assignee flags: has any assignee in that country; has any Surico-government assignee in that country. Uses rd_ref.org_gov_surico.",
  bigquery: { clusterBy: ["family_id", "country_code"] }
}

WITH fam_assg AS (
  SELECT DISTINCT
    p.family_id,
    ao AS org_id
  FROM ${ref("pat2__patent_family_base")} p
  CROSS JOIN UNNEST(IFNULL(p.assignee_orgs, [])) AS ao
  WHERE ao IS NOT NULL
),

orgs AS (
  SELECT
    org_id,
    country_code,
    is_gov_surico
  FROM ${ref("rd_ref", "org_gov_surico")}
),

joined AS (
  SELECT
    fa.family_id,
    o.country_code,
    o.is_gov_surico
  FROM fam_assg fa
  JOIN orgs o
    ON o.org_id = fa.org_id
  WHERE o.country_code IS NOT NULL
    AND REGEXP_CONTAINS(o.country_code, r'^[A-Z]{2}$')
    AND o.country_code NOT IN ('EP', 'WO')
)

SELECT
  family_id,
  country_code,
  1 AS dom_assg_flag,
  MAX(CASE WHEN is_gov_surico THEN 1 ELSE 0 END) AS dom_gov_assg_flag
FROM joined
GROUP BY family_id, country_code
