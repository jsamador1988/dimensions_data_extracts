config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_assignee_weights",
  tags: ["pat2", "stage"],
  description: "Family×country assignee weights (w_assg) + government share among assignees (w_assg_gov_surico). Uses rd_ref.org_gov_surico.",
  bigquery: { clusterBy: ["family_id", "country_code"] }
}

WITH fam_assg AS (
  SELECT DISTINCT
    p.family_id,
    ao AS org_id
  FROM ${ref("pat2__patent_family_base")} p
  CROSS JOIN UNNEST(IFNULL(p.assignee_orgs, [])) AS ao
  WHERE ao IS NOT NULL
),

orgs AS (
  SELECT
    org_id,
    country_code,
    is_gov_surico
  FROM ${ref("rd_ref", "org_gov_surico")}
),

joined AS (
  SELECT
    fa.family_id,
    o.country_code,
    o.org_id,
    o.is_gov_surico
  FROM fam_assg fa
  JOIN orgs o
    ON o.org_id = fa.org_id
  WHERE o.country_code IS NOT NULL
    AND REGEXP_CONTAINS(o.country_code, r'^[A-Z]{2}$')
    AND o.country_code NOT IN ('EP', 'WO')
),

by_cty AS (
  SELECT
    family_id,
    country_code,
    COUNT(DISTINCT org_id) AS n_assg_cty,
    COUNT(DISTINCT IF(is_gov_surico, org_id, NULL)) AS n_assg_gov_cty
  FROM joined
  GROUP BY family_id, country_code
),

tot AS (
  SELECT
    family_id,
    SUM(n_assg_cty) AS n_assg_total
  FROM by_cty
  GROUP BY family_id
)

SELECT
  b.family_id,
  b.country_code,
  SAFE_DIVIDE(b.n_assg_cty, t.n_assg_total) AS w_assg,
  SAFE_DIVIDE(b.n_assg_gov_cty, b.n_assg_cty) AS w_assg_gov_surico
FROM by_cty b
JOIN tot t USING (family_id)
WHERE t.n_assg_total > 0
