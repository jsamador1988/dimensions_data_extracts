config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_orgs",
  tags: ["pat2", "stage"],
  description: "Family×org_id rows (assignees + inventor affiliations via researchers.research_orgs). Used for institution-based grant matching.",
  bigquery: { clusterBy: ["family_id"] }
}

WITH assg AS (
  SELECT DISTINCT
    p.family_id,
    ao AS org_id
  FROM ${ref("pat2__patent_family_base")} p
  CROSS JOIN UNNEST(IFNULL(p.assignee_orgs, [])) AS ao
  WHERE ao IS NOT NULL
),

inv_org AS (
  SELECT DISTINCT
    fr.family_id,
    CAST(ro AS STRING) AS org_id
  FROM ${ref("pat2__patent_family_rids")} fr
  JOIN `dimensions-ai.data_analytics.researchers` r
    ON r.id = fr.researcher_id
  CROSS JOIN UNNEST(IFNULL(r.research_orgs, [])) AS ro
  WHERE ro IS NOT NULL
)

SELECT DISTINCT family_id, org_id
FROM (
  SELECT * FROM assg
  UNION ALL
  SELECT * FROM inv_org
)
WHERE org_id IS NOT NULL
