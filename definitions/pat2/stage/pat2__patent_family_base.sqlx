config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__patent_family_base",
  tags: ["pat2", "stage"],
  description: "Patent documents (Dimensions) trimmed to essentials; includes doc-level earliest app date + inventors/assignees + FoR4 codes + direct_grant_ids (patents.funding_details.grant_id). Partitioned by MONTH to avoid BigQuery 4000-partition limit.",
  bigquery: {
    partitionBy: "doc_earliest_app_month",
    clusterBy: ["family_id"]
  }
}

WITH raw AS (
  SELECT
    p.family_id,
    p.id AS patent_id,
    p.jurisdiction,

    COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', p.priority_date),
      CASE WHEN p.priority_year IS NOT NULL THEN DATE(SAFE_CAST(p.priority_year AS INT64), 1, 1) END
    ) AS priority_dt,

    COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', p.filing_date),
      CASE WHEN p.filing_year IS NOT NULL THEN DATE(SAFE_CAST(p.filing_year AS INT64), 1, 1) END
    ) AS filing_dt,

    p.inventors,
    IFNULL(p.assignee_orgs, []) AS assignee_orgs,

    -- Direct patent→grant acknowledgements in Dimensions (via patents.funding_details)
    ARRAY(
      SELECT DISTINCT f.grant_id
      FROM UNNEST(IFNULL(p.funding_details, [])) AS f
      WHERE f.grant_id IS NOT NULL
    ) AS direct_grant_ids,

    ARRAY(
      SELECT DISTINCT LPAD(REGEXP_EXTRACT(code, r'\d+'), 4, '0')
      FROM UNNEST(IFNULL(p.category_for.second_level.codes, [])) AS code
      WHERE code IS NOT NULL
        AND REGEXP_EXTRACT(code, r'\d+') IS NOT NULL
    ) AS for4_codes

  FROM `dimensions-ai.data_analytics.patents` p
  WHERE p.family_id IS NOT NULL
),

with_dt AS (
  SELECT
    family_id,
    patent_id,
    jurisdiction,
    inventors,
    assignee_orgs,
    direct_grant_ids,
    for4_codes,
    CASE
      WHEN priority_dt IS NOT NULL AND filing_dt IS NOT NULL THEN LEAST(priority_dt, filing_dt)
      ELSE COALESCE(priority_dt, filing_dt)
    END AS doc_earliest_app_dt
  FROM raw
),

final AS (
  SELECT
    *,
    DATE_TRUNC(doc_earliest_app_dt, MONTH) AS doc_earliest_app_month
  FROM with_dt
  WHERE doc_earliest_app_dt IS NOT NULL
    AND doc_earliest_app_dt BETWEEN DATE('${dataform.projectConfig.vars.sample_start}')
                               AND DATE('${dataform.projectConfig.vars.sample_end}')
)

SELECT * FROM final
