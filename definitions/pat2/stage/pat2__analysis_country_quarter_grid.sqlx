config {
  type: "table",
  schema: "rd_stage",
  name: "pat2__analysis_country_quarter_grid",
  tags: ["pat2", "stage", "analysis"],
  description: "Patent v2 balanced grid: analysis countries × quarters."
}

SELECT
  c.country_code,
  q.quarter
FROM ${ref("pat2__analysis_country_universe")} c
CROSS JOIN ${ref("pat2__analysis_quarters")} q
