config {
  type: "table",
  schema: "rd_ref",
  name: "pat2__field22_to_surico4",
  tags: ["pat2", "ref"],
  description: "Mapping from Field22 codes to Surico-style 4 broad research fields (plus OTHER and UNCLASSIFIED). Built for patent comparability exercises."
}

SELECT 'AGRICULTURE'  AS field22_code, 'HEALTHCARE_BIOTECH' AS surico4_code, 'Healthcare & Biotech' AS surico4_name UNION ALL
SELECT 'BIOLOGY',        'HEALTHCARE_BIOTECH',                'Healthcare & Biotech' UNION ALL
SELECT 'BIOMEDICAL',     'HEALTHCARE_BIOTECH',                'Healthcare & Biotech' UNION ALL
SELECT 'HEALTH',         'HEALTHCARE_BIOTECH',                'Healthcare & Biotech' UNION ALL

SELECT 'CHEMICAL',       'CHEMICALS',                         'Chemicals' UNION ALL

SELECT 'INFO_COMP',      'ELECTRONICS',                       'Electronics' UNION ALL

SELECT 'ENGINEERING',    'ENGINEERING',                       'Engineering' UNION ALL
SELECT 'BUILT_ENV',      'ENGINEERING',                       'Engineering' UNION ALL
SELECT 'PHYSICAL',       'ENGINEERING',                       'Engineering' UNION ALL
SELECT 'MATH',           'ENGINEERING',                       'Engineering' UNION ALL
SELECT 'EARTH',          'ENGINEERING',                       'Engineering' UNION ALL
SELECT 'ENVIRONMENT',    'ENGINEERING',                       'Engineering' UNION ALL

-- Everything else -> OTHER
SELECT 'COMMERCE',       'OTHER',                             'Other' UNION ALL
SELECT 'CREATIVE',       'OTHER',                             'Other' UNION ALL
SELECT 'ECON',           'OTHER',                             'Other' UNION ALL
SELECT 'EDUCATION',      'OTHER',                             'Other' UNION ALL
SELECT 'HISTORY',        'OTHER',                             'Other' UNION ALL
SELECT 'HUMAN_SOCIETY',  'OTHER',                             'Other' UNION ALL
SELECT 'LANGUAGE',       'OTHER',                             'Other' UNION ALL
SELECT 'LAW',            'OTHER',                             'Other' UNION ALL
SELECT 'PHILOSOPHY',     'OTHER',                             'Other' UNION ALL
SELECT 'PSYCHOLOGY',     'OTHER',                             'Other' UNION ALL

-- Field22 unclassified stays explicit
SELECT 'UNCLASSIFIED',   'UNCLASSIFIED',                      'Unclassified'
