config {
  type: "table",
  schema: "rd_ref",
  name: "pat2__gov_org_whitelist",
  tags: ["pat2", "ref"],
  description: "Whitelist of organizations treated as government (Surico-consistent) when org.types is incomplete. Start/end dates are optional."
}

SELECT 'DE' AS country_code, 'grid.424150.6' AS org_id, 'DFG' AS org_name,
       'Surico whitelist (DE)' AS note, CAST(NULL AS DATE) AS start_date, CAST(NULL AS DATE) AS end_date
UNION ALL
SELECT 'DE', 'grid.453068.c', 'AiF', 'Surico whitelist (DE)', CAST(NULL AS DATE), CAST(NULL AS DATE)
UNION ALL
SELECT 'DE', 'grid.453150.6', 'DBU', 'Surico whitelist (DE)', CAST(NULL AS DATE), CAST(NULL AS DATE)
