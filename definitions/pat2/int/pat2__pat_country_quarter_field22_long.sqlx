config {
  type: "table",
  schema: "rd_int",
  name: "pat2__pat_country_quarter_field22_long",
  tags: ["pat2", "int"],
  description: "Country×quarter×field22 patent aggregates with 4-way split (inventor-only, inventor×assignee, inventor×assignee×domestic filing). Includes explicit quarter filter for partition elimination."
}

SELECT
  country_code,
  quarter,
  field22_code,

  -- Totals
  SUM(w_inv_field) AS pat_inv_total_ctq,
  SUM(w_inv_assg_field) AS pat_inv_assg_total_ctq,
  SUM(w_inv_assg_file_field) AS pat_inv_assg_file_total_ctq,

  -- Split: inventor-only
  SUM(w_inv_field * pat_public_public_flag)   AS pat_inv_public_public_ctq,
  SUM(w_inv_field * pat_public_private_flag)  AS pat_inv_public_private_ctq,
  SUM(w_inv_field * pat_private_private_flag) AS pat_inv_private_private_ctq,
  SUM(w_inv_field * pat_unclassified_flag)    AS pat_inv_unclassified_ctq,

  -- Split: inventor×assignee
  SUM(w_inv_assg_field * pat_public_public_flag)   AS pat_inv_assg_public_public_ctq,
  SUM(w_inv_assg_field * pat_public_private_flag)  AS pat_inv_assg_public_private_ctq,
  SUM(w_inv_assg_field * pat_private_private_flag) AS pat_inv_assg_private_private_ctq,
  SUM(w_inv_assg_field * pat_unclassified_flag)    AS pat_inv_assg_unclassified_ctq,

  -- Split: inventor×assignee×domestic filing
  SUM(w_inv_assg_file_field * pat_public_public_flag)   AS pat_inv_assg_file_public_public_ctq,
  SUM(w_inv_assg_file_field * pat_public_private_flag)  AS pat_inv_assg_file_public_private_ctq,
  SUM(w_inv_assg_file_field * pat_private_private_flag) AS pat_inv_assg_file_private_private_ctq,
  SUM(w_inv_assg_file_field * pat_unclassified_flag)    AS pat_inv_assg_file_unclassified_ctq

FROM ${ref("pat2__patent_family_country_field22_4way")}
WHERE quarter >= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_start}'), QUARTER)
  AND quarter <= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_end}'),   QUARTER)
GROUP BY country_code, quarter, field22_code
