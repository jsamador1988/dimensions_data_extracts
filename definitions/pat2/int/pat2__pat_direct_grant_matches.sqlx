config {
  type: "table",
  schema: "rd_int",
  name: "pat2__pat_direct_grant_matches",
  tags: ["pat2", "int"],
  description: "Patent family×country direct government-grant linkages using Dimensions patents.funding_details.grant_id (extracted as direct_grant_ids in pat2__patent_family_base). Output is (family_id, country_code, grant_id) for gov grants where grant.start_dt <= family_app_dt.",
  bigquery: { clusterBy: ["family_id", "country_code"] }
}

WITH pat_grants AS (
  SELECT DISTINCT
    family_id,
    grant_id
  FROM ${ref("pat2__patent_family_base")}
  CROSS JOIN UNNEST(IFNULL(direct_grant_ids, [])) AS grant_id
  WHERE family_id IS NOT NULL
    AND grant_id IS NOT NULL
),

grants AS (
  SELECT
    country_code,
    grant_id,
    start_dt
  FROM ${ref("pat2__grants_gov_core")}
),

fam AS (
  SELECT
    family_id,
    family_app_dt
  FROM ${ref("pat2__patent_family_anchor")}
),

countries AS (
  SELECT DISTINCT country_code
  FROM ${ref("pat2__analysis_country_universe")}
)

SELECT DISTINCT
  pg.family_id,
  g.country_code,
  pg.grant_id
FROM pat_grants pg
JOIN grants g
  ON g.grant_id = pg.grant_id
JOIN fam f
  ON f.family_id = pg.family_id
JOIN countries c
  ON c.country_code = g.country_code
WHERE g.start_dt IS NOT NULL
  AND f.family_app_dt IS NOT NULL
  AND g.start_dt <= f.family_app_dt
