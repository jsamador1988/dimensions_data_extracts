config {
  type: "table",
  schema: "rd_int",
  name: "pat2__patent_family_country_4way",
  tags: ["pat2", "int"],
  description: "Core micro table (family×country×quarter) with Surico-style 4-way split flags and base fractional weights. This is the canonical micro source for patent aggregates.",
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code", "family_id"],
    requirePartitionFilter: true
  }
}

WITH base AS (
  SELECT
    f.family_id,
    f.country_code,
    f.family_app_qtr AS quarter,
    f.family_app_dt,
    f.w_inv,
    f.w_assg,
    f.w_assg_gov_surico,
    f.dom_filing
  FROM ${ref("pat2__patent_family_country_features")} f
  JOIN ${ref("pat2__analysis_country_universe")} c
    ON c.country_code = f.country_code
),

assg AS (
  SELECT
    family_id,
    country_code,
    dom_assg_flag,
    dom_gov_assg_flag
  FROM ${ref("pat2__patent_family_assignee_flags")}
),

fund AS (
  SELECT
    family_id,
    country_code,
    tier2_rid_flag,
    tier2_inst_flag,
    tier2_any_flag
  FROM ${ref("pat2__patent_family_country_funding_flags")}
)

SELECT
  b.family_id,
  b.country_code,
  b.quarter,
  b.family_app_dt,

  -- Base fractional weights
  b.w_inv,
  b.w_inv * b.w_assg AS w_inv_assg,
  b.w_inv * b.w_assg * b.dom_filing AS w_inv_assg_file,

  -- Inputs to classification
  COALESCE(a.dom_assg_flag, 0) AS dom_assg_flag,
  COALESCE(a.dom_gov_assg_flag, 0) AS dom_gov_assg_flag,
  COALESCE(f.tier2_rid_flag, 0) AS tier2_rid_flag,
  COALESCE(f.tier2_inst_flag, 0) AS tier2_inst_flag,
  COALESCE(f.tier2_any_flag, 0) AS tier2_any_flag,

  -- 4-way split (mutually exclusive, exhaustive)
  CASE WHEN COALESCE(a.dom_gov_assg_flag, 0) = 1 THEN 1 ELSE 0 END AS pat_public_public_flag,

  CASE
    WHEN COALESCE(a.dom_gov_assg_flag, 0) = 0
     AND COALESCE(a.dom_assg_flag, 0) = 1
     AND COALESCE(f.tier2_any_flag, 0) = 1
    THEN 1 ELSE 0
  END AS pat_public_private_flag,

  CASE
    WHEN COALESCE(a.dom_gov_assg_flag, 0) = 0
     AND COALESCE(a.dom_assg_flag, 0) = 1
     AND COALESCE(f.tier2_any_flag, 0) = 0
    THEN 1 ELSE 0
  END AS pat_private_private_flag,

  CASE
    WHEN COALESCE(a.dom_assg_flag, 0) = 0 THEN 1 ELSE 0
  END AS pat_unclassified_flag

FROM base b
LEFT JOIN assg a
  ON a.family_id = b.family_id AND a.country_code = b.country_code
LEFT JOIN fund f
  ON f.family_id = b.family_id AND f.country_code = b.country_code
