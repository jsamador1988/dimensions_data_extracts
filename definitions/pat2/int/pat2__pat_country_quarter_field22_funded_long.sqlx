config {
  type: "table",
  schema: "rd_int",
  name: "pat2__pat_country_quarter_field22_funded_long",
  tags: ["pat2", "int"],
  description: "Country×quarter×field22 funded patent series (Tier2-funded-any), with decomposition by ownership bucket. Inventor-only weights.",
}

SELECT
  country_code,
  quarter,
  field22_code,

  -- Funded-any (Tier2) totals
  SUM(w_inv_field * tier2_any_flag) AS pat_inv_funded_any_total_ctq,

  -- Funded-any decomposed by 4-way bucket
  SUM(w_inv_field * tier2_any_flag * pat_public_public_flag)   AS pat_inv_funded_any_public_public_ctq,
  SUM(w_inv_field * pat_public_private_flag)                   AS pat_inv_funded_any_public_private_ctq,
  SUM(w_inv_field * tier2_any_flag * pat_unclassified_flag)    AS pat_inv_funded_any_unclassified_ctq

FROM ${ref("pat2__patent_family_country_field22_4way")}
WHERE quarter >= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_start}'), QUARTER)
  AND quarter <= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_end}'),   QUARTER)
GROUP BY country_code, quarter, field22_code
