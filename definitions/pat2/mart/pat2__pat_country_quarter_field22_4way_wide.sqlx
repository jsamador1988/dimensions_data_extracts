config {
  type: "table",
  schema: "rd_mart",
  name: "pat2__pat_country_quarter_field22_4way_wide",
  tags: ["pat2", "mart"],
  description: "Balanced country×quarter patent panel by Field22 (inventor-only). Includes totals and 4-way split (owned=public_public; funded-private-owned=public_private; private-private; unclassified)."
}

WITH grid AS (
  SELECT country_code, quarter
  FROM ${ref("pat2__analysis_country_quarter_grid")}
),
f AS (
  SELECT *
  FROM ${ref("pat2__pat_country_quarter_field22_long")}
  WHERE quarter >= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_start}'), QUARTER)
    AND quarter <= DATE_TRUNC(DATE('${dataform.projectConfig.vars.sample_end}'),   QUARTER)
)

SELECT
  g.country_code,
  g.quarter,

  -- TOTALS
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'   THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'       THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'    THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'     THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'      THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'      THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'      THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'         THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'          THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'     THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'   THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'   THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'        THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'       THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY' THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'     THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'      THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'           THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'          THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'    THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'      THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'    THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED'  THEN f.pat_inv_total_ctq END), 0.0) AS pat_inv_total_UNCLASSIFIED_ctq,

  -- OWNED (public_public = domestic gov assignee)
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'   THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'       THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'    THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'     THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'      THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'      THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'      THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'         THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'          THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'     THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'   THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'   THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'        THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'       THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY' THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'     THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'      THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'           THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'          THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'    THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'      THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'    THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED'  THEN f.pat_inv_public_public_ctq END), 0.0) AS pat_inv_owned_UNCLASSIFIED_ctq,

  -- FUNDED PRIVATE-OWNED (public_private bucket)
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'   THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'       THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'    THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'     THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'      THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'      THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'      THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'         THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'          THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'     THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'   THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'   THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'        THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'       THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY' THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'     THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'      THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'           THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'          THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'    THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'      THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'    THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED'  THEN f.pat_inv_public_private_ctq END), 0.0) AS pat_inv_funded_private_owned_UNCLASSIFIED_ctq

FROM grid g
LEFT JOIN f
  ON f.country_code = g.country_code
 AND f.quarter = g.quarter
GROUP BY g.country_code, g.quarter
ORDER BY g.country_code, g.quarter
