config {
  type: "table",
  schema: "rd_mart",
  name: "pat2__pat_country_quarter_surico4_funded_wide",
  tags: ["pat2", "mart"],
  description: "Balanced country×quarter funded patent series by Surico4 (Tier2-funded-any totals + bucket decomposition). Inventor-only weights."
}

WITH grid AS (
  SELECT country_code, quarter
  FROM ${ref("pat2__analysis_country_quarter_grid")}
),
s AS (
  SELECT *
  FROM ${ref("pat2__pat_country_quarter_surico4_funded_long")}
)

SELECT
  g.country_code,
  g.quarter,

  -- funded_any_total
  COALESCE(SUM(CASE WHEN s.surico4_code='HEALTHCARE_BIOTECH' THEN s.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_HEALTHCARE_BIOTECH_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ELECTRONICS'        THEN s.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_ELECTRONICS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='CHEMICALS'          THEN s.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_CHEMICALS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ENGINEERING'        THEN s.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='OTHER'              THEN s.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_OTHER_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='UNCLASSIFIED'       THEN s.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_UNCLASSIFIED_ctq,

  -- funded_any_public_public
  COALESCE(SUM(CASE WHEN s.surico4_code='HEALTHCARE_BIOTECH' THEN s.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_HEALTHCARE_BIOTECH_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ELECTRONICS'        THEN s.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_ELECTRONICS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='CHEMICALS'          THEN s.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_CHEMICALS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ENGINEERING'        THEN s.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='OTHER'              THEN s.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_OTHER_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='UNCLASSIFIED'       THEN s.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_UNCLASSIFIED_ctq,

  -- funded_any_public_private
  COALESCE(SUM(CASE WHEN s.surico4_code='HEALTHCARE_BIOTECH' THEN s.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_HEALTHCARE_BIOTECH_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ELECTRONICS'        THEN s.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_ELECTRONICS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='CHEMICALS'          THEN s.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_CHEMICALS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ENGINEERING'        THEN s.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='OTHER'              THEN s.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_OTHER_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='UNCLASSIFIED'       THEN s.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_UNCLASSIFIED_ctq,

  -- funded_any_unclassified
  COALESCE(SUM(CASE WHEN s.surico4_code='HEALTHCARE_BIOTECH' THEN s.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_HEALTHCARE_BIOTECH_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ELECTRONICS'        THEN s.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_ELECTRONICS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='CHEMICALS'          THEN s.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_CHEMICALS_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='ENGINEERING'        THEN s.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='OTHER'              THEN s.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_OTHER_ctq,
  COALESCE(SUM(CASE WHEN s.surico4_code='UNCLASSIFIED'       THEN s.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_UNCLASSIFIED_ctq

FROM grid g
LEFT JOIN s
  ON s.country_code = g.country_code
 AND s.quarter = g.quarter
GROUP BY g.country_code, g.quarter
ORDER BY g.country_code, g.quarter
