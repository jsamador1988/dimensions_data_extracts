config {
  type: "table",
  schema: "rd_mart",
  name: "pat2__pat_country_quarter_field22_funded_wide",
  tags: ["pat2", "mart"],
  description: "Balanced country×quarter funded patent series by Field22 (Tier2-funded-any totals + bucket decomposition). Inventor-only weights."
}

WITH grid AS (
  SELECT country_code, quarter
  FROM ${ref("pat2__analysis_country_quarter_grid")}
),
f AS (
  SELECT *
  FROM ${ref("pat2__pat_country_quarter_field22_funded_long")}
)

SELECT
  g.country_code,
  g.quarter,

  -- funded_any_total
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'  THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'      THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'   THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'    THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'     THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'     THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'     THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'        THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'         THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'    THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'  THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'  THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'       THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'      THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY'THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'    THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'     THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'          THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'         THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'   THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'     THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'   THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED' THEN f.pat_inv_funded_any_total_ctq END), 0.0) AS pat_inv_funded_any_total_UNCLASSIFIED_ctq,

  -- funded_any_public_public
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'  THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'      THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'   THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'    THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'     THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'     THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'     THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'        THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'         THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'    THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'  THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'  THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'       THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'      THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY'THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'    THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'     THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'          THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'         THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'   THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'     THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'   THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED' THEN f.pat_inv_funded_any_public_public_ctq END), 0.0) AS pat_inv_funded_any_public_public_UNCLASSIFIED_ctq,

  -- funded_any_public_private
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'  THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'      THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'   THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'    THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'     THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'     THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'     THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'        THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'         THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'    THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'  THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'  THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'       THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'      THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY'THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'    THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'     THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'          THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'         THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'   THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'     THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'   THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED' THEN f.pat_inv_funded_any_public_private_ctq END), 0.0) AS pat_inv_funded_any_public_private_UNCLASSIFIED_ctq,

  -- funded_any_unclassified
  COALESCE(SUM(CASE WHEN f.field22_code='AGRICULTURE'  THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_AGRICULTURE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOLOGY'      THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_BIOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BIOMEDICAL'   THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_BIOMEDICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='BUILT_ENV'    THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_BUILT_ENV_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CHEMICAL'     THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_CHEMICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='COMMERCE'     THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_COMMERCE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='CREATIVE'     THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_CREATIVE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EARTH'        THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_EARTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ECON'         THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_ECON_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='EDUCATION'    THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_EDUCATION_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENGINEERING'  THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_ENGINEERING_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='ENVIRONMENT'  THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_ENVIRONMENT_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HEALTH'       THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_HEALTH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HISTORY'      THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_HISTORY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='HUMAN_SOCIETY'THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_HUMAN_SOCIETY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='INFO_COMP'    THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_INFO_COMP_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LANGUAGE'     THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_LANGUAGE_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='LAW'          THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_LAW_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='MATH'         THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_MATH_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHILOSOPHY'   THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_PHILOSOPHY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PHYSICAL'     THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_PHYSICAL_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='PSYCHOLOGY'   THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_PSYCHOLOGY_ctq,
  COALESCE(SUM(CASE WHEN f.field22_code='UNCLASSIFIED' THEN f.pat_inv_funded_any_unclassified_ctq END), 0.0) AS pat_inv_funded_any_unclassified_UNCLASSIFIED_ctq

FROM grid g
LEFT JOIN f
  ON f.country_code = g.country_code
 AND f.quarter = g.quarter
GROUP BY g.country_code, g.quarter
ORDER BY g.country_code, g.quarter
