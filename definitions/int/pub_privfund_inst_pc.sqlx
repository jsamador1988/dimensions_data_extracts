config {
  type: "table",
  schema: "rd_int",
  name: "pub_privfund_inst_pc",
  tags: ["int", "publications"],
  bigquery: {
    partitionBy: "quarter",
    clusterBy: ["country_code", "pub_id"]
  },
  description: "Publications matched to domestic NON-government-funded grants by recipient institution (publication affiliation org_id), with FoR overlap/Jaccard, configurable post-grant time window, and Phase-1 fuzzy hardening (concept + title token Jaccard). Restricted to private-produced publications (no gov affiliation in that country). Field failures may be overridden only by strong concept overlap."
}

WITH pairs_fuzzy_pass AS (
  SELECT
    pub_id,
    country_code,
    quarter,
    w_aff,
    grant_id,
    used_concept_override,
    jaccard_for4,
    jaccard_for2,
    jaccard_concepts,
    jaccard_title,
    fuzzy_score
  FROM ${ref("rd_int", "pub_inst_fuzzy_pairs")}
  WHERE NOT is_gov_surico
    AND rn_fuzzy_by_funder <= CAST(${(dataform.projectConfig.vars.inst_fuzzy_topk || 3)} AS INT64)
)

SELECT
  pub_id,
  country_code,
  quarter,
  w_aff,

  COUNT(DISTINCT grant_id) AS matched_grants,

  MAX(used_concept_override) AS used_concept_override,

  MAX(jaccard_for4) AS max_jaccard_for4,
  MAX(jaccard_for2) AS max_jaccard_for2,

  MAX(COALESCE(jaccard_concepts, 0.0)) AS max_concept_jaccard,
  MAX(COALESCE(jaccard_title, 0.0)) AS max_title_jaccard,
  MAX(COALESCE(fuzzy_score, 0.0)) AS max_fuzzy_score

FROM pairs_fuzzy_pass
GROUP BY pub_id, country_code, quarter, w_aff
HAVING matched_grants > 0
