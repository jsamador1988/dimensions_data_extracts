config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Quarterly patent measures: inventor, inventor×assignee, inventor×assignee×dom_filing, and public-owned (Gov assignee only)."
}

SELECT
  country_code,
  family_app_qtr AS quarter,

  SUM(w_inv) AS pat_inv_total_ctq,

  SUM(w_inv * w_assg) AS pat_inv_assg_total_ctq,

  SUM(w_inv * w_assg * dom_filing) AS pat_inv_assg_file_total_ctq,

  -- Gov-owned = inventor-weighted × gov-assignee-share
  SUM(w_inv * w_assg_gov) AS pat_public_owned_ctq

FROM ${ref("patent_family_country_features")}
GROUP BY country_code, quarter
