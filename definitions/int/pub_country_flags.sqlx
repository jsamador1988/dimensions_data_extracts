config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Publication×country flags and weights: affiliation weights + public/private production shares + country-specific gov/any funding flags from funder org types."
}

-- This table is keyed by (pub_id, quarter, country_code).
-- It starts from your stage weights (pub_country_weights) and adds funding flags by country
-- using publications.funder_orgs -> organizations (legal_country_code + types).

WITH w AS (
  SELECT
    pub_id,
    quarter,
    country_code,
    w_aff,
    w_public_prod,
    w_private_prod
  FROM ${ref("pub_country_weights")}
),

funder_flags AS (
  SELECT
    p.id AS pub_id,
    o.legal_country_code AS country_code,

    -- Government-funded (strict): at least one funder org in country_code with type Government
    MAX(
      CASE
        WHEN 'Government' IN UNNEST(IFNULL(o.types, CAST([] AS ARRAY<STRING>))) THEN 1
        ELSE 0
      END
    ) AS gov_funded_flag,

    -- Any-funded (broad, per your plan): Government OR Funder
    MAX(
      CASE
        WHEN EXISTS (
          SELECT 1
          FROM UNNEST(IFNULL(o.types, CAST([] AS ARRAY<STRING>))) t
          WHERE t IN ('Government', 'Funder')
        ) THEN 1
        ELSE 0
      END
    ) AS any_funded_flag

  FROM `dimensions-ai.data_analytics.publications` p
  LEFT JOIN UNNEST(IFNULL(p.funder_orgs, CAST([] AS ARRAY<STRING>))) AS funder_org_id
  LEFT JOIN `dimensions-ai.data_analytics.organizations` o
    ON o.id = funder_org_id
  WHERE funder_org_id IS NOT NULL
    AND o.legal_country_code IS NOT NULL
  GROUP BY pub_id, country_code
)

SELECT
  w.pub_id,
  w.quarter,
  w.country_code,
  w.w_aff,
  w.w_public_prod,
  w.w_private_prod,

  COALESCE(f.gov_funded_flag, 0) AS gov_funded_flag,
  COALESCE(f.any_funded_flag, 0) AS any_funded_flag,

  CASE WHEN w.w_private_prod > 0 THEN 1 ELSE 0 END AS private_prod_flag,
  CASE WHEN w.w_public_prod  > 0 THEN 1 ELSE 0 END AS public_prod_flag,

  CASE
    WHEN w.w_private_prod > 0 AND COALESCE(f.gov_funded_flag, 0) = 1 THEN 1
    ELSE 0
  END AS private_prod_gov_funded_flag

FROM w
LEFT JOIN funder_flags f
  ON f.pub_id = w.pub_id
 AND f.country_code = w.country_code
