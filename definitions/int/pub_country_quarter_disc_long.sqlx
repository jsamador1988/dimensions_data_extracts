config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Country×quarter×disc6 long table: sums field-long to 6 disciplines (total and top5)."
}

WITH fl AS (
  SELECT
    country_code,
    quarter,
    field22_code,
    pub_field_ctq,
    pub_field_top5_ctq
  FROM ${ref("pub_country_quarter_field_long")}
),

m AS (
  SELECT
    field22_code,
    disc6_code,
    disc6_name
  FROM ${ref("field22_to_disc6")}
)

SELECT
  fl.country_code,
  fl.quarter,
  m.disc6_code,
  ANY_VALUE(m.disc6_name) AS disc6_name,

  SUM(fl.pub_field_ctq) AS pub_disc_ctq,
  SUM(fl.pub_field_top5_ctq) AS pub_disc_top5_ctq

FROM fl
JOIN m USING (field22_code)
GROUP BY fl.country_code, fl.quarter, m.disc6_code
