config {
  type: "table",
  schema: "rd_int",
  name: "pub2_country_flags",
  tags: ["int", "pub2"],
  description: "Publication×country×quarter weights + Surico-4 bucket flags (single-bucket assignment per paper×country×quarter). Uses rd_ref.org_gov_surico for both production (public producer) and government funding (public funder)."
}

WITH w AS (
  SELECT
    pub_id,
    quarter,
    country_code,
    w_aff,
    w_public_prod,
    w_private_prod,
    w_unclassified
  FROM ${ref("rd_stage", "pub2_country_weights")}
  WHERE pub_id IS NOT NULL
    AND quarter IS NOT NULL
    AND country_code IS NOT NULL
),

pub_ids AS (
  SELECT DISTINCT pub_id FROM w
),

pubs AS (
  SELECT
    p.id AS pub_id,
    p.funder_orgs
  FROM `dimensions-ai.data_analytics.publications` p
  JOIN pub_ids u
    ON u.pub_id = p.id
),

funder_flat AS (
  SELECT
    pub_id,
    funder_org AS org_id
  FROM pubs
  CROSS JOIN UNNEST(IFNULL(funder_orgs, CAST([] AS ARRAY<STRING>))) AS funder_org
  WHERE funder_org IS NOT NULL
),

org_dim AS (
  SELECT
    org_id,
    country_code,
    is_gov_surico
  FROM ${ref("rd_ref", "org_gov_surico")}
),

funder_orgs AS (
  SELECT
    f.pub_id,
    od.country_code,
    od.is_gov_surico
  FROM funder_flat f
  JOIN org_dim od
    ON od.org_id = f.org_id
  WHERE od.country_code IS NOT NULL
    AND REGEXP_CONTAINS(od.country_code, r'^[A-Z]{2}$')
    AND od.country_code NOT IN ('EP', 'WO')
),

pub_country_funder_flags AS (
  SELECT
    pub_id,
    country_code,
    1 AS funded_any_flag,
    MAX(CAST(is_gov_surico AS INT64)) AS gov_funded_flag
  FROM funder_orgs
  GROUP BY pub_id, country_code
),

joined AS (
  SELECT
    w.pub_id,
    w.quarter,
    w.country_code,
    COALESCE(w.w_aff, 0.0) AS w_aff,
    COALESCE(w.w_public_prod, 0.0) AS w_public_prod,
    COALESCE(w.w_private_prod, 0.0) AS w_private_prod,
    COALESCE(w.w_unclassified, 0.0) AS w_unclassified,
    COALESCE(f.funded_any_flag, 0) AS funded_any_flag,
    COALESCE(f.gov_funded_flag, 0) AS gov_funded_flag
  FROM w
  LEFT JOIN pub_country_funder_flags f
    ON f.pub_id = w.pub_id
   AND f.country_code = w.country_code
)

SELECT
  pub_id,
  quarter,
  country_code,

  -- raw weights (from country weights stage)
  w_aff,
  w_public_prod,
  w_private_prod,
  w_unclassified,

  -- “production exists” flags (mutually exclusive by construction of pub2_country_weights)
  CAST(w_public_prod > 0 AS INT64) AS public_prod_flag,
  CAST(w_private_prod > 0 AS INT64) AS private_prod_flag,
  CAST(w_unclassified > 0 AS INT64) AS prod_unclassified_flag,

  -- funding flags (domestic by funder org country)
  funded_any_flag,
  gov_funded_flag,

  -- ---------------------------------------------------------
  -- Surico-4 bucket flags (mutually exclusive, exhaustive)
  --   public_public: ANY public production exists in that country-quarter
  --   public_private: NOT public_public AND gov-funded AND private production exists
  --   private_private: NOT public_public AND NOT gov-funded AND private production exists
  --   unclassified: production cannot be classified (w_unclassified)
  -- ---------------------------------------------------------
  CAST(w_public_prod > 0 AS INT64) AS owned_flag,

  CAST(
    (w_public_prod = 0)
    AND (w_unclassified = 0)
    AND (gov_funded_flag = 1)
    AND (w_private_prod > 0)
    AS INT64
  ) AS funded_private_owned_flag,

  CAST(
    (w_public_prod = 0)
    AND (w_unclassified = 0)
    AND (gov_funded_flag = 0)
    AND (w_private_prod > 0)
    AS INT64
  ) AS private_private_flag,

  CAST(w_unclassified > 0 AS INT64) AS unclassified_flag,

  -- eng-weight contributions (sum to w_aff)
  w_aff AS total_eng,

  IF(w_public_prod > 0, w_aff, 0.0) AS owned_eng,

  IF((w_public_prod = 0) AND (w_unclassified = 0) AND (gov_funded_flag = 1) AND (w_private_prod > 0), w_aff, 0.0) AS funded_private_owned_eng,

  IF((w_public_prod = 0) AND (w_unclassified = 0) AND (gov_funded_flag = 0) AND (w_private_prod > 0), w_aff, 0.0) AS private_private_eng,

  IF(w_unclassified > 0, w_aff, 0.0) AS unclassified_eng,

  -- optional “any gov-funded” series (regardless of ownership bucket)
  IF(gov_funded_flag = 1, w_aff, 0.0) AS funded_any_eng
FROM joined
