config {
  type: "table",
  schema: "rd_int",
  tags: ["pub2", "int", "publications"],
  description: "Adds gov_funded_flag/any_funded_flag to pub2 country weights (still using funder_orgs)."
}

WITH weights AS (
  SELECT * FROM ${ref("pub2_country_weights")}
),

funder_flags AS (
  SELECT
    p.id AS pub_id,
    LOGICAL_OR('Government' IN UNNEST(IFNULL(o.types, ARRAY<STRING>[]))) AS gov_funded_flag,
    COUNT(DISTINCT funder_org_id) > 0 AS any_funded_flag
  FROM `dimensions-ai.data_analytics.publications` p
  LEFT JOIN UNNEST(IFNULL(p.funder_orgs, ARRAY<STRING>[])) AS funder_org_id
  LEFT JOIN `dimensions-ai.data_analytics.organizations` o
    ON o.id = funder_org_id
  GROUP BY pub_id
)

SELECT
  w.*,
  IFNULL(ff.gov_funded_flag, FALSE) AS gov_funded_flag,
  IFNULL(ff.any_funded_flag, FALSE) AS any_funded_flag
FROM weights w
LEFT JOIN funder_flags ff USING (pub_id)
