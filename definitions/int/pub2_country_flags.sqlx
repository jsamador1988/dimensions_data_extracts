config {
  type: "table",
  name: "pub2_country_flags",
  schema: "rd_int",
  tags: ["int", "phase4", "pub2"],
  description: "pub2 country weights + publication funding flags (gov_funded_flag, any_funded_flag) from Dimensions funder_orgs."
}

WITH w AS (
  SELECT * FROM ${ref("pub2_country_weights")}
),

pub_funding AS (
  SELECT
    p.id AS pub_id,
    -- any funder org on the publication
    COUNT(DISTINCT funder_org_id) > 0 AS any_funded_flag,
    -- government funder if funder org has 'Government' in organization types
    LOGICAL_OR('Government' IN UNNEST(IFNULL(o.types, ARRAY<STRING>[]))) AS gov_funded_flag
  FROM `dimensions-ai.data_analytics.publications` p
  LEFT JOIN UNNEST(IFNULL(p.funder_orgs, ARRAY<STRING>[])) AS funder_org_id
  LEFT JOIN `dimensions-ai.data_analytics.organizations` o
    ON o.id = funder_org_id
  GROUP BY pub_id
)

SELECT
  w.*,
  IFNULL(f.any_funded_flag, FALSE) AS any_funded_flag,
  IFNULL(f.gov_funded_flag, FALSE) AS gov_funded_flag
FROM w
LEFT JOIN pub_funding f
  USING (pub_id)
