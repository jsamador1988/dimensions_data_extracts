config {
  type: "table",
  schema: "rd_int",
  name: "patent_family_country_weights",
  tags: ["int"],
  description: "Patent family×country fractional weights: inventor country (w_inv), assignee legal country (w_assg), and government-assignee share (w_assg_gov_surico). Includes family-level missingness diagnostics repeated on each row."
}

WITH pbase AS (
  SELECT
    family_id,
    inventors,
    assignee_orgs
  FROM `dimensions-ai.data_analytics.patents`
  WHERE family_id IS NOT NULL
),

/* -----------------------
   Inventor country weights
   ----------------------- */

inv_totals AS (
  SELECT
    p.family_id,
    IFNULL(ARRAY_LENGTH(p.inventors), 0) AS n_inv_total_raw,
    COUNTIF(inv.address.country IS NOT NULL AND inv.address.country != '') AS n_inv_obs
  FROM pbase p
  LEFT JOIN UNNEST(p.inventors) AS inv
  GROUP BY p.family_id, n_inv_total_raw
),

inv_by_country AS (
  SELECT
    p.family_id,
    CASE WHEN UPPER(inv.address.country) = 'UK' THEN 'GB' ELSE UPPER(inv.address.country) END AS country_code,
    COUNT(*) AS n_inv_country
  FROM pbase p
  JOIN UNNEST(p.inventors) AS inv
  WHERE inv.address.country IS NOT NULL
    AND inv.address.country != ''
    AND LENGTH(UPPER(inv.address.country)) = 2
    AND UPPER(inv.address.country) NOT IN ('EP', 'WO')
  GROUP BY p.family_id, country_code
),

/* -----------------------
   Assignee country weights
   ----------------------- */

assg_flat AS (
  SELECT
    p.family_id,
    org_id
  FROM pbase p
  JOIN UNNEST(IFNULL(p.assignee_orgs, CAST([] AS ARRAY<STRING>))) AS org_id
  WHERE org_id IS NOT NULL
),

org_dim AS (
  SELECT
    org_id,
    country_code,
    is_gov_surico
  FROM ${ref("rd_ref", "org_gov_surico")}
),

assg_enriched AS (
  SELECT
    a.family_id,
    a.org_id,
    od.country_code,
    IFNULL(CAST(od.is_gov_surico AS INT64), 0) AS is_gov
  FROM assg_flat a
  LEFT JOIN org_dim od
    ON od.org_id = a.org_id
),

assg_totals AS (
  SELECT
    family_id,
    COUNT(DISTINCT org_id) AS n_assg_total_raw,
    COUNT(DISTINCT IF(country_code IS NOT NULL AND country_code != '', org_id, NULL)) AS n_assg_obs
  FROM assg_enriched
  GROUP BY family_id
),

assg_by_country AS (
  SELECT
    family_id,
    country_code,
    COUNT(DISTINCT org_id) AS n_assg_country,
    COUNT(DISTINCT IF(is_gov = 1, org_id, NULL)) AS n_assg_gov_country
  FROM assg_enriched
  WHERE country_code IS NOT NULL
    AND country_code != ''
    AND LENGTH(country_code) = 2
    AND country_code NOT IN ('EP', 'WO')
  GROUP BY family_id, country_code
),

/* -----------------------
   Union of countries observed
   ----------------------- */

country_universe AS (
  SELECT DISTINCT family_id, country_code FROM inv_by_country
  UNION DISTINCT
  SELECT DISTINCT family_id, country_code FROM assg_by_country
),

/* -----------------------
   Combine + compute weights
   ----------------------- */

combined AS (
  SELECT
    u.family_id,
    u.country_code,

    -- inventor counts
    it.n_inv_total_raw,
    it.n_inv_obs,
    COALESCE(ic.n_inv_country, 0) AS n_inv_country,

    -- assignee counts
    ast.n_assg_total_raw,
    ast.n_assg_obs,
    COALESCE(ac.n_assg_country, 0) AS n_assg_country,
    COALESCE(ac.n_assg_gov_country, 0) AS n_assg_gov_country

  FROM country_universe u
  LEFT JOIN inv_totals it
    ON it.family_id = u.family_id
  LEFT JOIN inv_by_country ic
    ON ic.family_id = u.family_id
   AND ic.country_code = u.country_code
  LEFT JOIN assg_totals ast
    ON ast.family_id = u.family_id
  LEFT JOIN assg_by_country ac
    ON ac.family_id = u.family_id
   AND ac.country_code = u.country_code
)

SELECT
  family_id,
  country_code,

  -- inventor weight (fraction of inventor addresses in this country)
  SAFE_DIVIDE(n_inv_country, NULLIF(n_inv_obs, 0)) AS w_inv,

  -- assignee weight (fraction of assignee orgs in this country)
  SAFE_DIVIDE(n_assg_country, NULLIF(n_assg_obs, 0)) AS w_assg,

  -- share of assignees in this country that are Surico-government
  SAFE_DIVIDE(n_assg_gov_country, NULLIF(n_assg_country, 0)) AS w_assg_gov_surico,

  -- diagnostics repeated
  n_inv_total_raw,
  n_inv_obs,
  n_assg_total_raw,
  n_assg_obs

FROM combined
WHERE (n_inv_obs > 0 OR n_assg_obs > 0)
