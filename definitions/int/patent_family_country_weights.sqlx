config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Patent family×country fractional weights: inventor country (w_inv), assignee legal country (w_assg), and government-assignee share (w_assg_gov). Includes family-level missingness diagnostics repeated on each row."
}

WITH pbase AS (
  SELECT
    family_id,
    inventors,
    assignee_orgs
  FROM `dimensions-ai.data_analytics.patents`
  WHERE family_id IS NOT NULL
),

/* -----------------------
   Inventor country weights
   ----------------------- */

inv_totals AS (
  SELECT
    p.family_id,
    IFNULL(ARRAY_LENGTH(p.inventors), 0) AS n_inv_total_raw,
    COUNTIF(inv.address.country IS NOT NULL AND inv.address.country != '') AS n_inv_obs
  FROM pbase p
  LEFT JOIN UNNEST(p.inventors) AS inv
  GROUP BY p.family_id, n_inv_total_raw
),

inv_by_country AS (
  SELECT
    p.family_id,
    UPPER(inv.address.country) AS country_code,
    COUNT(*) AS n_inv_country
  FROM pbase p
  JOIN UNNEST(p.inventors) AS inv
  WHERE inv.address.country IS NOT NULL
    AND inv.address.country != ''
    AND LENGTH(UPPER(inv.address.country)) = 2
  GROUP BY p.family_id, country_code
),

/* -----------------------
   Assignee country weights
   ----------------------- */

assg_flat AS (
  SELECT
    p.family_id,
    org_id
  FROM pbase p
  JOIN UNNEST(IFNULL(p.assignee_orgs, CAST([] AS ARRAY<STRING>))) AS org_id
  WHERE org_id IS NOT NULL
),

assg_enriched AS (
  SELECT
    a.family_id,
    a.org_id,
    o.legal_country_code AS country_code,
    o.types AS org_types,
    CASE
      WHEN 'Government' IN UNNEST(IFNULL(o.types, CAST([] AS ARRAY<STRING>))) THEN 1
      WHEN o.legal_country_code = 'DE'
           AND wd.org_id IS NOT NULL THEN 1
      ELSE 0
    END AS is_gov
  FROM assg_flat a
  LEFT JOIN `dimensions-ai.data_analytics.organizations` o
    ON o.id = a.org_id
  LEFT JOIN ${ref("whitelist_de")} wd
    ON wd.org_id = a.org_id
),

assg_totals AS (
  SELECT
    family_id,
    COUNT(DISTINCT org_id) AS n_assg_total_raw,
    COUNT(DISTINCT IF(country_code IS NOT NULL AND country_code != '', org_id, NULL)) AS n_assg_obs
  FROM assg_enriched
  GROUP BY family_id
),

assg_by_country AS (
  SELECT
    family_id,
    country_code,
    COUNT(DISTINCT org_id) AS n_assg_country,
    COUNT(DISTINCT IF(is_gov = 1, org_id, NULL)) AS n_assg_gov_country
  FROM assg_enriched
  WHERE country_code IS NOT NULL
    AND country_code != ''
    AND LENGTH(country_code) = 2
  GROUP BY family_id, country_code
),

/* -----------------------
   Union of countries observed
   ----------------------- */

country_universe AS (
  SELECT DISTINCT family_id, country_code FROM inv_by_country
  UNION DISTINCT
  SELECT DISTINCT family_id, country_code FROM assg_by_country
),

/* -----------------------
   Combine + compute weights
   ----------------------- */

combined AS (
  SELECT
    u.family_id,
    u.country_code,

    -- inventor counts
    it.n_inv_total_raw,
    it.n_inv_obs,
    COALESCE(ic.n_inv_country, 0) AS n_inv_country,

    -- assignee counts
    ast.n_assg_total_raw,
    ast.n_assg_obs,
    COALESCE(ac.n_assg_country, 0) AS n_assg_country,
    COALESCE(ac.n_assg_gov_country, 0) AS n_assg_gov_country

  FROM country_universe u
  LEFT JOIN inv_totals it
    ON it.family_id = u.family_id
  LEFT JOIN inv_by_country ic
    ON ic.family_id = u.family_id
   AND ic.country_code = u.country_code
  LEFT JOIN assg_totals ast
    ON ast.family_id = u.family_id
  LEFT JOIN assg_by_country ac
    ON ac.family_id = u.family_id
   AND ac.country_code = u.country_code
)

SELECT
  family_id,
  country_code,

  -- Fractional inventor weight (normalized over OBSERVED inventor countries)
  SAFE_DIVIDE(n_inv_country, NULLIF(n_inv_obs, 0)) AS w_inv,

  -- Fractional assignee weight (normalized over OBSERVED assignee legal countries)
  SAFE_DIVIDE(n_assg_country, NULLIF(n_assg_obs, 0)) AS w_assg,

  -- Government-owned assignee share (STRICT government, normalized over OBSERVED assignee legal countries)
  SAFE_DIVIDE(n_assg_gov_country, NULLIF(n_assg_obs, 0)) AS w_assg_gov,

  -- Family-level missingness diagnostics (repeated per row)
  CASE
    WHEN n_inv_total_raw > 0 THEN 1 - SAFE_DIVIDE(n_inv_obs, n_inv_total_raw)
    ELSE NULL
  END AS share_missing_inv_country,

  CASE
    WHEN n_assg_total_raw > 0 THEN 1 - SAFE_DIVIDE(n_assg_obs, n_assg_total_raw)
    ELSE NULL
  END AS share_missing_assg_country,

  n_inv_total_raw,
  n_inv_obs,
  n_assg_total_raw,
  n_assg_obs
FROM combined
