config {
  type: "table",
  schema: "rd_int",
  tags: ["int", "phase4"],
  description: "Country×quarter publication measures: total, top5 (field-weighted), breakthrough (field-weighted, eligible-only), produced splits where public=Surico government; private=non-government; plus company subset."
}

WITH cw AS (
  SELECT
    pub_id,
    quarter,
    country_code,
    w_aff,
    w_public_prod,
    w_private_prod,
    w_company_prod
  FROM ${ref("pub_country_weights")}
),

-- Collapse paper×field flags to paper-level shares (field-weighted)
pf AS (
  SELECT
    pub_id,
    SUM(w_field * is_top5_field) AS top5_share,
    SUM(w_field * is_breakthrough_field) AS break_share,
    MAX(break_eligible) AS break_eligible
  FROM ${ref("pub_field_flags")}
  GROUP BY pub_id
),

joined AS (
  SELECT
    cw.country_code,
    cw.quarter,
    cw.w_aff,
    cw.w_public_prod,
    cw.w_private_prod,
    cw.w_company_prod,
    IFNULL(pf.top5_share, 0) AS top5_share,
    IFNULL(pf.break_share, 0) AS break_share,
    IFNULL(pf.break_eligible, 0) AS break_eligible
  FROM cw
  LEFT JOIN pf USING (pub_id)
)

SELECT
  country_code,
  quarter,

  -- total publications (author-weighted country fractional)
  SUM(w_aff) AS pub_total_ctq,

  -- top5 journals (field-weighted; then country-weighted)
  SUM(w_aff * top5_share) AS pub_top5_ctq,

  -- breakthrough (eligible-only)
  SUM(w_aff * break_share * break_eligible) AS pub_break_ctq,

  -- diagnostics: how much pub mass is eligible for breakthrough window
  SUM(w_aff * break_eligible) AS pub_break_eligible_weight_ctq,

  -- produced series:
  -- public = Surico government only
  SUM(w_public_prod) AS pub_public_produced_ctq,

  -- private = NON-government (includes universities, nonprofits, hospitals, companies, etc.)
  SUM(w_private_prod) AS pub_private_produced_ctq,

  -- company subset (component of non-government)
  SUM(w_company_prod) AS pub_company_produced_ctq

FROM joined
GROUP BY country_code, quarter
