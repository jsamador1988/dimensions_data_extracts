config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Country×quarter×field22 long table for publication totals and top5 totals (both fractional)."
}

WITH cw AS (
  SELECT
    pub_id,
    quarter,
    country_code,
    w_aff
  FROM ${ref("pub_country_weights")}
),

ff AS (
  SELECT
    pub_id,
    field22_code,
    w_field,
    is_top5_field
  FROM ${ref("pub_field_flags")}
)

SELECT
  cw.country_code,
  cw.quarter,
  ff.field22_code,

  SUM(cw.w_aff * ff.w_field) AS pub_field_ctq,
  SUM(cw.w_aff * ff.w_field * ff.is_top5_field) AS pub_field_top5_ctq

FROM cw
JOIN ff USING (pub_id)
GROUP BY cw.country_code, cw.quarter, ff.field22_code
