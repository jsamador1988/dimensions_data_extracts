config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Field-level quarterly publication series (long): (country, quarter, field22_code). Includes top5 within-field."
}

WITH core AS (
  SELECT pub_id, quarter
  FROM ${ref("pub_core")}
),

cw AS (
  SELECT pub_id, country_code, w_aff
  FROM ${ref("pub_country_weights")}
),

fw AS (
  SELECT pub_id, field22_code, w_field
  FROM ${ref("pub_field_weights")}
),

flags AS (
  SELECT pub_id, field22_code, is_top5_field, is_breakthrough_field
  FROM ${ref("pub_field_flags")}
),

paper_country_field AS (
  SELECT
    c.pub_id,
    c.quarter,
    cw.country_code,
    fw.field22_code,
    (cw.w_aff * fw.w_field) AS w_country_field,
    COALESCE(fl.is_top5_field, 0) AS is_top5_field,
    COALESCE(fl.is_breakthrough_field, 0) AS is_break_field
  FROM core c
  JOIN cw USING (pub_id)
  JOIN fw USING (pub_id)
  LEFT JOIN flags fl
    ON fl.pub_id = c.pub_id
   AND fl.field22_code = fw.field22_code
)

SELECT
  country_code,
  quarter,
  field22_code,
  SUM(w_country_field) AS pub_field_ctq,
  SUM(w_country_field * is_top5_field) AS pub_field_top5_ctq,
  SUM(w_country_field * is_break_field) AS pub_field_break_ctq
FROM paper_country_field
GROUP BY country_code, quarter, field22_code
