config {
  type: "table",
  schema: "rd_int",
  name: "pub_country_quarter_measures",
  tags: ["int", "publications"],
  description: "Country x quarter publication innovation time series: domestic totals, government-produced component, overlapping government-funding proxies (direct / researcher / institution), mutually-exclusive government-funding tiers (direct / RID-only / institution-only / any), non-government domestic-funder analogs (direct / researcher / institution), private->government citation-based measures, external national source linkage, and whole-count (unweighted) variants for all decomposition columns."
}

WITH base AS (
  SELECT
    country_code,
    quarter,
    -- Fractional weighted counts
    SUM(w_aff) AS pub_total_ctq,
    SUM(w_public_prod) AS pub_gov_owned_ctq,
    -- Private-only denominator (no gov affiliation for that country on that publication)
    SUM(IF(w_public_prod = 0, w_aff, 0.0)) AS pub_private_total_ctq,
    -- Whole counts (each publication counted once regardless of fractional weight)
    COUNT(DISTINCT pub_id) AS pub_total_whole_ctq,
    COUNT(DISTINCT IF(w_public_prod > 0, pub_id, NULL)) AS pub_gov_owned_whole_ctq,
    COUNT(DISTINCT IF(w_public_prod = 0, pub_id, NULL)) AS pub_private_total_whole_ctq
  FROM ${ref("rd_int", "pub_pub_country_base")}
  GROUP BY country_code, quarter
),

-- Overlapping government funder proxies (subset of private-only)
gov_direct AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_govfund_direct_ctq,
    COUNT(DISTINCT pub_id) AS pub_govfund_direct_whole_ctq
  FROM ${ref("rd_int", "pub_govfund_direct_pc")}
  GROUP BY country_code, quarter
),

gov_rid AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_govfund_rid_ctq,
    COUNT(DISTINCT pub_id) AS pub_govfund_rid_whole_ctq
  FROM ${ref("rd_int", "pub_govfund_rid_pc")}
  GROUP BY country_code, quarter
),

gov_inst AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_govfund_inst_ctq,
    COUNT(DISTINCT pub_id) AS pub_govfund_inst_whole_ctq
  FROM ${ref("rd_int", "pub_govfund_inst_pc")}
  GROUP BY country_code, quarter
),

-- Mutually-exclusive government funder tiers (subset of private-only)
gov_direct_excl AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_govfund_direct_excl_ctq,
    COUNT(DISTINCT pub_id) AS pub_govfund_direct_excl_whole_ctq
  FROM ${ref("rd_int", "pub_govfund_direct_pc")}
  GROUP BY country_code, quarter
),

gov_rid_only_excl AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_govfund_rid_only_excl_ctq,
    COUNT(DISTINCT pub_id) AS pub_govfund_rid_only_excl_whole_ctq
  FROM ${ref("rd_int", "pub_govfund_rid_only_pc")}
  GROUP BY country_code, quarter
),

gov_inst_only_excl AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_govfund_inst_only_excl_ctq,
    COUNT(DISTINCT pub_id) AS pub_govfund_inst_only_excl_whole_ctq
  FROM ${ref("rd_int", "pub_govfund_inst_only_pc")}
  GROUP BY country_code, quarter
),

-- Non-government domestic funder analogs (subset of private-only)
priv_direct AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_privfund_direct_ctq,
    COUNT(DISTINCT pub_id) AS pub_privfund_direct_whole_ctq
  FROM ${ref("rd_int", "pub_privfund_direct_pc")}
  GROUP BY country_code, quarter
),

priv_rid AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_privfund_rid_ctq,
    COUNT(DISTINCT pub_id) AS pub_privfund_rid_whole_ctq
  FROM ${ref("rd_int", "pub_privfund_rid_pc")}
  GROUP BY country_code, quarter
),

priv_inst AS (
  SELECT country_code, quarter,
    SUM(w_aff) AS pub_privfund_inst_ctq,
    COUNT(DISTINCT pub_id) AS pub_privfund_inst_whole_ctq
  FROM ${ref("rd_int", "pub_privfund_inst_pc")}
  GROUP BY country_code, quarter
),

-- Private documents citing government-produced research
cite AS (
  SELECT
    country_code,
    quarter,
    pub_private_with_cites_ctq,
    pub_private_cite_gov_raw_ctq,
    pub_private_cite_gov_norm_ctq,
    -- Binary citation decomposition
    pub_private_citing_gov_ctq,
    pub_private_not_citing_gov_ctq,
    -- Whole count variants from citation table
    pub_private_citing_gov_whole_ctq,
    pub_private_not_citing_gov_whole_ctq,
    pub_private_with_cites_whole_ctq
  FROM ${ref("rd_int", "pub_private_cite_gov_ctq")}
),

-- External national source: government-funded publications (Cristin, KAKEN, NWO)
-- Stubbed out: external_no_cristin_linkage / kaken / nwo tables are not uploaded
-- to BQ.  This empty CTE prevents cascade failure.  Re-enable ${ref} once
-- external tables are uploaded.
gov_ext AS (
  SELECT
    CAST(NULL AS STRING) AS country_code,
    CAST(NULL AS DATE) AS quarter,
    CAST(NULL AS FLOAT64) AS pub_govfund_external_ctq,
    CAST(NULL AS INT64) AS pub_govfund_external_whole_ctq
  FROM UNNEST([]) AS empty
),

-- External national source: government-owned publications (Cristin only)
-- Stubbed out: same reason as gov_ext above.
gov_owned_ext AS (
  SELECT
    CAST(NULL AS STRING) AS country_code,
    CAST(NULL AS DATE) AS quarter,
    CAST(NULL AS FLOAT64) AS pub_gov_owned_external_ctq,
    CAST(NULL AS INT64) AS pub_gov_owned_external_whole_ctq
  FROM UNNEST([]) AS empty
)

SELECT
  b.country_code,
  b.quarter,

  -- 2a: Total publications (fractional)
  b.pub_total_ctq,

  -- 2b: Government-produced publications (fractional)
  b.pub_gov_owned_ctq,

  -- Private-only denominator (fractional)
  b.pub_private_total_ctq,

  -- 2c/2d/2e overlapping proxies (fractional)
  COALESCE(gd.pub_govfund_direct_ctq, 0.0) AS pub_govfund_direct_ctq,
  COALESCE(gr.pub_govfund_rid_ctq, 0.0) AS pub_govfund_rid_ctq,
  COALESCE(gi.pub_govfund_inst_ctq, 0.0) AS pub_govfund_inst_ctq,

  -- Mutually-exclusive tiers (no double counting by construction, fractional)
  COALESCE(gde.pub_govfund_direct_excl_ctq, 0.0) AS pub_govfund_direct_excl_ctq,
  COALESCE(gre.pub_govfund_rid_only_excl_ctq, 0.0) AS pub_govfund_rid_only_excl_ctq,
  COALESCE(gie.pub_govfund_inst_only_excl_ctq, 0.0) AS pub_govfund_inst_only_excl_ctq,
  (
    COALESCE(gde.pub_govfund_direct_excl_ctq, 0.0)
    + COALESCE(gre.pub_govfund_rid_only_excl_ctq, 0.0)
    + COALESCE(gie.pub_govfund_inst_only_excl_ctq, 0.0)
  ) AS pub_govfund_any_excl_ctq,

  -- Non-government domestic funder analogs (fractional)
  COALESCE(pd.pub_privfund_direct_ctq, 0.0) AS pub_privfund_direct_ctq,
  COALESCE(pr.pub_privfund_rid_ctq, 0.0) AS pub_privfund_rid_ctq,
  COALESCE(pi.pub_privfund_inst_ctq, 0.0) AS pub_privfund_inst_ctq,

  -- 2f: Citation measures (fractional)
  COALESCE(c.pub_private_with_cites_ctq, 0.0) AS pub_private_with_cites_ctq,
  COALESCE(c.pub_private_cite_gov_raw_ctq, 0.0) AS pub_private_cite_gov_raw_ctq,
  COALESCE(c.pub_private_cite_gov_norm_ctq, 0.0) AS pub_private_cite_gov_norm_ctq,

  -- External national sources (non-zero for NO, JP, NL only, fractional)
  COALESCE(ge.pub_govfund_external_ctq, 0.0) AS pub_govfund_external_ctq,
  COALESCE(goe.pub_gov_owned_external_ctq, 0.0) AS pub_gov_owned_external_ctq,

  -- -------------------------------------------------------
  -- Whole-count (unweighted) variants: each publication counted once
  -- -------------------------------------------------------
  b.pub_total_whole_ctq,
  b.pub_gov_owned_whole_ctq,
  b.pub_private_total_whole_ctq,

  -- Overlapping government funding proxies (whole count)
  COALESCE(gd.pub_govfund_direct_whole_ctq, 0) AS pub_govfund_direct_whole_ctq,
  COALESCE(gr.pub_govfund_rid_whole_ctq, 0) AS pub_govfund_rid_whole_ctq,
  COALESCE(gi.pub_govfund_inst_whole_ctq, 0) AS pub_govfund_inst_whole_ctq,

  -- Mutually-exclusive government funding tiers (whole count)
  COALESCE(gde.pub_govfund_direct_excl_whole_ctq, 0) AS pub_govfund_direct_excl_whole_ctq,
  COALESCE(gre.pub_govfund_rid_only_excl_whole_ctq, 0) AS pub_govfund_rid_only_excl_whole_ctq,
  COALESCE(gie.pub_govfund_inst_only_excl_whole_ctq, 0) AS pub_govfund_inst_only_excl_whole_ctq,
  (
    COALESCE(gde.pub_govfund_direct_excl_whole_ctq, 0)
    + COALESCE(gre.pub_govfund_rid_only_excl_whole_ctq, 0)
    + COALESCE(gie.pub_govfund_inst_only_excl_whole_ctq, 0)
  ) AS pub_govfund_any_excl_whole_ctq,

  -- Non-government domestic funder analogs (whole count)
  COALESCE(pd.pub_privfund_direct_whole_ctq, 0) AS pub_privfund_direct_whole_ctq,
  COALESCE(pr.pub_privfund_rid_whole_ctq, 0) AS pub_privfund_rid_whole_ctq,
  COALESCE(pi.pub_privfund_inst_whole_ctq, 0) AS pub_privfund_inst_whole_ctq,

  -- Citation measures (whole count and binary decomposition)
  COALESCE(c.pub_private_with_cites_whole_ctq, 0) AS pub_private_with_cites_whole_ctq,
  COALESCE(c.pub_private_citing_gov_ctq, 0.0) AS pub_private_citing_gov_ctq,
  COALESCE(c.pub_private_not_citing_gov_ctq, 0.0) AS pub_private_not_citing_gov_ctq,
  COALESCE(c.pub_private_citing_gov_whole_ctq, 0) AS pub_private_citing_gov_whole_ctq,
  COALESCE(c.pub_private_not_citing_gov_whole_ctq, 0) AS pub_private_not_citing_gov_whole_ctq,

  -- External national sources (whole count)
  COALESCE(ge.pub_govfund_external_whole_ctq, 0) AS pub_govfund_external_whole_ctq,
  COALESCE(goe.pub_gov_owned_external_whole_ctq, 0) AS pub_gov_owned_external_whole_ctq

FROM base b
LEFT JOIN gov_direct gd
  ON gd.country_code = b.country_code AND gd.quarter = b.quarter
LEFT JOIN gov_rid gr
  ON gr.country_code = b.country_code AND gr.quarter = b.quarter
LEFT JOIN gov_inst gi
  ON gi.country_code = b.country_code AND gi.quarter = b.quarter

LEFT JOIN gov_direct_excl gde
  ON gde.country_code = b.country_code AND gde.quarter = b.quarter
LEFT JOIN gov_rid_only_excl gre
  ON gre.country_code = b.country_code AND gre.quarter = b.quarter
LEFT JOIN gov_inst_only_excl gie
  ON gie.country_code = b.country_code AND gie.quarter = b.quarter

LEFT JOIN priv_direct pd
  ON pd.country_code = b.country_code AND pd.quarter = b.quarter
LEFT JOIN priv_rid pr
  ON pr.country_code = b.country_code AND pr.quarter = b.quarter
LEFT JOIN priv_inst pi
  ON pi.country_code = b.country_code AND pi.quarter = b.quarter

LEFT JOIN cite c
  ON c.country_code = b.country_code AND c.quarter = b.quarter

LEFT JOIN gov_ext ge
  ON ge.country_code = b.country_code AND ge.quarter = b.quarter
LEFT JOIN gov_owned_ext goe
  ON goe.country_code = b.country_code AND goe.quarter = b.quarter
