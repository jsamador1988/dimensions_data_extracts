config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Tier-2 RID-based matches: inventor researcher_id intersects grant investigators; FoR overlap + Jaccard thresholds (grant FoR from grants_gov_core)."
}

WITH fam AS (
  SELECT
    country_code,
    family_id,
    family_app_dt,
    family_app_qtr
  FROM ${ref("patent_family_country_features")}
  WHERE w_inv > 0
),

pat_for AS (
  SELECT
    family_id,
    pat_for4
  FROM ${ref("patent_family_for4")}
),

-- Inventor RIDs (NULL-safe)
inv_rids AS (
  SELECT DISTINCT
    p.family_id,
    inv.researcher_id AS researcher_id
  FROM `dimensions-ai.data_analytics.patents` p
  LEFT JOIN UNNEST(p.inventors) AS inv
  WHERE p.family_id IS NOT NULL
    AND inv.researcher_id IS NOT NULL
),

-- RID list from grants (no FoR assumed here)
gr_rids AS (
  SELECT
    country_code,
    grant_id,
    start_dt,
    researcher_id
  FROM ${ref("grant_rids_flat")}
  WHERE start_dt IS NOT NULL
    AND researcher_id IS NOT NULL
),

-- Grant FoR4 (this table MUST have grant_for4 as ARRAY<STRING>)
gr_core AS (
  SELECT
    country_code,
    grant_id,
    start_dt,
    grant_for4
  FROM ${ref("grants_gov_core")}
  WHERE start_dt IS NOT NULL
),

cand AS (
  SELECT DISTINCT
    f.country_code,
    f.family_id,
    f.family_app_dt,
    f.family_app_qtr AS quarter,
    rr.grant_id,
    rr.start_dt,
    pf.pat_for4,
    gc.grant_for4
  FROM fam f
  JOIN inv_rids ir
    ON ir.family_id = f.family_id
  JOIN gr_rids rr
    ON rr.country_code = f.country_code
   AND rr.researcher_id = ir.researcher_id
  JOIN gr_core gc
    ON gc.country_code = rr.country_code
   AND gc.grant_id = rr.grant_id
  JOIN pat_for pf
    ON pf.family_id = f.family_id
  WHERE f.family_app_dt >= rr.start_dt
),

scored AS (
  SELECT
    country_code,
    family_id,
    quarter,
    grant_id,

    (
      SELECT COUNT(DISTINCT x)
      FROM UNNEST(IFNULL(grant_for4, CAST([] AS ARRAY<STRING>))) AS x
      JOIN UNNEST(IFNULL(pat_for4,   CAST([] AS ARRAY<STRING>))) AS y
        ON x = y
    ) AS for4_overlap,

    SAFE_DIVIDE(
      (
        SELECT COUNT(DISTINCT x)
        FROM UNNEST(IFNULL(grant_for4, CAST([] AS ARRAY<STRING>))) AS x
        JOIN UNNEST(IFNULL(pat_for4,   CAST([] AS ARRAY<STRING>))) AS y
          ON x = y
      ),
      (
        SELECT COUNT(DISTINCT z)
        FROM (
          SELECT x AS z FROM UNNEST(IFNULL(grant_for4, CAST([] AS ARRAY<STRING>))) AS x
          UNION ALL
          SELECT y AS z FROM UNNEST(IFNULL(pat_for4,   CAST([] AS ARRAY<STRING>))) AS y
        )
      )
    ) AS jaccard_for4
  FROM cand
)

SELECT DISTINCT
  country_code,
  family_id,
  quarter,
  grant_id
FROM scored
WHERE for4_overlap >= CAST('${dataform.projectConfig.vars.min_for4_overlap}' AS INT64)
  AND jaccard_for4 >= CAST('${dataform.projectConfig.vars.min_jaccard}' AS FLOAT64)
