config {
  type: "table",
  name: "grant_measures_ctq",
  schema: "rd_int",
  tags: ["int"],
  description: "Grant quarterly counts by funder-country: any funder vs government funder."
}

WITH g AS (
  SELECT
    grant_id,
    start_dt,
    DATE_TRUNC(start_dt, QUARTER) AS quarter,
    -- make the meaning explicit so we never confuse it with panel country_code
    CASE WHEN country_code = 'UK' THEN 'GB' ELSE country_code END AS funder_country_code,
    funder_types
  FROM ${ref("grants_base")}
  WHERE start_dt IS NOT NULL
),

is_any AS (
  SELECT *
  FROM g
  WHERE funder_country_code IS NOT NULL
    AND EXISTS (
      SELECT 1
      FROM UNNEST(IFNULL(funder_types, [])) t
      WHERE t IN ('Government', 'Funder')
    )
),

is_gov AS (
  SELECT *
  FROM g
  WHERE funder_country_code IS NOT NULL
    AND 'Government' IN UNNEST(IFNULL(funder_types, []))
),

any_counts AS (
  SELECT
    funder_country_code AS country_code,
    quarter,
    COUNT(DISTINCT grant_id) AS grants_any_count_ctq
  FROM is_any
  GROUP BY 1, 2
),

gov_counts AS (
  SELECT
    funder_country_code AS country_code,
    quarter,
    COUNT(DISTINCT grant_id) AS grants_gov_count_ctq
  FROM is_gov
  GROUP BY 1, 2
)

SELECT
  c.country_code,
  q.quarter,
  COALESCE(a.grants_any_count_ctq, 0) AS grants_any_count_ctq,
  COALESCE(v.grants_gov_count_ctq, 0) AS grants_gov_count_ctq
FROM ${ref("quarter_grid")} q
CROSS JOIN ${ref("country_list")} c
LEFT JOIN any_counts a
  ON a.country_code = c.country_code AND a.quarter = q.quarter
LEFT JOIN gov_counts v
  ON v.country_code = c.country_code AND v.quarter = q.quarter
