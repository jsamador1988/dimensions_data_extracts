config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Quarterly Tier-2 patent public-funding proxies + matched-grant series."
}

WITH fam AS (
  SELECT country_code, family_id, family_app_qtr AS quarter, w_inv
  FROM ${ref("patent_family_country_features")}
  WHERE w_inv > 0
),

rid AS (
  SELECT DISTINCT country_code, family_id, quarter, grant_id
  FROM ${ref("pat_tier2_rid_matches")}
),

inst AS (
  SELECT DISTINCT country_code, family_id, quarter, grant_id
  FROM ${ref("pat_tier2_inst_matches")}
),

flags AS (
  SELECT
    f.country_code,
    f.family_id,
    f.quarter,
    MAX(CASE WHEN r.family_id IS NOT NULL THEN 1 ELSE 0 END) AS tier2_rid_flag,
    MAX(CASE WHEN i.family_id IS NOT NULL THEN 1 ELSE 0 END) AS tier2_inst_flag,
    MAX(CASE WHEN (r.family_id IS NOT NULL OR i.family_id IS NOT NULL) THEN 1 ELSE 0 END) AS tier2_any_flag
  FROM fam f
  LEFT JOIN rid r
    ON r.country_code=f.country_code AND r.family_id=f.family_id AND r.quarter=f.quarter
  LEFT JOIN inst i
    ON i.country_code=f.country_code AND i.family_id=f.family_id AND i.quarter=f.quarter
  GROUP BY f.country_code, f.family_id, f.quarter
),

-- inventor-weighted Tier2 series
tier2_weighted AS (
  SELECT
    f.country_code,
    f.quarter,
    SUM(f.w_inv * fl.tier2_rid_flag) AS pat_pubfund_tier2_rid_ctq,
    SUM(f.w_inv * fl.tier2_inst_flag) AS pat_pubfund_tier2_inst_ctq,
    SUM(f.w_inv * fl.tier2_any_flag) AS pat_pubfund_tier2_any_ctq
  FROM fam f
  JOIN flags fl
    ON fl.country_code=f.country_code AND fl.family_id=f.family_id AND fl.quarter=f.quarter
  GROUP BY f.country_code, f.quarter
),

-- distinct matched grants in patent quarter
matched_grants AS (
  SELECT
    country_code,
    quarter,
    COUNT(DISTINCT grant_id) AS matched_grants_tier2_ctq
  FROM (
    SELECT * FROM rid
    UNION DISTINCT
    SELECT * FROM inst
  )
  GROUP BY country_code, quarter
),

-- sum USD of distinct matched grants in their START quarter
matched_amount_startq AS (
  SELECT
    g.country_code,
    DATE_TRUNC(g.start_dt, QUARTER) AS quarter,
    SUM(COALESCE(g.funding_usd, 0)) AS matched_grants_amount_usd_tier2_startqtr_ctq
  FROM (
    SELECT DISTINCT country_code, grant_id
    FROM (
      SELECT country_code, grant_id FROM rid
      UNION DISTINCT
      SELECT country_code, grant_id FROM inst
    )
  ) m
  JOIN ${ref("grants_gov_core")} g
    ON g.country_code = m.country_code
   AND g.grant_id = m.grant_id
  GROUP BY g.country_code, quarter
)

SELECT
  t.country_code,
  t.quarter,
  t.pat_pubfund_tier2_rid_ctq,
  t.pat_pubfund_tier2_inst_ctq,
  t.pat_pubfund_tier2_any_ctq,
  COALESCE(m.matched_grants_tier2_ctq, 0) AS matched_grants_tier2_ctq,
  COALESCE(a.matched_grants_amount_usd_tier2_startqtr_ctq, 0) AS matched_grants_amount_usd_tier2_startqtr_ctq
FROM tier2_weighted t
LEFT JOIN matched_grants m
  USING (country_code, quarter)
LEFT JOIN matched_amount_startq a
  USING (country_code, quarter)
