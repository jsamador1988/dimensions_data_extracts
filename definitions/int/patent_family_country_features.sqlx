config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Family×country features: w_inv, w_assg, w_assg_gov, dom_filing, and family quarter."
}

WITH anchor AS (
  SELECT family_id, family_app_dt, family_app_qtr
  FROM ${ref("patent_family_anchor")}
),

invw AS (
  SELECT family_id, country_code, w_inv
  FROM ${ref("patent_family_inventor_weights")}
),

assgw AS (
  SELECT family_id, country_code, w_assg, w_assg_gov
  FROM ${ref("patent_family_assignee_weights")}
),

dom AS (
  SELECT family_id, country_code, dom_filing
  FROM ${ref("patent_family_domestic_filing")}
),

countries AS (
  SELECT DISTINCT family_id, country_code
  FROM (
    SELECT family_id, country_code FROM invw
    UNION DISTINCT
    SELECT family_id, country_code FROM assgw
  )
)

SELECT
  c.family_id,
  c.country_code,
  a.family_app_dt,
  a.family_app_qtr,

  COALESCE(i.w_inv, 0) AS w_inv,
  COALESCE(s.w_assg, 0) AS w_assg,
  COALESCE(s.w_assg_gov, 0) AS w_assg_gov,
  COALESCE(d.dom_filing, 0) AS dom_filing

FROM countries c
JOIN anchor a USING (family_id)
LEFT JOIN invw i
  ON i.family_id = c.family_id AND i.country_code = c.country_code
LEFT JOIN assgw s
  ON s.family_id = c.family_id AND s.country_code = c.country_code
LEFT JOIN dom d
  ON d.family_id = c.family_id AND d.country_code = c.country_code
