config {
  type: "table",
  schema: "rd_int",
  name: "global_quarter_totals",
  tags: ["int", "world"],
  description: "Global (world) quarterly totals for patents, publications, grants, and clinical trials. NOT filtered by country - aggregates across the entire Dimensions universe. Used as denominators for country/region share tables. Patent families exclude CN utility models/designs (via patent_doc_core). Publication quality flags use global rankings. apr16 extension: adds basic-research totals, patent top-5% forward-cite totals, worldwide grant totals (with basic + gov-funder splits), and worldwide clinical trial totals.",
  bigquery: {
    partitionBy: "quarter"
  }
}

-- ===================================================================
-- PATENTS: count distinct families per quarter (global)
-- patent_family_anchor has one row per family_id, already excludes
-- CN utility models via its dependency on patent_doc_core.
-- ===================================================================
WITH pat_anchor AS (
  SELECT family_id, family_app_qtr AS quarter
  FROM ${ref("rd_stage", "patent_family_anchor")}
),

pat_for2 AS (
  SELECT
    family_id,
    ARRAY(
      SELECT DISTINCT SUBSTR(code, 1, 2)
      FROM UNNEST(COALESCE(for4_codes, CAST([] AS ARRAY<STRING>))) AS code
      WHERE code IS NOT NULL
    ) AS for2_codes
  FROM ${ref("rd_stage", "patent_family_for4")}
),

pat_basic_flag AS (
  SELECT
    f.family_id,
    COALESCE(
      SAFE_DIVIDE(
        COUNTIF(code IS NOT NULL AND bm.is_basic_science),
        NULLIF(COUNTIF(code IS NOT NULL), 0)
      ) > 0.5,
      FALSE
    ) AS is_basic_pat
  FROM pat_for2 f
  LEFT JOIN UNNEST(f.for2_codes) AS code
  LEFT JOIN ${ref("rd_ref", "for2_basic_research_map")} bm
    ON bm.for2_code = code
  GROUP BY f.family_id
),

pat_top5c AS (
  SELECT family_id, is_top5c
  FROM ${ref("rd_int", "pat_family_citation_quantile_flags")}
),

pat_global AS (
  SELECT
    a.quarter,
    COUNT(DISTINCT a.family_id)                 AS pat_world_families,
    COUNTIF(COALESCE(pb.is_basic_pat, FALSE))   AS pat_world_basic,
    COUNTIF(COALESCE(pt.is_top5c, FALSE))       AS pat_world_top5c
  FROM pat_anchor a
  LEFT JOIN pat_basic_flag pb ON pb.family_id = a.family_id
  LEFT JOIN pat_top5c pt       ON pt.family_id = a.family_id
  GROUP BY a.quarter
),

-- ===================================================================
-- PUBLICATIONS: count distinct pub_ids per quarter (global)
-- pub_core is date-filtered (sample_start to sample_end) and
-- restricted to RESEARCH_ARTICLE + is_citable. One row per pub_id.
-- ===================================================================
pub_base AS (
  SELECT pub_id, quarter
  FROM ${ref("rd_stage", "pub_core")}
),

journal_map AS (
  SELECT pub_id, journal_id, for2_codes
  FROM ${ref("rd_stage", "pub_quality_features")}
),

journal_rank AS (
  SELECT journal_id, is_top5_journal
  FROM ${ref("rd_ref", "top_journal_ranking")}
),

breakthrough AS (
  SELECT pub_id, is_breakthrough
  FROM ${ref("rd_int", "pub_breakthrough_flags")}
),

pub_basic_flag AS (
  SELECT
    jm.pub_id,
    COALESCE(
      SAFE_DIVIDE(
        COUNTIF(code IS NOT NULL AND bm.is_basic_science),
        NULLIF(COUNTIF(code IS NOT NULL), 0)
      ) > 0.5,
      FALSE
    ) AS is_basic_pub
  FROM (
    SELECT pub_id, COALESCE(ANY_VALUE(for2_codes), CAST([] AS ARRAY<STRING>)) AS for2_codes
    FROM journal_map
    GROUP BY pub_id
  ) jm
  LEFT JOIN UNNEST(jm.for2_codes) AS code
  LEFT JOIN ${ref("rd_ref", "for2_basic_research_map")} bm
    ON bm.for2_code = code
  GROUP BY jm.pub_id
),

pub_enriched AS (
  SELECT
    pb.quarter,
    IFNULL(jr.is_top5_journal, FALSE) AS is_top5j,
    IFNULL(bt.is_breakthrough, FALSE) AS is_breakthrough,
    IFNULL(bs.is_basic_pub, FALSE)    AS is_basic_pub
  FROM pub_base pb
  LEFT JOIN journal_map jm ON jm.pub_id = pb.pub_id
  LEFT JOIN journal_rank jr ON jr.journal_id = jm.journal_id
  LEFT JOIN breakthrough bt ON bt.pub_id = pb.pub_id
  LEFT JOIN pub_basic_flag bs ON bs.pub_id = pb.pub_id
),

pub_global AS (
  SELECT
    quarter,
    COUNT(*) AS pub_world_total,
    COUNTIF(is_top5j)        AS pub_world_top5j,
    COUNTIF(is_breakthrough) AS pub_world_top01,
    COUNTIF(is_basic_pub)    AS pub_world_basic
  FROM pub_enriched
  GROUP BY quarter
),

-- ===================================================================
-- GRANTS: worldwide quarterly totals. Reads from source table so the
-- denominator is truly global, not just the analysis-country universe.
-- ===================================================================
grants_raw AS (
  SELECT
    id                              AS grant_id,
    COALESCE(
      SAFE.PARSE_DATE('%Y-%m-%d', start_date),
      SAFE.PARSE_DATE('%Y-%m', start_date),
      IF(start_year IS NOT NULL, DATE(CAST(start_year AS INT64), 1, 1), NULL)
    )                               AS start_dt,
    funder_org,
    -- FoR 4-digit codes live at category_for.second_level.codes (ARRAY<STRING>)
    (SELECT ARRAY_AGG(DISTINCT f4) FROM UNNEST(category_for.second_level.codes) AS f4) AS for4_codes
  FROM `dimensions-ai.data_analytics.grants`
),

grants_dated AS (
  SELECT
    grant_id,
    DATE_TRUNC(start_dt, QUARTER) AS quarter,
    funder_org,
    ARRAY(
      SELECT DISTINCT SUBSTR(code, 1, 2)
      FROM UNNEST(COALESCE(for4_codes, CAST([] AS ARRAY<STRING>))) AS code
      WHERE code IS NOT NULL
    ) AS for2_codes
  FROM grants_raw
  WHERE start_dt IS NOT NULL
),

funder_gov AS (
  SELECT org_id, is_gov_surico
  FROM ${ref("rd_ref", "org_gov_surico")}
),

grants_flagged AS (
  SELECT
    gd.grant_id,
    gd.quarter,
    COALESCE(fg.is_gov_surico, FALSE) AS is_gov_funder,
    (SELECT
       SAFE_DIVIDE(
         COUNTIF(for2 IN UNNEST((SELECT ARRAY_AGG(for2_code) FROM ${ref("rd_ref", "for2_basic_research_map")} WHERE is_basic_science = TRUE))),
         COUNT(*)
       ) >= 0.5
     FROM UNNEST(gd.for2_codes) AS for2
    ) AS is_basic
  FROM grants_dated gd
  LEFT JOIN funder_gov fg ON fg.org_id = gd.funder_org
),

grants_global AS (
  SELECT
    quarter,
    COUNT(*)                   AS grant_world_total,
    COUNTIF(is_basic)          AS grant_world_basic,
    COUNTIF(is_gov_funder)     AS grant_world_gov_funder,
    COUNTIF(NOT is_gov_funder) AS grant_world_nongov_funder
  FROM grants_flagged
  GROUP BY quarter
),

-- ===================================================================
-- CLINICAL TRIALS: worldwide quarterly totals. Uses clinical_trial_core
-- extraction for gov-sponsor classification.
-- ===================================================================
trials_global AS (
  SELECT
    trial_qtr AS quarter,
    COUNT(*)                                     AS trial_world_total,
    COUNTIF(is_gov_sponsor)                      AS trial_world_gov,
    -- basic research for trials is not yet implemented; emit zero
    CAST(0 AS INT64)                             AS trial_world_basic
  FROM ${ref("rd_stage", "clinical_trial_core")}
  GROUP BY trial_qtr
)

-- ===================================================================
-- Final join: one row per quarter across all four domains.
-- ===================================================================
SELECT
  COALESCE(pat.quarter, pub.quarter, gr.quarter, tr.quarter) AS quarter,
  IFNULL(pat.pat_world_families, 0)        AS pat_world_families,
  IFNULL(pat.pat_world_basic, 0)           AS pat_world_basic,
  IFNULL(pat.pat_world_top5c, 0)           AS pat_world_top5c,
  IFNULL(pub.pub_world_total, 0)           AS pub_world_total,
  IFNULL(pub.pub_world_basic, 0)           AS pub_world_basic,
  IFNULL(pub.pub_world_top5j, 0)           AS pub_world_top5j,
  IFNULL(pub.pub_world_top01, 0)           AS pub_world_top01,
  IFNULL(gr.grant_world_total, 0)          AS grant_world_total,
  IFNULL(gr.grant_world_basic, 0)          AS grant_world_basic,
  IFNULL(gr.grant_world_gov_funder, 0)     AS grant_world_gov_funder,
  IFNULL(gr.grant_world_nongov_funder, 0)  AS grant_world_nongov_funder,
  IFNULL(tr.trial_world_total, 0)          AS trial_world_total,
  IFNULL(tr.trial_world_gov, 0)            AS trial_world_gov,
  IFNULL(tr.trial_world_basic, 0)          AS trial_world_basic
FROM pat_global pat
FULL OUTER JOIN pub_global pub    ON pub.quarter = pat.quarter
FULL OUTER JOIN grants_global gr  ON gr.quarter  = COALESCE(pat.quarter, pub.quarter)
FULL OUTER JOIN trials_global tr  ON tr.quarter  = COALESCE(pat.quarter, pub.quarter, gr.quarter)
ORDER BY quarter
