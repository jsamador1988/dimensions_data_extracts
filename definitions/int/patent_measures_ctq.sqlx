config {
  type: "table",
  schema: "rd_int",
  tags: ["int"],
  description: "Patent quarterly measures by country (core + public-owned + domestic filing variants). Uses family-level anchor date and fractional inventor/assignee weights."
}

-- Produces one row per (country_code, quarter)
-- Measures:
--  pat_inv_total_ctq
--  pat_inv_assg_total_ctq
--  pat_inv_assg_file_total_ctq
--  pat_public_owned_ctq

WITH fam AS (
  -- This table should exist in your pipeline; it must contain:
  -- family_id, country_code, family_app_dt, w_inv, w_assg, w_assg_gov
  SELECT
    country_code,
    family_id,
    family_app_dt,
    w_inv,
    w_assg,
    w_assg_gov
  FROM ${ref("patent_family_country_features")}
  WHERE w_inv > 0
),

filing AS (
  -- Must contain: family_id, country_code, dom_filing (0/1)
  SELECT
    family_id,
    country_code,
    dom_filing
  FROM ${ref("patent_family_domestic_filing")}
),

scored AS (
  SELECT
    f.country_code,
    DATE_TRUNC(f.family_app_dt, QUARTER) AS quarter,

    -- Core
    f.w_inv AS w_inv,
    (f.w_inv * COALESCE(f.w_assg, 0)) AS w_inv_assg,

    -- Core + filing
    (f.w_inv * COALESCE(f.w_assg, 0) * COALESCE(d.dom_filing, 0)) AS w_inv_assg_file,

    -- Public ownership (strict gov assignee share)
    (f.w_inv * COALESCE(f.w_assg_gov, 0)) AS w_inv_assg_gov

  FROM fam f
  LEFT JOIN filing d
    ON d.family_id = f.family_id
   AND d.country_code = f.country_code
  WHERE f.family_app_dt IS NOT NULL
)

SELECT
  c.country_code,
  q.quarter,

  COALESCE(SUM(s.w_inv), 0)           AS pat_inv_total_ctq,
  COALESCE(SUM(s.w_inv_assg), 0)      AS pat_inv_assg_total_ctq,
  COALESCE(SUM(s.w_inv_assg_file), 0) AS pat_inv_assg_file_total_ctq,
  COALESCE(SUM(s.w_inv_assg_gov), 0)  AS pat_public_owned_ctq

FROM ${ref("country_list")} c
JOIN ${ref("quarter_grid")} q ON TRUE
LEFT JOIN scored s
  ON s.country_code = c.country_code
 AND s.quarter = q.quarter
GROUP BY c.country_code, q.quarter
