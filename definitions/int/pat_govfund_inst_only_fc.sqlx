config {
  type: "table",
  schema: "rd_int",
  name: "pat_govfund_inst_only_fc",
  tags: ["int", "patents", "exclusive"],
  description: "Mutually-exclusive Tier-3 government-funded private patent families: institution-linked matches excluding any family-country already captured by Tier-1 direct or Tier-2 RID linkage."
}

WITH inst AS (
  SELECT DISTINCT
    family_id,
    country_code,
    quarter,
    w_domestic
  FROM ${ref("rd_int", "pat_govfund_inst_fc")}
),
direct AS (
  SELECT DISTINCT
    family_id,
    country_code
  FROM ${ref("rd_int", "pat_govfund_direct_fc")}
),
rid AS (
  SELECT DISTINCT
    family_id,
    country_code
  FROM ${ref("rd_int", "pat_govfund_rid_fc")}
)

SELECT
  i.family_id,
  i.country_code,
  i.quarter,
  i.w_domestic
FROM inst i
LEFT JOIN direct d
  ON d.family_id = i.family_id
 AND d.country_code = i.country_code
LEFT JOIN rid r
  ON r.family_id = i.family_id
 AND r.country_code = i.country_code
WHERE d.family_id IS NULL
  AND r.family_id IS NULL

