config {
  type: "table",
  schema: "rd_stage",
  name: "analysis_country_universe",
  description: "OECD-only analysis country universe: US, CA, AU, CH, GB + EU members that are OECD.",
  tags: ["analysis", "phase1"]
}

SELECT country_code
FROM UNNEST([
  -- Non-EU OECD
  'US','CA','AU','CH','GB',

  -- EU members that are OECD
  'AT','BE','CZ','DK','EE','FI','FR','DE','GR','HU','IE','IT','LV','LT','LU','NL',
  'PL','PT','SK','SI','ES','SE'
]) AS country_code
