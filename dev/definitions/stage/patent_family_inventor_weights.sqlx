config {
  type: "table",
  schema: "rd_stage",
  name: "patent_family_inventor_weights",
  tags: ["stage", "patents"],
  description: "Family×inventor-country inventor fractional weights (deduplicated by researcher_id if present, else by inventor name)."
}

WITH inv_flat AS (
  SELECT DISTINCT
    p.family_id,
    inv.address.country AS country_code,
    COALESCE(inv.researcher_id, inv.name) AS inventor_key
  FROM ${ref("rd_stage", "patent_doc_core")} p
  CROSS JOIN UNNEST(p.inventors) AS inv
  WHERE p.family_id IS NOT NULL
    AND inv.address.country IS NOT NULL
    AND REGEXP_CONTAINS(inv.address.country, r'^[A-Z]{2}$')
    AND inv.address.country NOT IN ('EP', 'WO')
    AND COALESCE(inv.researcher_id, inv.name) IS NOT NULL
),

counts AS (
  SELECT
    family_id,
    country_code,
    COUNT(DISTINCT inventor_key) AS n_inv_country
  FROM inv_flat
  GROUP BY family_id, country_code
),

totals AS (
  SELECT
    family_id,
    SUM(n_inv_country) AS n_inv_total
  FROM counts
  GROUP BY family_id
)

SELECT
  c.family_id,
  c.country_code,
  SAFE_DIVIDE(c.n_inv_country, t.n_inv_total) AS w_inv,
  c.n_inv_country,
  t.n_inv_total
FROM counts c
JOIN totals t
  USING (family_id)
WHERE t.n_inv_total > 0
