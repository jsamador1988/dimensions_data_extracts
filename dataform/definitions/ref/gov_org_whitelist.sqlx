config {
  type: "table",
  schema: "rd_ref",
  name: "gov_org_whitelist",
  description: "Government organization whitelist for Surico classification. 392 entries across 35 countries. Original 365 entries verified 2026-03-20; 27 added 2026-04-02 from whitelist expansion review. Includes start_date/end_date for temporal bounds on government status.",
  tags: ['ref']
}

-- === AT: Austria ===
